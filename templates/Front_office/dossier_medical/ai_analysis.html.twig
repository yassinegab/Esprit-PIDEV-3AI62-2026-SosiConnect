{% extends 'base.html.twig' %}

{% block title %}Analyse IA - Dossier Médical - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-7xl space-y-8 p-4 lg:p-8">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-10 h-10 text-lg bg-primary/10 text-primary"><i class="fas fa-brain"></i></span>
                        Analyse IA du Dossier Médical
                    </h1>
                    <p class="page-subtitle mt-1">Intelligence artificielle avancée au service de votre santé</p>
                </div>
                <a href="{{ path('dossier_medical_show', {'id': dossier_medical.id}) }}" class="btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i> Retour au dossier
                </a>
            </div>

            {# ── Main Health Score Card ── #}
            <div class="card p-0 overflow-hidden border-none shadow-2xl shadow-primary/20 bg-gradient-to-br from-primary to-primary-dark text-white">
                <div class="p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 relative overflow-hidden">
                    {# Abstract decoration #}
                    <div class="absolute -top-24 -right-24 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
                    <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-black/10 rounded-full blur-3xl"></div>
                    
                    <div class="relative z-10 text-center md:text-left">
                        <p class="text-white/70 font-black uppercase tracking-widest text-[10px] mb-2">Score Global de Santé</p>
                        <div class="flex items-baseline justify-center md:justify-start gap-1">
                            <span class="text-8xl font-black tracking-tighter">{{ analysis.score_sante }}</span>
                            <span class="text-2xl font-bold opacity-60">/100</span>
                        </div>
                        {% if analysis.urgence %}
                            <div class="mt-6 inline-flex items-center gap-3 px-6 py-3 bg-white text-primary rounded-2xl font-black text-xs uppercase tracking-wider shadow-xl animate-pulse">
                                <i class="fas fa-exclamation-triangle"></i> Consultation urgente recommandée
                            </div>
                        {% endif %}
                    </div>

                    <div class="relative z-10 text-center md:text-right flex flex-col items-center md:items-end gap-4">
                        <div class="px-8 py-4 bg-white/10 backdrop-blur-md rounded-3xl border border-white/20 shadow-inner">
                            <p class="text-[10px] font-black uppercase tracking-widest text-white/70 mb-1">Niveau de Gravité</p>
                            <div class="flex items-center gap-3 text-2xl font-black">
                                {% if analysis.gravite == 'faible' %}
                                    <i class="fas fa-check-circle text-green-400"></i> <span class="uppercase tracking-tighter">FAIBLE</span>
                                {% elseif analysis.gravite == 'modere' %}
                                    <i class="fas fa-exclamation-triangle text-amber-400"></i> <span class="uppercase tracking-tighter">MODÉRÉE</span>
                                {% else %}
                                    <i class="fas fa-biohazard text-red-400"></i> <span class="uppercase tracking-tighter">ÉLEVÉE</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Insights Grid ── #}
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                {# Charts Section #}
                <div class="card p-6">
                    <h2 class="section-title mb-8 flex items-center gap-2">
                        <i class="fas fa-chart-pie text-primary"></i> Répartition par Systèmes
                    </h2>
                    <div class="relative h-[350px]">
                        <canvas id="systemScoresChart"></canvas>
                    </div>
                </div>

                <div class="card p-6">
                    <h2 class="section-title mb-8 flex items-center gap-2">
                        <i class="fas fa-project-diagram text-primary"></i> Équilibre Vital
                    </h2>
                    <div class="relative h-[350px]">
                        <canvas id="radarChart"></canvas>
                    </div>
                </div>
            </div>

            {# ── Clinical Summary ── #}
            <div class="card p-8 bg-muted/20 border-dashed">
                <h2 class="section-title mb-6 flex items-center gap-2">
                    <i class="fas fa-microscope text-primary"></i> Résumé Clinique IA
                </h2>
                <div class="prose max-w-none">
                    <p class="text-foreground text-lg leading-relaxed font-medium italic opacity-80">"{{ analysis.resume_cas }}"</p>
                </div>
            </div>

            {# ── Risks & Complications ── #}
            {% if analysis.facteurs_risque is defined or analysis.complications_potentielles is defined %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {% if analysis.facteurs_risque is defined %}
                <div class="card border-l-4 border-l-primary/40 p-6">
                    <h2 class="section-title mb-4 flex items-center gap-2 text-primary">
                        <i class="fas fa-radiation"></i> Facteurs de Risque
                    </h2>
                    <ul class="space-y-3">
                        {% for risque in analysis.facteurs_risque %}
                            <li class="flex items-start gap-3 p-3 bg-primary/5 rounded-xl border border-primary/10">
                                <i class="fas fa-circle-notch text-primary text-[10px] mt-1.5 animate-spin-slow"></i>
                                <span class="text-sm font-bold text-foreground opacity-80">{{ risque }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}

                {% if analysis.complications_potentielles is defined %}
                <div class="card border-l-4 border-l-amber-500/40 p-6">
                    <h2 class="section-title mb-4 flex items-center gap-2 text-amber-600">
                        <i class="fas fa-shield-virus"></i> Complications Potentielles
                    </h2>
                    <ul class="space-y-3">
                        {% for complication in analysis.complications_potentielles %}
                            <li class="flex items-start gap-3 p-3 bg-amber-50 rounded-xl border border-amber-200">
                                <i class="fas fa-exclamation-circle text-amber-500 text-[10px] mt-1.5"></i>
                                <span class="text-sm font-bold text-foreground opacity-80">{{ complication }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
            {% endif %}

            {# ── Follow-up Plan ── #}
            {% if analysis.plan_suivi is defined %}
            <div class="card p-8">
                <h2 class="section-title mb-8 flex items-center gap-2">
                    <i class="fas fa-calendar-check text-primary"></i> Plan de Suivi Personnalisé
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    {% for key, plan in analysis.plan_suivi %}
                        <div class="p-6 rounded-2xl border border-border bg-muted/20 relative group hover:bg-muted/40 transition-colors">
                            <span class="absolute -top-3 left-6 px-3 py-1 bg-foreground text-background text-[10px] font-black uppercase tracking-widest rounded-lg">
                                {{ key|replace({'_': ' '}) }}
                            </span>
                            <p class="text-sm font-bold text-foreground/80 mt-2">{{ plan }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# ── Recommended Providers ── #}
            <div class="space-y-8">
                {# Local Doctors #}
                {% if analysis.medecins_locaux is defined and analysis.medecins_locaux|length > 0 %}
                <div class="card p-0 overflow-hidden border-primary/20">
                    <div class="p-6 border-b border-border bg-primary/5 flex items-center justify-between">
                        <h2 class="section-title flex items-center gap-2 text-primary">
                            <i class="fas fa-user-md"></i> Médecins Locaux Recommandés
                        </h2>
                        <span class="badge-primary">{{ analysis.medecins_locaux|length }} disponible(s)</span>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for medecin in analysis.medecins_locaux %}
                            <div class="card p-6 border-border card-hover flex flex-col h-full bg-white">
                                <div class="flex items-center gap-4 mb-6">
                                    <div class="stat-icon w-14 h-14 bg-primary/10 text-primary rounded-2xl text-xl shrink-0">
                                        <i class="fas fa-user-md"></i>
                                    </div>
                                    <div>
                                        <p class="font-black text-foreground leading-tight tracking-tight">Dr. {{ medecin.prenom }} {{ medecin.nom }}</p>
                                        <p class="section-title text-primary text-[10px]">{{ medecin.specialite }}</p>
                                    </div>
                                </div>
                                <div class="space-y-3 mb-6 flex-1">
                                    <p class="text-xs text-muted-foreground flex items-center gap-2"><i class="fas fa-envelope opacity-50"></i> {{ medecin.email }}</p>
                                    <p class="text-xs text-muted-foreground flex items-center gap-2"><i class="fas fa-phone opacity-50"></i> {{ medecin.telephone }}</p>
                                </div>
                                <button class="btn-primary w-full text-[10px] py-2 uppercase tracking-widest">Prendre Rendez-vous</button>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# International Experts #}
                {% if analysis.medecins_internationaux is defined and analysis.medecins_internationaux|length > 0 %}
                <div class="card p-0 overflow-hidden border-border bg-muted/5">
                    <div class="p-6 border-b border-border bg-muted/20 flex items-center justify-between">
                        <h2 class="section-title flex items-center gap-2">
                            <i class="fas fa-globe-americas text-primary"></i> Experts Internationaux
                        </h2>
                        <span class="badge-muted">Top Spécialistes</span>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
                        {% for medecin in analysis.medecins_internationaux %}
                            <div class="card p-6 border-border hover:border-primary/30 transition-all bg-white group">
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-border group-hover:border-primary/50 transition-colors bg-muted flex items-center justify-center text-muted-foreground">
                                        <i class="fas fa-user-tie"></i>
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-black text-foreground text-sm">{{ medecin.nom }}</p>
                                        <p class="text-[10px] font-bold text-primary uppercase">{{ medecin.specialite }}</p>
                                    </div>
                                </div>
                                <p class="text-xs text-muted-foreground leading-relaxed italic mb-4">"{{ medecin.expertise }}"</p>
                                <div class="flex items-center gap-2 mb-4">
                                    <span class="badge-muted text-[10px] py-0.5 px-2 bg-muted/50 border-none"><i class="fas fa-hospital mr-1"></i> {{ medecin.institution }}</span>
                                    <span class="badge-primary text-[10px] py-0.5 px-2"><i class="fas fa-map-marker-alt mr-1"></i> {{ medecin.pays }}</span>
                                </div>
                                <button class="w-full py-2 rounded-xl border border-border text-[9px] font-black uppercase tracking-widest text-muted-foreground hover:bg-foreground hover:text-background transition-all">Consulter l'expert</button>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>

            {# ── Recommendations & Lab Tests ── #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="card p-8 border-none bg-[#fdfdfd] shadow-xl">
                    <h2 class="section-title mb-8 flex items-center gap-3">
                        <span class="stat-icon w-8 h-8 text-sm"><i class="fas fa-lightbulb"></i></span>
                        Conseils Préventifs
                    </h2>
                    <ul class="space-y-4">
                        {% for reco in analysis.recommandations %}
                            <li class="flex items-start gap-4 group">
                                <span class="stat-icon w-6 h-6 bg-green-50 text-green-500 text-[10px] shrink-0"><i class="fas fa-check"></i></span>
                                <span class="text-sm font-bold text-foreground/70 group-hover:text-foreground transition-colors leading-relaxed">{{ reco }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <div class="card p-8 border-none bg-[#fdfdfd] shadow-xl">
                    <h2 class="section-title mb-8 flex items-center gap-3">
                        <span class="stat-icon w-8 h-8 text-sm bg-indigo-50 text-indigo-500"><i class="fas fa-flask"></i></span>
                        Examens suggérés
                    </h2>
                    <ul class="space-y-4">
                        {% for examen in analysis.examens_suggeres %}
                            <li class="flex items-start gap-4 group">
                                <span class="stat-icon w-6 h-6 bg-indigo-50 text-indigo-500 text-[10px] shrink-0"><i class="fas fa-vial"></i></span>
                                <span class="text-sm font-bold text-foreground/70 group-hover:text-foreground transition-colors leading-relaxed">{{ examen }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

        </div>
    </main>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const scoresSystemes = {{ analysis.statistiques.scores_systemes|default({})|json_encode|raw }};
    
    // Config Chart.js
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#71717a';

    const ctx1 = document.getElementById('systemScoresChart');
    if (ctx1 && Object.keys(scoresSystemes).length > 0) {
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: Object.keys(scoresSystemes).map(k => k.charAt(0).toUpperCase() + k.slice(1)),
                datasets: [{
                    data: Object.values(scoresSystemes),
                    backgroundColor: '#ef4444',
                    borderRadius: 8,
                    barThickness: 32
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, max: 100, grid: { borderDash: [5, 5] } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    const ctx2 = document.getElementById('radarChart');
    if (ctx2 && Object.keys(scoresSystemes).length > 0) {
        new Chart(ctx2, {
            type: 'radar',
            data: {
                labels: Object.keys(scoresSystemes).map(k => k.charAt(0).toUpperCase() + k.slice(1)),
                datasets: [{
                    label: 'Scores',
                    data: Object.values(scoresSystemes),
                    backgroundColor: 'rgba(239, 68, 68, 0.2)',
                    borderColor: '#ef4444',
                    borderWidth: 2,
                    pointBackgroundColor: '#ef4444',
                    pointBorderColor: '#fff',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    r: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { display: false }
                    }
                }
            }
        });
    }
});
</script>
{% endblock %}