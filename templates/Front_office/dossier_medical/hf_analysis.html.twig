{% extends 'base.html.twig' %}

{% block title %}Analyse Hugging Face — Dossier #{{ dossier_medical.id }} - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-5xl space-y-8 p-4 lg:p-8">

            {# ── Header Card ── #}
            <div class="card p-0 overflow-hidden border-primary/20">
                <div class="h-1.5 w-full bg-gradient-to-r from-primary via-primary-dark to-foreground/80"></div>
                <div class="p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                    <div>
                        <div class="flex flex-wrap gap-2 mb-4">
                            <span class="badge-muted bg-primary/5 text-primary border-primary/10">🤗 API EXTERNE</span>
                            <span class="badge-muted">IA CLASSIFICATION</span>
                            {% if api_key_valide %}
                                <span class="badge-success"><i class="fas fa-check-circle mr-1"></i> API ACTIVE</span>
                            {% else %}
                                <span class="badge-danger"><i class="fas fa-times-circle mr-1"></i> CLÉ MANQUANTE</span>
                            {% endif %}
                        </div>
                        <h1 class="page-title flex items-center gap-3">
                            <span class="stat-icon w-10 h-10 text-lg bg-primary/10 text-primary"><i class="fas fa-microchip"></i></span>
                            Analyse Hugging Face
                        </h1>
                        <p class="page-subtitle mt-2">
                            Modèle : <span class="font-black text-foreground">{{ model_name|default('distilbert-base-uncased') }}</span>
                            &nbsp;•&nbsp; Dossier <span class="text-primary font-black">#{{ dossier_medical.id }}</span>
                        </p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <a href="{{ path('dossier_medical_ai_analysis', {'id': dossier_medical.id}) }}" class="btn-primary bg-indigo-600 hover:bg-indigo-700 shadow-indigo-200">
                            <i class="fas fa-robot mr-2"></i> Groq (IA 1)
                        </a>
                        <a href="{{ path('dossier_medical_show', {'id': dossier_medical.id}) }}" class="btn-secondary">
                            <i class="fas fa-arrow-left mr-2"></i> Retour
                        </a>
                    </div>
                </div>
            </div>

            {# ── Analyzed Text ── #}
            {% if texte_analyse %}
            <div class="card p-8 bg-muted/20 border-dashed">
                <div class="flex items-center gap-3 mb-6">
                    <div class="stat-icon w-10 h-10 bg-muted text-muted-foreground text-lg">
                        <i class="fas fa-quote-left"></i>
                    </div>
                    <h2 class="section-title">Données traitées par l'IA</h2>
                </div>
                <div class="bg-white border border-border rounded-2xl p-6 shadow-inner relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1 h-full bg-primary/30"></div>
                    <p class="text-foreground/80 text-sm leading-relaxed italic font-medium">
                        "{{ texte_analyse }}"
                    </p>
                </div>
                <div class="flex flex-wrap gap-4 mt-6">
                    <span class="text-[10px] font-black text-muted-foreground uppercase tracking-widest bg-muted/50 px-3 py-1.5 rounded-lg border border-border">
                        <i class="fas fa-text-height mr-2 opacity-50"></i> {{ texte_analyse|length }} CARACTÈRES
                    </span>
                    <span class="text-[10px] font-black text-primary uppercase tracking-widest bg-primary/5 px-3 py-1.5 rounded-lg border border-primary/10">
                        <i class="fas fa-link mr-2 opacity-50"></i> {{ model_name }}
                    </span>
                </div>
            </div>
            {% endif %}

            {# ── Error Handling ── #}
            {% if hf_error %}
            <div class="card p-0 border-primary/30 overflow-hidden">
                <div class="bg-primary/5 px-8 py-4 border-b border-primary/10 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="stat-icon w-10 h-10 bg-primary/20 text-primary text-lg">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <h2 class="section-title text-primary">Diagnostic de l'erreur</h2>
                    </div>
                    {% if http_code %}
                        <span class="font-black font-mono text-primary bg-primary/10 px-3 py-1 rounded-lg">HTTP {{ http_code }}</span>
                    {% endif %}
                </div>
                <div class="p-8 space-y-6">
                    <div class="flex items-start gap-4 p-6 bg-primary/5 rounded-2xl border border-primary/20">
                        <i class="fas fa-bug text-primary text-2xl mt-1"></i>
                        <p class="text-sm font-bold text-primary tracking-tight leading-relaxed">{{ hf_error }}</p>
                    </div>

                    {% if http_code == 503 %}
                    <div class="card p-6 border-amber-200 bg-amber-50">
                        <p class="text-sm font-black text-amber-800 mb-2 flex items-center gap-2">
                            <i class="fas fa-clock animate-spin-slow"></i> MODÈLE EN COURS DE CHARGEMENT
                        </p>
                        <p class="text-xs text-amber-700/80 mb-6 leading-relaxed font-medium">Le serveur Hugging Face alloue des ressources pour ce modèle. Cela peut prendre environ 20-30 secondes.</p>
                        <button onclick="location.reload()" class="btn-primary bg-amber-600 hover:bg-amber-700 shadow-amber-200 w-full sm:w-auto">
                            <i class="fas fa-sync-alt mr-2"></i> RÉESSAYER MAINTENANT
                        </button>
                    </div>
                    {% endif %}

                    {% if not api_key_valide or http_code == 401 or http_code == 403 %}
                    <div class="card p-6 border-indigo-200 bg-indigo-50">
                        <p class="text-sm font-black text-indigo-800 mb-4 flex items-center gap-2">
                            <i class="fas fa-key"></i> CONFIGURATION REQUISE
                        </p>
                        <div class="bg-gray-900 rounded-xl p-5 font-mono text-[11px] shadow-2xl">
                            <p class="text-muted-foreground/50 mb-2"># .env.local</p>
                            <p class="text-green-400">HUGGINGFACE_API_KEY=<span class="text-white">hf_your_token_here</span></p>
                        </div>
                        <a href="https://huggingface.co/settings/tokens" target="_blank" class="btn-ghost text-indigo-600 font-black text-[10px] tracking-widest mt-6 flex items-center justify-center gap-2 border border-indigo-200 bg-white">
                            GÉNÉRER UNE CLÉ API <i class="fas fa-external-link-alt"></i>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            {# ── Classification Scores ── #}
            {% if hf_result %}
            <div class="card p-0 border-border overflow-hidden">
                <div class="px-8 py-6 border-b border-border bg-muted/20 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="stat-icon w-10 h-10 bg-muted text-muted-foreground">
                            <i class="fas fa-chart-bar"></i>
                        </div>
                        <div>
                            <h2 class="section-title">Scores de Classification</h2>
                            <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest mt-0.5">Analyse probabiliste par IA</p>
                        </div>
                    </div>
                    <span class="badge-muted">{{ hf_result|length }} catégories</span>
                </div>
                
                <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-6" id="scores-container">
                    {% set idx = 0 %}
                    {% for label, score in hf_result %}
                        {% set pct = (score * 100)|round(1) %}
                        {% set isDominant = idx == 0 %}
                        
                        <div class="card p-6 transition-all hover:scale-[1.02] duration-300 group
                            {{ isDominant ? 'border-primary/50 bg-primary/[0.03] ring-4 ring-primary/5' : 'border-border hover:border-primary/20 bg-white' }}">
                            
                            <div class="flex justify-between items-start mb-6">
                                <div class="flex items-center gap-3">
                                    <div class="stat-icon w-8 h-8 text-sm {{ isDominant ? 'bg-primary text-white shadow-lg' : 'bg-muted text-muted-foreground' }}">
                                        {{ isDominant ? '<i class="fas fa-bolt"></i>'|raw : '<i class="fas fa-tag"></i>'|raw }}
                                    </div>
                                    <span class="font-black text-foreground uppercase tracking-tight {{ isDominant ? 'text-lg' : 'text-sm' }}">{{ label }}</span>
                                </div>
                                <span class="text-2xl font-black font-mono {{ isDominant ? 'text-primary' : 'text-muted-foreground' }}">{{ pct }}%</span>
                            </div>

                            <div class="w-full bg-muted/40 rounded-full h-2.5 overflow-hidden">
                                <div class="h-2.5 rounded-full transition-all duration-1000 ease-out {{ isDominant ? 'bg-primary' : 'bg-muted-foreground/30' }}"
                                     style="width: 0%"
                                     data-target="{{ pct }}">
                                </div>
                            </div>
                            
                            <div class="mt-4 flex justify-between items-center text-[9px] font-black uppercase tracking-widest text-muted-foreground opacity-50">
                                <span>Confiance statistique</span>
                                <span>{{ pct }} / 100</span>
                            </div>
                        </div>
                        {% set idx = idx + 1 %}
                    {% endfor %}
                </div>
            </div>

            {# ── Clinical Interpretation ── #}
            {% set topLabel = hf_result|keys|first %}
            {% set topScore = hf_result|first %}
            {% set topPct = (topScore * 100)|round(1) %}

            <div class="card p-0 overflow-hidden border-none shadow-2xl">
                <div class="bg-foreground text-background p-8 md:p-12 flex flex-col md:flex-row items-center gap-12">
                    <div class="text-8xl flex-shrink-0 animate-bounce-slow">
                        {{ topPct > 35 ? '🚨' : (topPct > 18 ? '⚠️' : '✅') }}
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center gap-3 mb-2">
                            <span class="stat-icon w-6 h-6 text-[10px] bg-primary text-white border-none"><i class="fas fa-star"></i></span>
                            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground">Interprétation Prioritaire</span>
                        </div>
                        <h2 class="text-4xl font-black tracking-tighter mb-4">{{ topLabel }}</h2>
                        
                        <div class="flex items-baseline gap-2 mb-8">
                            <span class="text-5xl font-black text-primary font-mono">{{ topPct }}%</span>
                            <span class="text-sm font-bold text-muted-foreground uppercase tracking-widest">Niveau de certitude</span>
                        </div>

                        <div class="p-6 bg-white/5 rounded-2xl border border-white/10 backdrop-blur-sm">
                            <p class="text-sm font-medium leading-relaxed opacity-80">
                                {% if topPct > 35 %}
                                    Le modèle détecte une condition nécessitant une attention médicale <span class="text-primary font-black uppercase underline decoration-2 underline-offset-4">prioritaire</span>. Une consultation immédiate est fortement préconisée pour confirmer ce diagnostic probabiliste.
                                {% elseif topPct > 18 %}
                                    Le modèle suggère un suivi médical attentif. Il est conseillé de planifier une consultation spécialisée dans les prochaines semaines pour approfondir ces résultats.
                                {% else %}
                                    Le modèle indique une condition globalement stable. Poursuivez vos protocoles de santé habituels et maintenez votre suivi de routine.
                                {% endif %}
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-4 mt-10">
                            <a href="{{ path('dossier_medical_ai_analysis', {'id': dossier_medical.id}) }}" class="btn-primary bg-white text-foreground hover:bg-muted py-3 px-8 text-xs font-black">
                                <i class="fas fa-robot mr-2"></i> ANALYSE GROQ COMPLÈTE
                            </a>
                            <a href="{{ path('dossier_medical_export_pdf', {'id': dossier_medical.id}) }}" class="btn-ghost text-white border-white/20 hover:bg-white/10 py-3 px-8 text-xs font-black">
                                <i class="fas fa-file-pdf mr-2"></i> EXPORT PDF
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

        </div>
    </main>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const bars = document.querySelectorAll('[data-target]');
    setTimeout(() => {
        bars.forEach((bar, i) => {
            setTimeout(() => {
                bar.style.width = bar.dataset.target + '%';
            }, 300 + i * 150);
        });
    }, 400);
});
</script>
{% endblock %}
