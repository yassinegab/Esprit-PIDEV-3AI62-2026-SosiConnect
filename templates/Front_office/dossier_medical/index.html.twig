{% extends 'base.html.twig' %}

{% block title %}Mes Dossiers Médicaux - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-7xl space-y-8 p-4 lg:p-8">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-10 h-10 text-lg"><i class="fas fa-file-medical"></i></span>
                        Mes Dossiers Médicaux
                    </h1>
                    <p class="page-subtitle mt-1">
                        Gérez vos informations médicales et le suivi de votre santé
                    </p>
                </div>
                <div class="flex gap-3">
                    <a href="{{ path('dossier_medical_new') }}" class="btn-primary">
                        <i class="fas fa-plus mr-2"></i> Nouveau Dossier
                    </a>
                    <a href="{{ path('app_service_home') }}" class="btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i> Retour
                    </a>
                </div>
            </div>

            {# ── Messages Flash ── #}
            {% for message in app.flashes('success') %}
                <div class="animate-fade-in bg-green-50 border border-green-200 text-green-700 px-5 py-4 rounded-xl flex items-center gap-3">
                    <i class="fas fa-check-circle text-lg"></i>
                    <span class="font-medium">{{ message }}</span>
                </div>
            {% endfor %}

            {# ── Dossiers List ── #}
            <div class="card p-0 overflow-hidden">
                {% if dossiers is empty %}
                    <div class="empty-state py-20">
                        <div class="empty-state-icon text-5xl mb-6 opacity-30">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <h3 class="text-xl font-black text-foreground mb-2 tracking-tight">Aucun dossier médical</h3>
                        <p class="text-muted-foreground max-w-xs mx-auto mb-8">Créez votre premier dossier médical pour commencer à centraliser vos données de santé.</p>
                        <a href="{{ path('dossier_medical_new') }}" class="btn-primary px-8 shadow-xl shadow-primary/20">
                            <i class="fas fa-plus mr-2"></i> CRÉER MON DOSSIER
                        </a>
                    </div>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-border">
                            <thead class="bg-muted/30">
                                <tr>
                                    <th class="px-6 py-4 text-left section-title">ID</th>
                                    <th class="px-6 py-4 text-left section-title">Date de création</th>
                                    <th class="px-6 py-4 text-left section-title">Dernière MAJ</th>
                                    <th class="px-6 py-4 text-left section-title">Objectif</th>
                                    <th class="px-6 py-4 text-right section-title">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border bg-white">
                                {% for dossier in dossiers %}
                                    <tr class="hover:bg-muted/20 transition-colors">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-black text-foreground">
                                            #{{ dossier.id }}
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground font-medium">
                                            <i class="fas fa-calendar-alt opacity-50 mr-2"></i> {{ dossier.dateCreation|date('d/m/Y H:i') }}
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-muted-foreground font-medium">
                                            <i class="fas fa-clock opacity-50 mr-2"></i> {{ dossier.derniereMiseAJour|date('d/m/Y H:i') }}
                                        </td>
                                        <td class="px-6 py-4 text-sm text-foreground font-semibold">
                                            {{ dossier.objectifSante ?? 'Non défini' }}
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <div class="flex justify-end gap-2">
                                                <a href="{{ path('dossier_medical_show', {'id': dossier.id}) }}"
                                                   class="btn-ghost p-2 hover:text-blue-600" title="Voir">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="{{ path('dossier_medical_edit', {'id': dossier.id}) }}"
                                                   class="btn-ghost p-2 hover:text-primary" title="Modifier">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button onclick="confirmDelete({{ dossier.id }})"
                                                        class="btn-danger p-2" title="Supprimer">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                                <form id="delete-form-{{ dossier.id }}"
                                                      method="post"
                                                      action="{{ path('dossier_medical_delete', {'id': dossier.id}) }}"
                                                      style="display: none;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dossier.id) }}">
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

        </div>
    </main>
</div>

<script>
function confirmDelete(id) {
    if (confirm('Voulez-vous vraiment supprimer ce dossier médical ?')) {
        document.getElementById('delete-form-' + id).submit();
    }
}
</script>
{% endblock %}