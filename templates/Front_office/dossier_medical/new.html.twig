{% extends 'base.html.twig' %}

{% block title %}Nouveau Dossier Médical - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-4xl space-y-8 p-4 lg:p-8">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-10 h-10 text-lg"><i class="fas fa-file-medical"></i></span>
                        Nouveau Dossier Médical
                    </h1>
                    <p class="page-subtitle mt-1">Remplissez vos informations médicales pour un meilleur suivi</p>
                </div>
                <a href="{{ path('dossier_medical_index') }}" class="btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i> Retour
                </a>
            </div>

            {# ── Form Card ── #}
            <div class="card p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-8', 'novalidate': 'novalidate'}}) }}
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    
                    {# Section 1: Antécédents #}
                    <div class="space-y-6">
                        <div>
                            <label class="form-label flex items-center gap-2">
                                <i class="fas fa-history text-primary"></i>
                                {{ form_label(form.antecedentsMedicaux) }}
                            </label>
                            {{ form_widget(form.antecedentsMedicaux, {'attr': {'class': 'input-field h-32 py-3 resize-none', 'placeholder': 'Vos antécédents médicaux...'}}) }}
                            <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.antecedentsMedicaux) }}</div>
                        </div>

                        <div>
                            <label class="form-label flex items-center gap-2">
                                <i class="fas fa-heartbeat text-primary"></i>
                                {{ form_label(form.maladiesChroniques) }}
                            </label>
                            {{ form_widget(form.maladiesChroniques, {'attr': {'class': 'input-field h-32 py-3 resize-none', 'placeholder': 'Maladies chroniques...'}}) }}
                            <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.maladiesChroniques) }}</div>
                        </div>

                        <div>
                            <label class="form-label flex items-center gap-2">
                                <i class="fas fa-allergies text-primary"></i>
                                {{ form_label(form.allergies) }}
                            </label>
                            {{ form_widget(form.allergies, {'attr': {'class': 'input-field h-32 py-3 resize-none', 'placeholder': 'Allergies connues...'}}) }}
                            <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.allergies) }}</div>
                        </div>
                    </div>

                    {# Section 2: Traitements & Notes #}
                    <div class="space-y-6">
                        <div>
                            <label class="form-label flex items-center gap-2">
                                <i class="fas fa-pills text-primary"></i>
                                {{ form_label(form.traitementsEnCours) }}
                            </label>
                            {{ form_widget(form.traitementsEnCours, {'attr': {'class': 'input-field h-32 py-3 resize-none', 'placeholder': 'Médicaments et traitements...'}}) }}
                            <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.traitementsEnCours) }}</div>
                        </div>

                        <div>
                            <label class="form-label flex items-center gap-2">
                                <i class="fas fa-stethoscope text-primary"></i>
                                {{ form_label(form.diagnostics) }}
                            </label>
                            {{ form_widget(form.diagnostics, {'attr': {'class': 'input-field h-32 py-3 resize-none', 'placeholder': 'Diagnostics récents...'}}) }}
                            <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.diagnostics) }}</div>
                        </div>

                        <div>
                            <label class="form-label flex items-center gap-2">
                                <i class="fas fa-notes-medical text-primary"></i>
                                {{ form_label(form.notesMedecin) }}
                            </label>
                            {{ form_widget(form.notesMedecin, {'attr': {'class': 'input-field h-32 py-3 resize-none', 'placeholder': 'Notes et observations médicales...'}}) }}
                            <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.notesMedecin) }}</div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6 border-t border-border">
                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-bullseye text-primary"></i>
                            {{ form_label(form.objectifSante) }}
                        </label>
                        {{ form_widget(form.objectifSante, {'attr': {'class': 'input-field', 'placeholder': 'Ex: Perte de poids, Suivi glycémie...'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.objectifSante) }}</div>
                    </div>

                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-running text-primary"></i>
                            {{ form_label(form.niveauActivite) }}
                        </label>
                        {{ form_widget(form.niveauActivite, {'attr': {'class': 'input-field appearance-none cursor-pointer'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.niveauActivite) }}</div>
                    </div>
                </div>

                {# ── Actions ── #}
                <div class="flex flex-col sm:flex-row gap-4 pt-8 mt-8 border-t border-border">
                    <button type="submit" class="btn-primary flex-1 py-4 text-base shadow-xl shadow-primary/20">
                        <i class="fas fa-save mr-2"></i>
                        Enregistrer le Dossier
                    </button>
                    <a href="{{ path('dossier_medical_index') }}" class="btn-secondary py-4 px-10 text-base">
                        <i class="fas fa-times mr-2"></i>
                        Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>

        </div>
    </main>
</div>
{% endblock %}