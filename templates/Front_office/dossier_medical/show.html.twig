{% extends 'base.html.twig' %}

{% block title %}Dossier Médical #{{ dossier_medical.id }} - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-5xl space-y-8 p-4 lg:p-8">

            {# ── Page Header ── #}
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-10 h-10 text-lg"><i class="fas fa-file-medical"></i></span>
                        Dossier Médical #{{ dossier_medical.id }}
                    </h1>
                    <p class="page-subtitle mt-1">
                        Créé le {{ dossier_medical.dateCreation|date('d/m/Y') }} 
                        {% if dossier_medical.derniereMiseAJour %}
                            • Dernière MAJ : {{ dossier_medical.derniereMiseAJour|date('d/m/Y H:i') }}
                        {% endif %}
                    </p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <a href="{{ path('dossier_medical_ai_analysis', {'id': dossier_medical.id}) }}" class="btn-primary bg-indigo-600 hover:bg-indigo-700 shadow-indigo-200">
                        <i class="fas fa-brain mr-2"></i> Analyse IA
                    </a>
                    <a href="{{ path('dossier_medical_hf_analysis', {'id': dossier_medical.id}) }}" class="btn-primary bg-orange-500 hover:bg-orange-600 shadow-orange-100 border-orange-400">
                        <i class="fas fa-magic mr-2"></i> Hugging Face
                    </a>
                    <a href="{{ path('dossier_medical_edit', {'id': dossier_medical.id}) }}" class="btn-secondary">
                        <i class="fas fa-edit mr-2"></i> Modifier
                    </a>
                    <a href="{{ path('dossier_medical_index') }}" class="btn-ghost text-muted-foreground hover:text-foreground">
                        <i class="fas fa-arrow-left mr-2"></i> Retour
                    </a>
                </div>
            </div>

            {# ── Medical Information Grid ── #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                
                {% if dossier_medical.antecedentsMedicaux %}
                <div class="card p-6 card-hover border-l-4 border-l-primary/30">
                    <h3 class="section-title mb-4 flex items-center gap-2">
                        <i class="fas fa-history text-primary"></i>
                        Antécédents Médicaux
                    </h3>
                    <p class="text-foreground text-sm leading-relaxed whitespace-pre-wrap">{{ dossier_medical.antecedentsMedicaux }}</p>
                </div>
                {% endif %}

                {% if dossier_medical.maladiesChroniques %}
                <div class="card p-6 card-hover border-l-4 border-l-primary/30">
                    <h3 class="section-title mb-4 flex items-center gap-2">
                        <i class="fas fa-heartbeat text-primary"></i>
                        Maladies Chroniques
                    </h3>
                    <p class="text-foreground text-sm leading-relaxed whitespace-pre-wrap">{{ dossier_medical.maladiesChroniques }}</p>
                </div>
                {% endif %}

                {% if dossier_medical.allergies %}
                <div class="card p-6 card-hover border-l-4 border-l-amber-500/30">
                    <h3 class="section-title mb-4 flex items-center gap-2 text-amber-600">
                        <i class="fas fa-allergies text-amber-500"></i>
                        Allergies
                    </h3>
                    <p class="text-foreground text-sm leading-relaxed whitespace-pre-wrap">{{ dossier_medical.allergies }}</p>
                </div>
                {% endif %}

                {% if dossier_medical.traitementsEnCours %}
                <div class="card p-6 card-hover border-l-4 border-l-indigo-500/30">
                    <h3 class="section-title mb-4 flex items-center gap-2 text-indigo-600">
                        <i class="fas fa-pills text-indigo-500"></i>
                        Traitements en Cours
                    </h3>
                    <p class="text-foreground text-sm leading-relaxed whitespace-pre-wrap">{{ dossier_medical.traitementsEnCours }}</p>
                </div>
                {% endif %}

                {% if dossier_medical.diagnostics %}
                <div class="card p-6 card-hover border-l-4 border-l-primary/30">
                    <h3 class="section-title mb-4 flex items-center gap-2">
                        <i class="fas fa-stethoscope text-primary"></i>
                        Diagnostics
                    </h3>
                    <p class="text-foreground text-sm leading-relaxed whitespace-pre-wrap">{{ dossier_medical.diagnostics }}</p>
                </div>
                {% endif %}

                {% if dossier_medical.notesMedecin %}
                <div class="card p-6 card-hover border-l-4 border-l-muted">
                    <h3 class="section-title mb-4 flex items-center gap-2">
                        <i class="fas fa-notes-medical text-muted-foreground"></i>
                        Notes du Médecin
                    </h3>
                    <p class="text-foreground text-sm leading-relaxed whitespace-pre-wrap italic">{{ dossier_medical.notesMedecin }}</p>
                </div>
                {% endif %}
            </div>

            {# ── Footer Summary ── #}
            <div class="grid md:grid-cols-2 gap-8 pt-8 border-t border-border">
                {% if dossier_medical.objectifSante %}
                <div class="card bg-primary/5 border-primary/20 p-6 flex items-start gap-4">
                    <div class="stat-icon w-12 h-12 bg-primary/20 text-primary shrink-0">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <div>
                        <p class="section-title text-primary mb-1">Objectif Santé</p>
                        <p class="text-foreground font-black text-lg tracking-tight">{{ dossier_medical.objectifSante }}</p>
                    </div>
                </div>
                {% endif %}

                {% if dossier_medical.niveauActivite %}
                <div class="card bg-muted/30 border-border p-6 flex items-start gap-4">
                    <div class="stat-icon w-12 h-12 bg-muted text-muted-foreground shrink-0">
                        <i class="fas fa-running"></i>
                    </div>
                    <div>
                        <p class="section-title mb-1">Niveau d'Activité</p>
                        <p class="text-foreground font-black text-lg tracking-tight">{{ dossier_medical.niveauActivite }}</p>
                    </div>
                </div>
                {% endif %}
            </div>

            {# ── Delete Action ── #}
            <div class="pt-12 flex justify-center">
                <form method="post" action="{{ path('dossier_medical_delete', {'id': dossier_medical.id}) }}" 
                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement ce dossier médical ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dossier_medical.id) }}">
                    <button type="submit" class="btn-ghost text-primary hover:bg-primary/5 px-6 font-bold uppercase tracking-widest text-[10px] flex items-center gap-2">
                        <i class="fas fa-trash-alt"></i> Supprimer ce dossier
                    </button>
                </form>
            </div>

        </div>
    </main>
</div>
{% endblock %}