{% extends 'base.html.twig' %}

{% block title %}Créer un compte - Sosi{% endblock %}

{% block body %}
<div class="relative min-h-screen flex items-center justify-center overflow-hidden bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    
    {# Background Elements #}
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
        <div class="absolute top-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-primary/5 blur-[100px] animate-pulse"></div>
        <div class="absolute bottom-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary/10 blur-[100px] animate-pulse" style="animation-delay: 2s;"></div>
    </div>

    {# Main Card #}
    <div class="relative z-10 w-full max-w-2xl transform transition-all duration-500 animate-page-enter">
        <div class="card p-8 sm:p-12 shadow-2xl shadow-primary/5">
            
            {# Header #}
            <div class="text-center mb-12">
                <h1 class="text-4xl font-black tracking-tighter text-foreground mb-3">
                    Rejoindre <span class="text-primary">Sosi</span>
                </h1>
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-muted-foreground">
                    Déjà membre ?
                    <a href="{{ path('app_login') }}" class="text-primary hover:underline ml-1">
                        Connectez-vous
                    </a>
                </p>
            </div>

            {# Flash Messages #}
            {% for flash_error in app.flashes('error') %}
                <div class="mb-8 rounded-2xl bg-primary/10 p-4 border border-primary/20 flex items-start gap-3 animate-shake">
                    <i class="fas fa-exclamation-circle text-primary mt-0.5"></i>
                    <p class="text-xs font-black uppercase tracking-tight text-primary">{{ flash_error }}</p>
                </div>
            {% endfor %}

            {# Steps Indicator #}
            <div class="mb-16 relative px-4">
                <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-0.5 bg-muted rounded-full -z-10"></div>
                <div class="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 bg-primary rounded-full -z-10 transition-all duration-700 ease-out" id="progress-bar" style="width: 0%"></div>
                
                <div class="flex justify-between items-center w-full">
                    <!-- Step 1 Indicator -->
                    <div class="flex flex-col items-center gap-3 group cursor-pointer" onclick="showStep(1)">
                        <div id="dot-1" class="h-12 w-12 rounded-2xl bg-primary text-white flex items-center justify-center text-sm font-black transition-all duration-500 shadow-xl shadow-primary/30 ring-4 ring-white">
                            1
                        </div>
                        <span class="text-[9px] font-black text-foreground tracking-widest uppercase">Compte</span>
                    </div>

                    <!-- Step 2 Indicator -->
                    <div class="flex flex-col items-center gap-3 group cursor-pointer" onclick="showStep(2)">
                        <div id="dot-2" class="h-12 w-12 rounded-2xl bg-white text-muted-foreground flex items-center justify-center text-sm font-black transition-all duration-500 border border-border ring-4 ring-white">
                            2
                        </div>
                        <span class="text-[9px] font-black text-muted-foreground tracking-widest uppercase">Profil</span>
                    </div>

                    <!-- Step 3 Indicator -->
                    <div class="flex flex-col items-center gap-3 group cursor-pointer" onclick="showStep(3)">
                        <div id="dot-3" class="h-12 w-12 rounded-2xl bg-white text-muted-foreground flex items-center justify-center text-sm font-black transition-all duration-500 border border-border ring-4 ring-white">
                            3
                        </div>
                        <span class="text-[9px] font-black text-muted-foreground tracking-widest uppercase">Validation</span>
                    </div>
                </div>
            </div>

            <form method="post" action="{{ path('app_register') }}" id="register-form" class="mt-8">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

                {# ETAPE 1 : Informations personnelles #}
                <div class="form-step space-y-6" id="step-1">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Nom</label>
                            <input id="nom" name="nom" type="text" required class="input-field" placeholder="Doe">
                        </div>
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Prénom</label>
                            <input id="prenom" name="prenom" type="text" required class="input-field" placeholder="John">
                        </div>
                    </div>

                    <div>
                        <label class="form-label uppercase tracking-widest text-[10px]">Email Professionnel</label>
                        <div class="relative group">
                            <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 group-focus-within:text-primary transition-colors"></i>
                            <input id="email" name="email" type="email" autocomplete="email" required class="input-field pl-12" placeholder="john@example.com">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Mot de passe</label>
                            <div class="relative group">
                                <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 group-focus-within:text-primary transition-colors"></i>
                                <input id="password" name="plainPassword" type="password" required class="input-field pl-12" placeholder="••••••••">
                            </div>
                        </div>
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Confirmation</label>
                            <div class="relative group">
                                <i class="fas fa-check-double absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 group-focus-within:text-primary transition-colors"></i>
                                <input id="confirm_password" name="confirm_password" type="password" required class="input-field pl-12" placeholder="••••••••">
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label uppercase tracking-widest text-[10px]">Téléphone</label>
                        <div class="relative group">
                            <i class="fas fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 group-focus-within:text-primary transition-colors"></i>
                            <input id="telephone" name="telephone" type="tel" class="input-field pl-12" placeholder="+216 XX XXX XXX">
                        </div>
                    </div>

                    <div>
                        <label class="form-label uppercase tracking-widest text-[10px]">Rôle Utilisateur</label>
                        <div class="relative">
                            <i class="fas fa-user-tag absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 pointer-events-none"></i>
                            <select id="role" name="role" required class="input-field pl-12 appearance-none cursor-pointer">
                                <option value="">Sélectionnez votre rôle</option>
                                <option value="ROLE_PATIENT">Patient (Standard)</option>
                                <option value="ROLE_MEDECIN">Médecin / Praticien</option>
                                <option value="ROLE_ADMIN">Administrateur</option>
                            </select>
                            <i class="fas fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-[10px] text-muted-foreground/50 pointer-events-none"></i>
                        </div>
                    </div>

                    <div class="pt-6">
                        <button type="button" onclick="validateAndNext(1)" class="btn-primary w-full py-4 text-sm font-black uppercase tracking-[0.2em] shadow-xl shadow-primary/20">
                            Suivant
                            <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                        </button>
                    </div>
                </div>

                {# ETAPE 2 : Informations physiques #}
                <div class="form-step hidden space-y-6" id="step-2">
                    <div class="bg-muted/30 p-4 rounded-2xl border border-border mb-6 flex items-start gap-4">
                        <div class="stat-icon w-8 h-8 bg-primary/10 text-primary text-xs shrink-0">
                            <i class="fas fa-info"></i>
                        </div>
                        <p class="text-[10px] font-bold text-foreground leading-relaxed uppercase tracking-tight">
                            Ces informations nous aident à personnaliser vos analyses de santé et vos recommandations médicales.
                        </p>
                    </div>

                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Âge</label>
                            <input id="age" name="age" type="number" class="input-field" placeholder="25">
                        </div>
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Sexe</label>
                            <div class="relative">
                                <select id="sexe" name="sexe" class="input-field appearance-none cursor-pointer">
                                    <option value="">Choisir...</option>
                                    <option value="Homme">Homme</option>
                                    <option value="Femme">Femme</option>
                                </select>
                                <i class="fas fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-[10px] text-muted-foreground/50 pointer-events-none"></i>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-6">
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Poids (kg)</label>
                            <input id="poids" name="poids" type="number" step="0.1" class="input-field" placeholder="70.5">
                        </div>
                        <div>
                            <label class="form-label uppercase tracking-widest text-[10px]">Taille (cm)</label>
                            <input id="taille" name="taille" type="number" step="0.1" class="input-field" placeholder="175">
                        </div>
                    </div>

                    <div class="relative flex items-center p-5 border border-border rounded-2xl bg-muted/10 hover:bg-muted/20 transition-colors cursor-pointer group" onclick="document.getElementById('is_handicapped').click()">
                        <div class="flex h-6 items-center">
                            <input id="is_handicapped" name="is_handicapped" type="checkbox" class="h-5 w-5 rounded-lg border-muted text-primary focus:ring-primary/20">
                        </div>
                        <div class="ml-4">
                            <label class="text-xs font-black text-foreground uppercase tracking-tight select-none cursor-pointer group-hover:text-primary transition-colors">Situation de handicap</label>
                            <p class="text-[9px] text-muted-foreground font-bold uppercase tracking-widest mt-0.5">Cochez si vous avez besoin d'assistance particulière.</p>
                        </div>
                    </div>

                    <div class="flex gap-4 pt-6">
                        <button type="button" onclick="showStep(1)" class="btn-secondary flex-1 py-4 text-xs font-black uppercase tracking-widest">
                            Retour
                        </button>
                        <button type="button" onclick="validateAndNext(2)" class="btn-primary flex-1 py-4 text-xs font-black uppercase tracking-widest shadow-xl shadow-primary/20">
                            Suivant
                        </button>
                    </div>
                </div>

                {# ETAPE 3 : Confirmation #}
                <div class="form-step hidden space-y-8" id="step-3">
                    <div class="rounded-2xl bg-foreground text-background p-8 shadow-2xl">
                        <div class="flex items-start gap-5">
                            <div class="stat-icon w-12 h-12 bg-primary text-white text-xl shadow-lg shadow-primary/30">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-black uppercase tracking-widest mb-3">Confidentialité & Sécurité</h3>
                                <p class="text-[11px] text-background/60 leading-relaxed font-medium">
                                    Vos données de santé sont cryptées et protégées conformément aux normes RGPD. Sosi s'engage à ne jamais partager vos informations personnelles sans votre consentement explicite.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="relative flex items-center p-5 border border-border rounded-2xl bg-muted/10">
                        <div class="flex h-6 items-center">
                            <input id="terms" name="terms" type="checkbox" required class="h-5 w-5 rounded-lg border-muted text-primary focus:ring-primary/20">
                        </div>
                        <div class="ml-4 text-[11px] font-bold text-muted-foreground leading-snug">
                            <label for="terms" class="select-none">J’accepte les <a href="#" class="text-primary hover:underline">conditions d’utilisation</a> et la <a href="#" class="text-primary hover:underline">politique de confidentialité</a>.</label>
                        </div>
                    </div>

                    <div class="flex gap-4 pt-6">
                        <button type="button" onclick="showStep(2)" class="btn-secondary flex-1 py-4 text-xs font-black uppercase tracking-widest">
                            Retour
                        </button>
                        <button type="submit" class="btn-primary flex-1 py-4 text-xs font-black uppercase tracking-widest shadow-xl shadow-primary/20">
                            Créer mon compte
                        </button>
                    </div>
                </div>
            </form>
        </div>
        
        {# Copyright #}
        <div class="mt-8 text-center text-[10px] font-black uppercase tracking-[0.3em] text-muted-foreground/50">
            &copy; {{ "now"|date("Y") }} SOSI HEALTHCARE. TOUS DROITS RÉSERVÉS.
        </div>
    </div>
</div>

<script>
    function validateAndNext(currentStep) {
        const currentStepDiv = document.getElementById('step-' + currentStep);
        const inputs = Array.from(currentStepDiv.querySelectorAll('input, select'));
        
        for (const input of inputs) {
            if (!input.checkValidity()) {
                input.reportValidity();
                return;
            }
        }
        
        if (currentStep === 1) {
            const pwd = document.getElementById('password');
            const confirm = document.getElementById('confirm_password');
            
            if (pwd.value !== confirm.value) {
                confirm.setCustomValidity("Les mots de passe ne correspondent pas");
                confirm.reportValidity();
                confirm.addEventListener('input', function() { 
                    this.setCustomValidity(''); 
                }, {once: true});
                return;
            }
            
            const role = document.getElementById('role').value;
            const isHealthRequired = (role !== 'ROLE_ADMIN');
            
            ['age', 'poids', 'taille', 'sexe'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.required = isHealthRequired;
            });
        }
        
        showStep(currentStep + 1);
    }

    function showStep(stepNumber) {
        document.querySelectorAll('.form-step').forEach(step => {
            step.classList.add('hidden');
        });
        
        const targetStep = document.getElementById('step-' + stepNumber);
        if (!targetStep) return;
        
        targetStep.classList.remove('hidden');
        targetStep.classList.add('animate-page-enter');
        
        const progressBar = document.getElementById('progress-bar');
        if (stepNumber === 1) progressBar.style.width = '0%';
        if (stepNumber === 2) progressBar.style.width = '50%';
        if (stepNumber === 3) progressBar.style.width = '100%';

        for (let i = 1; i <= 3; i++) {
            const dot = document.getElementById('dot-' + i);
            const label = dot.nextElementSibling;
            
            dot.className = 'h-12 w-12 rounded-2xl flex items-center justify-center text-sm font-black transition-all duration-500 ring-4 ring-white';
            
            if (i < stepNumber) {
                dot.classList.add('bg-primary', 'text-white');
                dot.innerHTML = '<i class="fas fa-check"></i>';
                label.classList.remove('text-muted-foreground');
                label.classList.add('text-primary');
            } else if (i === stepNumber) {
                dot.classList.add('bg-primary', 'text-white', 'shadow-xl', 'shadow-primary/30');
                dot.innerHTML = i;
                label.classList.remove('text-muted-foreground');
                label.classList.add('text-foreground');
            } else {
                dot.classList.add('bg-white', 'text-muted-foreground', 'border', 'border-border');
                dot.innerHTML = i;
                label.classList.add('text-muted-foreground');
                label.classList.remove('text-foreground', 'text-primary');
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        showStep(1);
    });
</script>
{% endblock %}