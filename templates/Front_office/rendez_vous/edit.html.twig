{% extends 'base.html.twig' %}

{% block title %}Modifier Rendez-vous #{{ rendez_vous.id }} - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-4xl space-y-8 p-4 lg:p-8">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-10 h-10 text-lg bg-primary/10 text-primary"><i class="fas fa-edit"></i></span>
                        Modifier le Rendez-vous
                    </h1>
                    <p class="page-subtitle mt-1">Mise à jour de la consultation <span class="text-foreground font-black">#{{ rendez_vous.id }}</span></p>
                </div>
                <a href="{{ path('app_rendez_vous_index') }}" class="btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i> Retour
                </a>
            </div>

            {# ── Form Card ── #}
            <div class="card p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-8', 'novalidate': 'novalidate'}}) }}
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {# Patient #}
                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-user-injured text-primary"></i>
                            Patient
                        </label>
                        {{ form_widget(form.patient, {'attr': {'class': 'input-field cursor-not-allowed bg-muted/20', 'readonly': 'readonly'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.patient) }}</div>
                    </div>

                    {# Medecin #}
                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-user-md text-primary"></i>
                            Médecin
                        </label>
                        {{ form_widget(form.medecin, {'attr': {'class': 'input-field'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.medecin) }}</div>
                    </div>

                    {# Hôpital #}
                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-hospital text-primary"></i>
                            Hôpital
                        </label>
                        {{ form_widget(form.hopital, {'attr': {'class': 'input-field'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.hopital) }}</div>
                    </div>

                    {# Date #}
                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-calendar-day text-primary"></i>
                            Date et heure
                        </label>
                        {{ form_widget(form.dateRendezVous, {'attr': {'class': 'input-field'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.dateRendezVous) }}</div>
                    </div>

                    {# Type #}
                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-stethoscope text-primary"></i>
                            Type de consultation
                        </label>
                        {{ form_widget(form.typeConsultation, {'attr': {'class': 'input-field'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.typeConsultation) }}</div>
                    </div>

                    {# Statut #}
                    <div>
                        <label class="form-label flex items-center gap-2">
                            <i class="fas fa-info-circle text-primary"></i>
                            Statut
                        </label>
                        {{ form_widget(form.statut, {'attr': {'class': 'input-field'}}) }}
                        <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.statut) }}</div>
                    </div>
                </div>

                {# Notes #}
                {% if form.notes is defined %}
                <div class="pt-6 border-t border-border">
                    <label class="form-label flex items-center gap-2">
                        <i class="fas fa-notes-medical text-primary"></i>
                        Notes additionnelles
                    </label>
                    {{ form_widget(form.notes, {'attr': {'class': 'input-field h-32 py-3 resize-none'}}) }}
                    <div class="text-primary text-xs font-bold mt-1">{{ form_errors(form.notes) }}</div>
                </div>
                {% endif %}

                {# ── Actions ── #}
                <div class="flex flex-col sm:flex-row gap-4 pt-8 mt-8 border-t border-border">
                    <button type="submit" class="btn-primary flex-1 py-4 text-base shadow-xl shadow-primary/20 font-black uppercase tracking-widest">
                        <i class="fas fa-save mr-2"></i>
                        Enregistrer les modifications
                    </button>
                    <a href="{{ path('app_rendez_vous_index') }}" class="btn-secondary py-4 px-10 text-base font-black uppercase tracking-widest">
                        Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>

            {# ── Error Notifications ── #}
            {% for message in app.flashes('error') %}
                <div class="animate-shake bg-primary/10 border border-primary/20 text-primary px-6 py-4 rounded-2xl flex items-center gap-3">
                    <i class="fas fa-exclamation-circle text-lg"></i>
                    <span class="font-bold text-sm uppercase tracking-tight">{{ message }}</span>
                </div>
            {% endfor %}

        </div>
    </main>
</div>
{% endblock %}
