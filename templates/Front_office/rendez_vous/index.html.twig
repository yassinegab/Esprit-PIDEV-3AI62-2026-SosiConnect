{% extends 'base.html.twig' %}

{% block title %}Mes Rendez-vous - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-7xl space-y-8 p-4 lg:p-8">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-10 h-10 text-lg bg-primary/10 text-primary"><i class="fas fa-calendar-check"></i></span>
                        Mes Rendez-vous
                    </h1>
                    <p class="page-subtitle mt-1">Gérez vos consultations et votre calendrier médical</p>
                </div>
                <a href="{{ path('app_rendez_vous_new') }}" class="btn-primary py-3 px-6 shadow-xl shadow-primary/20">
                    <i class="fas fa-plus mr-2"></i> Nouveau Rendez-vous
                </a>
            </div>

            {# ── Stats Cards ── #}
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                {% set stats_obj = stats|default({}) %}
                {% set stat_items = [
                    {'label': 'En attente', 'value': stats_obj.en_attente|default(0), 'icon': 'fa-clock', 'color': 'amber'},
                    {'label': 'Confirmés', 'value': stats_obj.confirme|default(0), 'icon': 'fa-check-circle', 'color': 'green'},
                    {'label': 'Annulés', 'value': stats_obj.annule|default(0), 'icon': 'fa-times-circle', 'color': 'red'},
                    {'label': 'Total', 'value': stats_obj.total|default(0), 'icon': 'fa-calendar-alt', 'color': 'primary'}
                ] %}

                {% for item in stat_items %}
                <div class="card p-6 flex items-center gap-5 border-l-4 border-l-{{ item.color == 'primary' ? 'primary' : item.color ~ '-500' }}">
                    <div class="stat-icon w-12 h-12 text-xl bg-{{ item.color == 'primary' ? 'primary' : item.color ~ '-500' }}/10 text-{{ item.color == 'primary' ? 'primary' : item.color ~ '-500' }}">
                        <i class="fas {{ item.icon }}"></i>
                    </div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">{{ item.label }}</p>
                        <p class="text-2xl font-black text-foreground">{{ item.value }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>

            {# ── Filters & Search ── #}
            <div class="card p-6 bg-muted/20 border-dashed border-2">
                <form method="get" class="flex flex-col lg:flex-row gap-4 items-end">
                    <div class="flex-1 w-full">
                        <label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-2 block">Recherche</label>
                        <div class="relative">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/50"></i>
                            <input type="text" name="search" value="{{ search|default('') }}" 
                                   placeholder="Patient, médecin ou hôpital..."
                                   class="input-field pl-12 h-12 text-sm">
                        </div>
                    </div>
                    <div class="w-full lg:w-48">
                        <label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-2 block">Filtrer par statut</label>
                        {% if form_filter is defined and form_filter is not null %}
                            {{ form_widget(form_filter.statut, {'attr': {'class': 'input-field h-12 text-sm appearance-none cursor-pointer'}}) }}
                        {% else %}
                            <select name="statut" class="input-field h-12 text-sm appearance-none cursor-pointer">
                                <option value="">Tous les statuts</option>
                                <option value="En attente" {% if statut|default('') == 'En attente' %}selected{% endif %}>En attente</option>
                                <option value="Confirmé"   {% if statut|default('') == 'Confirmé'   %}selected{% endif %}>Confirmé</option>
                                <option value="Annulé"     {% if statut|default('') == 'Annulé'     %}selected{% endif %}>Annulé</option>
                                <option value="Terminé"    {% if statut|default('') == 'Terminé'    %}selected{% endif %}>Terminé</option>
                            </select>
                        {% endif %}
                    </div>
                    <div class="flex gap-2 w-full lg:w-auto">
                        <button type="submit" class="btn-primary h-12 px-8 flex-1 lg:flex-none">
                            <i class="fas fa-filter mr-2"></i> Filtrer
                        </button>
                        {% if search|default('') or statut|default('') %}
                        <a href="{{ path('app_rendez_vous_index') }}" class="btn-secondary h-12 px-6 flex items-center justify-center">
                            <i class="fas fa-times"></i>
                        </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            {# ── Appointments Table ── #}
            <div class="card p-0 overflow-hidden shadow-2xl shadow-foreground/5">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-foreground text-background">
                                <th class="p-6 text-[10px] font-black uppercase tracking-widest">Détails Patient & Médecin</th>
                                <th class="p-6 text-[10px] font-black uppercase tracking-widest">Hôpital & Lieu</th>
                                <th class="p-6 text-[10px] font-black uppercase tracking-widest">Date & Heure</th>
                                <th class="p-6 text-[10px] font-black uppercase tracking-widest">Type & Statut</th>
                                <th class="p-6 text-[10px] font-black uppercase tracking-widest text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            {% set liste = pagination is defined ? pagination : rendez_vous|default([]) %}
                            {% for rdv in liste %}
                            <tr class="hover:bg-muted/10 transition-colors group">
                                <td class="p-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-full bg-primary/5 flex items-center justify-center text-primary font-black text-xs border border-primary/10">
                                            {{ rdv.patient ? rdv.patient.nom|first|upper ~ rdv.patient.prenom|first|upper : '?' }}
                                        </div>
                                        <div>
                                            <p class="font-black text-foreground text-sm tracking-tight">
                                                {{ rdv.patient ? rdv.patient.nom ~ ' ' ~ rdv.patient.prenom : 'Non assigné' }}
                                            </p>
                                            <p class="text-[10px] font-bold text-muted-foreground uppercase flex items-center gap-1.5 mt-1">
                                                <i class="fas fa-user-md text-primary opacity-60"></i>
                                                {{ rdv.medecin ? 'Dr. ' ~ rdv.medecin.nom : 'Médecin non assigné' }}
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-6">
                                    <div class="flex items-start gap-2.5">
                                        <i class="fas fa-hospital text-primary mt-1 text-xs opacity-50"></i>
                                        <div>
                                            <p class="font-bold text-foreground text-sm tracking-tight">{{ rdv.hopital.nom|default('Non spécifié') }}</p>
                                            <p class="text-[10px] text-muted-foreground font-medium mt-0.5">{{ rdv.hopital.adresse|default('Adresse non renseignée') }}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-muted/30 rounded-xl flex flex-col items-center justify-center text-foreground font-black leading-none">
                                            <span class="text-[9px] uppercase text-muted-foreground mb-1">{{ rdv.dateRendezVous|date('M') }}</span>
                                            <span class="text-sm">{{ rdv.dateRendezVous|date('d') }}</span>
                                        </div>
                                        <div>
                                            <p class="font-black text-foreground text-sm">{{ rdv.dateRendezVous|date('H:i') }}</p>
                                            <p class="text-[10px] font-bold text-primary uppercase tracking-widest mt-0.5">Confirmé</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-6">
                                    <div class="space-y-2">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[9px] font-black uppercase tracking-widest border border-border bg-white text-foreground">
                                            <i class="fas {{ rdv.typeConsultation|default('') == 'Téléconsultation' ? 'fa-video' : 'fa-hospital' }} mr-1.5 text-primary"></i>
                                            {{ rdv.typeConsultation|default('Consultation') }}
                                        </span>
                                        <br>
                                        {% set status_colors = {
                                            'En attente': 'bg-amber-500',
                                            'Confirmé': 'bg-green-500',
                                            'Annulé': 'bg-red-500',
                                            'Terminé': 'bg-foreground'
                                        } %}
                                        <span class="inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-tight text-foreground">
                                            <span class="w-2 h-2 rounded-full {{ status_colors[rdv.statut|default('')]|default('bg-muted') }}"></span>
                                            {{ rdv.statut|default('Inconnu') }}
                                        </span>
                                    </div>
                                </td>
                                <td class="p-6 text-right">
                                    <div class="flex justify-end gap-2">
                                        <a href="{{ path('app_rendez_vous_show', {'id': rdv.id}) }}" class="w-9 h-9 flex items-center justify-center rounded-xl bg-muted/30 text-muted-foreground hover:bg-foreground hover:text-white transition-all">
                                            <i class="fas fa-eye text-xs"></i>
                                        </a>
                                        <a href="{{ path('app_rendez_vous_edit', {'id': rdv.id}) }}" class="w-9 h-9 flex items-center justify-center rounded-xl bg-muted/30 text-muted-foreground hover:bg-primary hover:text-white transition-all">
                                            <i class="fas fa-edit text-xs"></i>
                                        </a>
                                        <button onclick="confirmDelete({{ rdv.id }})" class="w-9 h-9 flex items-center justify-center rounded-xl bg-muted/30 text-muted-foreground hover:bg-red-500 hover:text-white transition-all">
                                            <i class="fas fa-trash text-xs"></i>
                                        </button>
                                        <form id="delete-form-{{ rdv.id }}" method="post" action="{{ path('app_rendez_vous_delete', {'id': rdv.id}) }}" style="display:none;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rdv.id) }}">
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="p-20 text-center">
                                    <div class="stat-icon w-20 h-20 bg-muted/20 text-muted-foreground/30 text-3xl mx-auto mb-6">
                                        <i class="fas fa-calendar-times"></i>
                                    </div>
                                    <h3 class="text-xl font-black text-foreground mb-2">Aucun rendez-vous trouvé</h3>
                                    <p class="text-muted-foreground max-w-xs mx-auto mb-8 text-sm">Ajustez vos filtres ou créez une nouvelle demande de consultation.</p>
                                    <a href="{{ path('app_rendez_vous_new') }}" class="btn-primary px-10 py-4 shadow-xl shadow-primary/20">
                                        <i class="fas fa-plus mr-2"></i> CRÉER UN RENDEZ-VOUS
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if pagination is defined and pagination.getTotalItemCount > 0 %}
                <div class="p-6 bg-muted/20 border-t border-border flex flex-col md:flex-row items-center justify-between gap-6">
                    <p class="text-xs font-black uppercase tracking-widest text-muted-foreground">
                        Affichage de <span class="text-foreground">{{ pagination.getItemNumberPerPage }}</span> sur <span class="text-primary">{{ pagination.getTotalItemCount }}</span> résultats
                    </p>
                    <div class="pagination-container">
                        {{ knp_pagination_render(pagination) }}
                    </div>
                </div>
                {% endif %}
            </div>

            {# ── Footer Info ── #}
            <div class="flex items-center justify-center gap-4 text-muted-foreground/40 py-8 italic text-xs font-medium">
                <i class="fas fa-shield-alt text-lg"></i>
                <span>SmartHealth AI — Système de gestion médicale sécurisé et certifié conforme.</span>
            </div>

        </div>
    </main>
</div>

<script>
function confirmDelete(id) {
    if (confirm('Êtes-vous sûr de vouloir supprimer ce rendez-vous ?')) {
        document.getElementById('delete-form-' + id).submit();
    }
}
</script>

<style>
/* Custom Pagination Styling for KNP */
.pagination-container .pagination { @apply flex gap-1; }
.pagination-container .pagination span, 
.pagination-container .pagination a { 
    @apply w-10 h-10 flex items-center justify-center rounded-xl font-black text-xs transition-all border border-transparent; 
}
.pagination-container .pagination a { @apply bg-white border-border text-muted-foreground hover:border-primary hover:text-primary; }
.pagination-container .pagination .current { @apply bg-foreground text-background shadow-lg; }
</style>

{% endblock %}
