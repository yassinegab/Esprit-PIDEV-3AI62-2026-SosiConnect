{% extends 'base.html.twig' %}

{% block title %}Détail Rendez-vous #{{ rendez_vous.id }} - Sosi{% endblock %}

{% block body %}
<div class="flex flex-col min-h-screen">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 animate-page-enter pb-12">
        <div class="mx-auto max-w-6xl space-y-8 p-4 lg:p-8">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-10 h-10 text-lg bg-primary/10 text-primary"><i class="fas fa-clipboard-check"></i></span>
                        Rendez-vous #{{ rendez_vous.id }}
                    </h1>
                    <p class="page-subtitle mt-1">Détails complets de la consultation programmée</p>
                </div>
                <div class="flex gap-3">
                    <a href="{{ path('app_rendez_vous_edit', {'id': rendez_vous.id}) }}" class="btn-primary py-2 px-5">
                        <i class="fas fa-edit mr-2"></i> Modifier
                    </a>
                    <a href="{{ path('app_rendez_vous_index') }}" class="btn-secondary py-2 px-5">
                        <i class="fas fa-arrow-left mr-2"></i> Retour
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                {# ── Main Column (2/3) ── #}
                <div class="lg:col-span-2 space-y-8">

                    {# Status & Date Info #}
                    <div class="card p-8 border-t-4 border-t-primary">
                        <div class="flex items-center justify-between mb-8">
                            <h2 class="section-title">Informations de Session</h2>
                            {% set status_styles = {
                                'En attente': 'badge-primary bg-amber-500 text-white border-none',
                                'Confirmé': 'badge-success py-2 px-6',
                                'Annulé': 'badge-danger py-2 px-6',
                                'Terminé': 'badge-muted py-2 px-6 bg-foreground text-background border-none'
                            } %}
                            <span class="{{ status_styles[rendez_vous.statut]|default('badge-muted') }} text-[10px] font-black uppercase tracking-widest shadow-lg">
                                {{ rendez_vous.statut|default('STATUT INCONNU') }}
                            </span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="flex items-start gap-4">
                                <div class="stat-icon w-12 h-12 bg-primary/10 text-primary text-xl">
                                    <i class="fas fa-calendar-day"></i>
                                </div>
                                <div>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-1">Date & Heure</p>
                                    <p class="text-lg font-black text-foreground tracking-tight">
                                        {{ rendez_vous.dateRendezVous ? rendez_vous.dateRendezVous|date('d/m/Y à H:i') : 'Non définie' }}
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-start gap-4">
                                <div class="stat-icon w-12 h-12 bg-muted/20 text-foreground text-xl">
                                    <i class="fas fa-stethoscope"></i>
                                </div>
                                <div>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-1">Type de Consultation</p>
                                    <p class="text-lg font-black text-foreground tracking-tight">
                                        {{ rendez_vous.typeConsultation ?? 'Non spécifié' }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Stakeholders #}
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        {# Patient #}
                        <div class="card p-6 border-muted/20 bg-muted/5">
                            <p class="text-[9px] font-black uppercase tracking-widest text-primary mb-4 flex items-center gap-2">
                                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Patient
                            </p>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-white border border-border rounded-full flex items-center justify-center font-black text-xs text-foreground shadow-sm">
                                    {{ rendez_vous.patient ? rendez_vous.patient.nom|first|upper ~ rendez_vous.patient.prenom|first|upper : '?' }}
                                </div>
                                <div class="overflow-hidden">
                                    <p class="font-black text-foreground text-sm truncate">{{ rendez_vous.patient ? rendez_vous.patient.fullName : 'Non assigné' }}</p>
                                    <p class="text-[10px] text-muted-foreground truncate">{{ rendez_vous.patient ? rendez_vous.patient.email : 'Aucun email' }}</p>
                                </div>
                            </div>
                        </div>

                        {# Médecin #}
                        <div class="card p-6 border-muted/20 bg-muted/5">
                            <p class="text-[9px] font-black uppercase tracking-widest text-foreground mb-4 flex items-center gap-2">
                                <span class="w-1.5 h-1.5 bg-foreground rounded-full"></span> Médecin
                            </p>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-foreground text-background rounded-full flex items-center justify-center font-black text-xs shadow-lg">
                                    <i class="fas fa-user-md"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <p class="font-black text-foreground text-sm truncate">{{ rendez_vous.medecin ? 'Dr. ' ~ rendez_vous.medecin.nom : 'Non assigné' }}</p>
                                    <p class="text-[10px] text-muted-foreground truncate">{{ rendez_vous.medecin.specialite|default('Généraliste') }}</p>
                                </div>
                            </div>
                        </div>

                        {# Hôpital #}
                        <div class="card p-6 border-muted/20 bg-muted/5">
                            <p class="text-[9px] font-black uppercase tracking-widest text-muted-foreground mb-4 flex items-center gap-2">
                                <span class="w-1.5 h-1.5 bg-muted-foreground rounded-full"></span> Établissement
                            </p>
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-white border border-border rounded-full flex items-center justify-center font-black text-xs text-muted-foreground shadow-sm">
                                    <i class="fas fa-hospital"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <p class="font-black text-foreground text-sm truncate">{{ rendez_vous.hopital ? rendez_vous.hopital.nom : 'Non assigné' }}</p>
                                    <p class="text-[10px] text-muted-foreground truncate">{{ rendez_vous.hopital ? rendez_vous.hopital.adresse : 'Adresse non spécifiée' }}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Notes Section #}
                    {% if (rendez_vous.motif is defined and rendez_vous.motif) or (rendez_vous.notes is defined and rendez_vous.notes) %}
                    <div class="card p-8">
                        <h2 class="section-title mb-6 flex items-center gap-3">
                            <i class="fas fa-notes-medical text-primary opacity-50"></i> Observations Médicales
                        </h2>
                        
                        <div class="space-y-6">
                            {% if rendez_vous.motif is defined and rendez_vous.motif %}
                            <div class="p-6 bg-primary/5 rounded-2xl border border-primary/10">
                                <p class="text-[10px] font-black uppercase tracking-widest text-primary mb-2">Motif de consultation</p>
                                <p class="text-sm text-foreground font-medium italic leading-relaxed">"{{ rendez_vous.motif }}"</p>
                            </div>
                            {% endif %}

                            {% if rendez_vous.notes is defined and rendez_vous.notes %}
                            <div class="p-6 bg-muted/20 rounded-2xl border border-border">
                                <p class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-2">Notes cliniques</p>
                                <p class="text-sm text-foreground/80 leading-relaxed">{{ rendez_vous.notes }}</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                    {# Danger Zone #}
                    <div class="flex items-center justify-between p-6 bg-red-50 border border-red-100 rounded-2xl">
                        <div class="flex items-center gap-4">
                            <div class="stat-icon w-10 h-10 bg-red-100 text-red-600 text-sm">
                                <i class="fas fa-trash-alt"></i>
                            </div>
                            <div>
                                <p class="font-black text-red-950 text-sm">Zone de danger</p>
                                <p class="text-[10px] text-red-700/60 font-medium">L'annulation est irréversible une fois confirmée.</p>
                            </div>
                        </div>
                        <button onclick="confirmDelete()" class="btn-primary bg-red-600 hover:bg-red-700 shadow-red-200 py-2 px-6 text-[10px] font-black uppercase tracking-widest">
                            Annuler le RDV
                        </button>
                        <form id="delete-form" method="post" action="{{ path('app_rendez_vous_delete', {'id': rendez_vous.id}) }}" style="display:none;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rendez_vous.id) }}">
                        </form>
                    </div>
                </div>

                {# ── Sidebar Column (1/3) ── #}
                <div class="lg:col-span-1">
                    <div class="sticky top-8 space-y-6">
                        {# QR Code Card #}
                        <div class="card p-8 text-center bg-foreground text-background shadow-2xl shadow-foreground/20">
                            <h2 class="text-lg font-black tracking-tight mb-2 uppercase italic">Votre Pass RDV</h2>
                            <p class="text-[10px] font-medium opacity-50 mb-8 tracking-widest">PRÉSENTEZ CE CODE À L'ACCUEIL</p>

                            {% if qrCode is defined and qrCode %}
                                <div class="bg-white p-4 rounded-3xl inline-block shadow-inner mb-8 transform hover:scale-105 transition-transform duration-500">
                                    <img src="data:image/png;base64,{{ qrCode }}" alt="QR Code" class="w-48 h-48">
                                </div>
                                <div class="space-y-1">
                                    <p class="text-[10px] font-black uppercase tracking-[0.3em] text-primary">Vérifié</p>
                                    <p class="text-xs opacity-40 font-mono tracking-tighter">REF: {{ rendez_vous.id }}-{{ "now"|date('Y') }}</p>
                                </div>
                            {% else %}
                                <div class="w-48 h-48 mx-auto bg-white/5 rounded-3xl flex flex-col items-center justify-center border-2 border-white/10 border-dashed mb-6">
                                    <i class="fas fa-qrcode text-white/10 text-5xl mb-4"></i>
                                    <p class="text-[10px] font-black uppercase opacity-20">Indisponible</p>
                                </div>
                            {% endif %}

                            <button onclick="window.print()" class="mt-10 w-full btn-primary bg-white text-foreground hover:bg-muted py-4 text-xs font-black uppercase tracking-widest">
                                <i class="fas fa-print mr-2"></i> Imprimer le Pass
                            </button>
                        </div>

                        {# Tech Info Card #}
                        <div class="card p-6 bg-muted/20 border-dashed border-2">
                            <h3 class="text-[10px] font-black uppercase tracking-widest text-muted-foreground mb-4">Méta-données</h3>
                            <div class="space-y-4">
                                <div class="flex justify-between text-[10px]">
                                    <span class="font-bold text-muted-foreground/60">CRÉÉ LE</span>
                                    <span class="font-black text-foreground">{{ rendez_vous.createdAt|date('d/m/Y')|default('N/A') }}</span>
                                </div>
                                <div class="flex justify-between text-[10px]">
                                    <span class="font-bold text-muted-foreground/60">ID SYSTEM</span>
                                    <span class="font-black text-primary">#{{ rendez_vous.id }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
function confirmDelete() {
    if (confirm('Voulez-vous vraiment supprimer ce rendez-vous ?')) {
        document.getElementById('delete-form').submit();
    }
}
</script>
{% endblock %}
