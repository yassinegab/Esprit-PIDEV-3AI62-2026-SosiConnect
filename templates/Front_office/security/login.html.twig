{% extends 'base.html.twig' %}

{% block title %}Connexion - Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .root-container {
        min-height: 100 screen;
        background-color: #f8f9fb;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .background-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }
    .overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(248, 249, 251, 0.88);
        z-index: 1;
    }
    .login-card {
        position: relative;
        z-index: 10;
        background-color: rgba(255, 255, 255, 0.99);
        border-radius: 24px;
        box-shadow: 0 16px 40px -10px rgba(220, 53, 69, 0.14);
        border: 1px solid #fecaca;
        width: 100%;
        max-width: 450px;
        padding: 40px;
    }
    .title-label {
        font-size: 28px;
        font-weight: 900;
        color: #1e293b;
        letter-spacing: -0.02em;
    }
    .subtitle-label {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
    }
    .input-label {
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        margin-bottom: 6px;
        display: block;
    }
    .input-container {
        background-color: #f8f9fb;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0 16px;
        display: flex;
        align-items: center;
        height: 48px;
        transition: all 0.2s ease;
    }
    .input-container:focus-within {
        border-color: #dc3545;
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.1);
    }
    .icon-label {
        color: #dc3545;
        font-size: 18px;
        margin-right: 12px;
        width: 20px;
        text-align: center;
    }
    .transparent-input {
        background: transparent;
        border: none;
        outline: none;
        width: 100%;
        font-size: 14px;
        font-weight: 500;
        color: #1e293b;
    }
    .transparent-input::placeholder {
        color: #94a3b8;
    }
    .forgot-password {
        color: #dc3545;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }
    .forgot-password:hover { color: #b91c1c; text-decoration: underline; }
    
    .login-button {
        background: linear-gradient(to right, #dc3545, #b91c1c);
        border-radius: 14px;
        color: white;
        font-size: 16px;
        font-weight: 800;
        height: 52px;
        width: 100%;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 8px 20px -5px rgba(220, 53, 69, 0.35);
        transition: all 0.3s ease;
    }
    .login-button:hover {
        background: linear-gradient(to right, #b91c1c, #991b1b);
        transform: translateY(-1px);
        box-shadow: 0 12px 24px -5px rgba(220, 53, 69, 0.5);
    }
    .login-button:active { transform: translateY(1px); }
    
    .social-button {
        background-color: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 10px 20px;
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        flex: 1;
        transition: all 0.2s ease;
    }
    .social-button:hover {
        background-color: #fff1f2;
        border-color: #fecaca;
        transform: translateY(-1px);
    }
</style>
{% endblock %}

{% block body %}
<div class="root-container min-h-screen">
    {# Background Image Replicating Java #}
    <img src="{{ asset('images/login_background.png') }}" class="background-img" alt="">
    <div class="overlay"></div>

    <div class="login-card animate-page-enter">
        {# Logo #}
        <div class="flex justify-center mb-8">
            <img src="{{ asset('images/sosi_logo.png') }}" style="width: 120px;" alt="Sosi Logo">
        </div>

        {# Header #}
        <div class="text-center mb-10">
            <h1 class="title-label mb-1">Bon retour</h1>
            <p class="subtitle-label">Gérez votre santé en toute simplicité</p>
        </div>

        {# Flash Messages #}
        {% if error is defined and error %}
            <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-xl flex items-center gap-3">
                <i class="fas fa-exclamation-circle text-red-500"></i>
                <p class="text-[11px] font-bold text-red-700">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            </div>
        {% endif %}

        {# Login Form #}
        <form action="{{ path('app_login') }}" method="post" class="space-y-6">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="space-y-5">
                {# Email Field #}
                <div>
                    <label class="input-label">Email</label>
                    <div class="input-container">
                        <i class="fas fa-envelope icon-label"></i>
                        <input type="email" name="_username" value="{{ last_username|default('') }}" required 
                               class="transparent-input" placeholder="exemple@email.com">
                    </div>
                </div>

                {# Password Field #}
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="input-label mb-0">Mot de passe</label>
                        <a href="#" class="forgot-password">Oublié ?</a>
                    </div>
                    <div class="input-container">
                        <i class="fas fa-lock icon-label"></i>
                        <input type="password" name="_password" required 
                               class="transparent-input" placeholder="••••••••">
                    </div>
                </div>
            </div>

            {# Remember Me #}
            <div class="flex items-center">
                <input type="checkbox" name="_remember_me" id="remember_me" class="w-4 h-4 rounded border-gray-300 text-red-600 focus:ring-red-500">
                <label for="remember_me" class="ml-2 text-xs font-semibold text-slate-500 cursor-pointer">Se souvenir de moi</label>
            </div>

            {# Submit Button #}
            <button type="submit" class="login-button">
                <span>Se connecter</span>
                <i class="fas fa-arrow-right text-xs"></i>
            </button>
        </form>

        {# Footer #}
        <div class="mt-8">
            <div class="flex items-center justify-center gap-2 mb-6">
                <span class="text-xs font-semibold text-slate-400">Pas encore de compte ?</span>
                <a href="{{ path('app_register') }}" class="text-xs font-extrabold text-red-600 hover:text-red-700">Créer un compte</a>
            </div>

            <div class="relative flex items-center justify-center mb-6">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-100"></div></div>
                <div class="relative px-4 bg-white"><span class="text-[10px] font-black text-slate-300 uppercase tracking-widest">Ou continuer avec</span></div>
            </div>

            <div class="flex gap-3">
                <a href="#" class="social-button">
                    <i class="fab fa-google text-[#DB4437]"></i>
                    <span>Google</span>
                </a>
                <a href="#" class="social-button">
                    <i class="fab fa-facebook text-[#4267B2]"></i>
                    <span>Facebook</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}