{% extends 'base.html.twig' %}

{% block title %}Gestion des Dons - Sosi Admin{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-slate-50">

    {# Admin Sidebar #}
    {% include 'admin/components/sidebar.html.twig' %}

    <div class="flex flex-1 flex-col lg:ml-64">

        {# Admin Top Nav #}
        {% include 'admin/components/top-nav.html.twig' %}

        <main class="flex-1 animate-page-enter p-6 lg:p-10 space-y-8">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-12 h-12 text-xl bg-primary/10 text-primary">🧾</span>
                        Gestion des Dons
                    </h1>
                    <p class="page-subtitle mt-1">Supervision des demandes et historique des dons du réseau</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-4 py-2 bg-foreground text-background rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg shadow-foreground/10">
                        {{ pagination.total }} Entrée(s)
                    </span>
                </div>
            </div>

            {# ── Notifications ── #}
            {% for message in app.flashes('success') %}
                <div class="animate-fadeIn bg-green-50 border border-green-100 text-green-700 px-6 py-4 rounded-2xl flex items-center gap-3 shadow-sm">
                    <i class="fas fa-check-circle text-lg"></i>
                    <span class="font-bold text-sm uppercase tracking-tight">{{ message }}</span>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="animate-shake bg-primary/5 border border-primary/10 text-primary px-6 py-4 rounded-2xl flex items-center gap-3 shadow-sm">
                    <i class="fas fa-exclamation-circle text-lg"></i>
                    <span class="font-bold text-sm uppercase tracking-tight">{{ message }}</span>
                </div>
            {% endfor %}

            {# ── Search & Filter ── #}
            <div class="card p-6 shadow-xl shadow-foreground/5">
                <form method="get" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
                        <div class="lg:col-span-2 relative group">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 group-focus-within:text-primary transition-colors"></i>
                            <input type="text" name="search" value="{{ filters.search|default('') }}" 
                                   placeholder="Région, type ou donneur..."
                                   class="input-field pl-12 h-12">
                        </div>
                        
                        <div>
                            <select name="statut" class="input-field h-12 appearance-none cursor-pointer">
                                <option value="">Tous les Statuts</option>
                                <option value="EN_ATTENTE" {{ filters.statut|default('') == 'EN_ATTENTE' ? 'selected' }}>En attente</option>
                                <option value="VALIDÉ" {{ filters.statut|default('') == 'VALIDÉ' ? 'selected' }}>Validés</option>
                                <option value="REFUSÉ" {{ filters.statut|default('') == 'REFUSÉ' ? 'selected' }}>Refusés</option>
                            </select>
                        </div>
                        
                        <div>
                            <select name="typeDon" class="input-field h-12 appearance-none cursor-pointer">
                                <option value="">Tous les Types</option>
                                <option value="sang" {{ filters.typeDon|default('') == 'sang' ? 'selected' }}>Sang</option>
                                <option value="organe" {{ filters.typeDon|default('') == 'organe' ? 'selected' }}>Organe</option>
                            </select>
                        </div>

                        <div class="flex gap-2">
                            <button type="submit" class="btn-primary flex-1 h-12 text-[10px] font-black uppercase tracking-widest">
                                Filtrer
                            </button>
                            <a href="{{ path('admin_don_list') }}" class="btn-secondary px-4 h-12 flex items-center justify-center">
                                <i class="fas fa-redo-alt text-[10px]"></i>
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            {# ── Bulk Action Form (Now properly wrapping the table WITHOUT inner nested forms) ── #}
            <form method="post" action="{{ path('admin_don_bulk') }}" id="bulkForm">
                <input type="hidden" name="_token" value="{{ csrf_token('bulk_action') }}">
                
                <div class="card overflow-hidden border-none shadow-xl shadow-foreground/5">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-muted/30 border-b border-border">
                                    <th class="p-6 w-10">
                                        <input type="checkbox" id="selectAll" class="w-5 h-5 rounded-lg border-muted text-primary focus:ring-primary/20 cursor-pointer">
                                    </th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Type & Détails</th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Région</th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Date de Don</th>
                                    <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Statut</th>
                                    <th class="p-6 text-right text-[10px] font-black uppercase tracking-widest text-muted-foreground">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-border">
                                {% for don in dons %}
                                <tr class="group hover:bg-muted/5 transition-colors">
                                    <td class="p-6">
                                        <input type="checkbox" name="ids[]" value="{{ don.id }}" class="don-checkbox w-5 h-5 rounded-lg border-muted text-primary focus:ring-primary/20 cursor-pointer">
                                    </td>
                                    <td class="p-6">
                                        <div class="flex items-center gap-4">
                                            <div class="w-12 h-12 rounded-2xl bg-white border border-border flex items-center justify-center text-2xl shadow-sm group-hover:border-primary/20 transition-colors">
                                                {{ don.typeDon == 'sang' ? '🩸' : '🫀' }}
                                            </div>
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <span class="text-xs font-black text-foreground uppercase tracking-tight">{{ don.typeDon }}</span>
                                                    {% if don.urgence %}
                                                        <span class="inline-flex items-center px-2 py-0.5 rounded bg-primary/10 text-primary text-[8px] font-black uppercase animate-pulse">Urgent</span>
                                                    {% endif %}
                                                </div>
                                                <div class="mt-1">
                                                    {% if don.typeDon == 'sang' and don.typeSanguin %}
                                                        <span class="px-2 py-0.5 rounded bg-foreground text-background text-[9px] font-black">{{ don.typeSanguin }}</span>
                                                    {% elseif don.typeOrgane %}
                                                        <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[9px] font-black uppercase">{{ don.typeOrgane }}</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="p-6">
                                        <p class="text-xs font-bold text-foreground">{{ don.region }}</p>
                                        <p class="text-[8px] text-muted-foreground font-black uppercase tracking-tighter mt-0.5">Secteur Géo</p>
                                    </td>
                                    <td class="p-6">
                                        <p class="text-xs font-bold text-foreground">{{ don.dateDon|date('d/m/Y') }}</p>
                                        <p class="text-[9px] text-primary font-black uppercase tracking-tighter mt-0.5">{{ don.dateDon|date('H:i') }}</p>
                                    </td>
                                    <td class="p-6">
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest border
                                            {% if don.statut == 'VALIDÉ' %}bg-green-50 text-green-700 border-green-100
                                            {% elseif don.statut == 'REFUSÉ' %}bg-primary/5 text-primary border-primary/10
                                            {% else %}bg-amber-50 text-amber-700 border-amber-100{% endif %}">
                                            {{ don.statut }}
                                        </span>
                                    </td>
                                    <td class="p-6 text-right">
                                        <div class="flex justify-end gap-2">
                                            {# Separate buttons using 'formaction' to avoid nested forms or using Javascript #}
                                            {% if don.statut != 'VALIDÉ' %}
                                                <button type="submit" 
                                                        formaction="{{ path('admin_don_validate', {id: don.id}) }}"
                                                        onclick="return setToken('{{ csrf_token('approve' ~ don.id) }}')"
                                                        class="w-10 h-10 rounded-xl flex items-center justify-center bg-green-50 text-green-600 hover:bg-green-600 hover:text-white transition-all shadow-sm">
                                                    <i class="fas fa-check text-xs"></i>
                                                </button>
                                            {% endif %}
                                            
                                            {% if don.statut != 'REFUSÉ' %}
                                                <button type="submit" 
                                                        formaction="{{ path('admin_don_reject', {id: don.id}) }}"
                                                        onclick="return setToken('{{ csrf_token('refuse' ~ don.id) }}')"
                                                        class="w-10 h-10 rounded-xl flex items-center justify-center bg-amber-50 text-amber-600 hover:bg-amber-600 hover:text-white transition-all shadow-sm">
                                                    <i class="fas fa-times text-xs"></i>
                                                </button>
                                            {% endif %}
                                            
                                            <button type="submit" 
                                                    formaction="{{ path('admin_don_delete', {id: don.id}) }}"
                                                    onclick="return setToken('{{ csrf_token('complete' ~ don.id) }}') && confirm('Supprimer ce don ?')"
                                                    class="w-10 h-10 rounded-xl flex items-center justify-center bg-primary/5 text-primary hover:bg-primary hover:text-white transition-all shadow-sm">
                                                <i class="fas fa-trash text-xs"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="p-20 text-center">
                                        <div class="flex flex-col items-center gap-4">
                                            <div class="w-20 h-20 rounded-full bg-muted/20 flex items-center justify-center text-muted-foreground/30 text-3xl">
                                                <i class="fas fa-inbox"></i>
                                            </div>
                                            <div>
                                                <p class="text-sm font-black text-foreground uppercase tracking-widest">Aucun don enregistré</p>
                                                <p class="text-[10px] text-muted-foreground font-bold mt-1">Les nouvelles demandes apparaîtront ici.</p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    
                    {# Footer: Bulk Actions & Pagination #}
                    <div class="p-6 bg-muted/10 border-t border-border flex flex-col sm:flex-row justify-between items-center gap-6">
                        <div class="flex items-center gap-4 w-full sm:w-auto">
                            <select name="action" id="bulkActionSelect" class="input-field h-12 min-w-[200px] text-xs font-black uppercase tracking-widest">
                                <option value="">Action groupée</option>
                                <option value="validate">Valider sélection</option>
                                <option value="reject">Refuser sélection</option>
                                <option value="delete">Supprimer sélection</option>
                            </select>
                            <button type="submit" onclick="return setBulkToken()" class="btn-primary h-12 px-8 text-[10px] font-black uppercase tracking-widest">
                                Appliquer
                            </button>
                        </div>
                        
                        {% if pagination.pages > 1 %}
                            <div class="flex items-center gap-3">
                                {% if pagination.current > 1 %}
                                    <a href="{{ path('admin_don_list', app.request.query.all|merge({page: pagination.current - 1})) }}" 
                                       class="btn-secondary w-10 h-10 flex items-center justify-center p-0">
                                        <i class="fas fa-chevron-left text-[10px]"></i>
                                    </a>
                                {% endif %}
                                
                                <span class="text-[10px] font-black text-muted-foreground uppercase tracking-widest bg-white px-4 py-2 rounded-full border border-border">
                                    {{ pagination.current }} <span class="opacity-30 mx-1">/</span> {{ pagination.pages }}
                                </span>
                                
                                {% if pagination.current < pagination.pages %}
                                    <a href="{{ path('admin_don_list', app.request.query.all|merge({page: pagination.current + 1})) }}" 
                                       class="btn-secondary w-10 h-10 flex items-center justify-center p-0">
                                        <i class="fas fa-chevron-right text-[10px]"></i>
                                    </a>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Hidden token field for JS injection #}
                <input type="hidden" name="_token" id="formToken" value="{{ csrf_token('bulk_action') }}">
            </form>
        </main>
    </div>
</div>

<script>
    // Handles the selection of all checkboxes
    document.getElementById('selectAll')?.addEventListener('change', function() {
        document.querySelectorAll('.don-checkbox').forEach(cb => cb.checked = this.checked);
    });

    // Dynamically updates the CSRF token before submitting row-specific actions
    function setToken(tokenValue) {
        document.getElementById('formToken').value = tokenValue;
        return true;
    }

    // Resets to the bulk action token
    function setBulkToken() {
        document.getElementById('formToken').value = '{{ csrf_token('bulk_action') }}';
        
        // Ensure some items are selected
        const selected = document.querySelectorAll('.don-checkbox:checked').length;
        if (selected === 0) {
            alert('Veuillez sélectionner au moins un don.');
            return false;
        }
        
        const action = document.getElementById('bulkActionSelect').value;
        if (!action) {
            alert('Veuillez choisir une action à appliquer.');
            return false;
        }

        return confirm(`Êtes-vous sûr de vouloir appliquer cette action à ${selected} don(s) ?`);
    }
</script>
{% endblock %}
