{% extends 'base.html.twig' %}

{% block title %}Admin - Hôpital #{{ hopital.id }}{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-slate-50">

    {# Admin Sidebar #}
    {% include 'admin/components/sidebar.html.twig' %}

    <div class="flex flex-1 flex-col lg:ml-64">

        {# Admin Top Nav #}
        {% include 'admin/components/top-nav.html.twig' %}

        <main class="flex-1 animate-page-enter pb-12">
            <div class="mx-auto max-w-4xl space-y-8 p-4 lg:p-8">

                {# ── Page Header ── #}
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <h1 class="page-title flex items-center gap-3">
                            <span class="stat-icon w-10 h-10 text-lg bg-primary/10 text-primary"><i class="fas fa-hospital"></i></span>
                            Détails de l'Établissement
                        </h1>
                        <p class="page-subtitle mt-1">Fiche technique complète de l'unité médicale</p>
                    </div>
                    <a href="{{ path('admin_rendez_vous_index') }}" class="btn-secondary">
                        <i class="fas fa-arrow-left mr-2"></i> Retour
                    </a>
                </div>

                {# ── Main Dashboard ── #}
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    
                    {# Left Column: Quick Info & Image #}
                    <div class="lg:col-span-1 space-y-8">
                        <div class="card overflow-hidden border-none">
                            <div class="aspect-square bg-slate-100 flex items-center justify-center border-b border-border">
                                {% if hopital.imageName %}
                                    <img src="{{ asset('uploads/hopitaux/' ~ hopital.imageName) }}" alt="{{ hopital.nom }}" class="w-full h-full object-cover">
                                {% else %}
                                    <i class="fas fa-hospital text-muted-foreground/20 text-6xl"></i>
                                {% endif %}
                            </div>
                            <div class="p-6 text-center">
                                <h3 class="text-lg font-black tracking-tight text-foreground">{{ hopital.nom }}</h3>
                                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest mt-1">ID: #{{ hopital.id }}</p>
                                
                                <div class="mt-6 flex justify-center">
                                    {% if hopital.serviceUrgenceDispo %}
                                        <span class="inline-flex items-center px-4 py-2 rounded-full bg-green-50 text-green-700 text-[10px] font-black uppercase tracking-[0.2em] shadow-sm border border-green-100">
                                            <span class="w-2 h-2 rounded-full bg-green-500 mr-2 animate-pulse"></span>
                                            Urgence 24/7
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center px-4 py-2 rounded-full bg-slate-100 text-slate-500 text-[10px] font-black uppercase tracking-[0.2em] border border-slate-200">
                                            Urgences Fermées
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="card p-6 space-y-6">
                            <div>
                                <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest mb-2">Ligne de Contact</p>
                                <a href="tel:{{ hopital.tel }}" class="text-sm font-black text-primary flex items-center gap-2">
                                    <i class="fas fa-phone"></i>
                                    {{ hopital.tel }}
                                </a>
                            </div>
                            <div class="pt-6 border-t border-border">
                                <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest mb-2">Capacité de l'Hôpital</p>
                                <p class="text-sm font-black text-foreground flex items-center gap-2">
                                    <i class="fas fa-bed text-primary/40"></i>
                                    {{ hopital.capacite|default('N/A') }} Lits opérationnels
                                </p>
                            </div>
                        </div>
                    </div>

                    {# Right Column: Details & Actions #}
                    <div class="lg:col-span-2 space-y-8">
                        <div class="card p-8 sm:p-10 space-y-10">
                            <div>
                                <h4 class="text-sm font-black uppercase tracking-widest text-foreground mb-6 flex items-center gap-3">
                                    <span class="w-1.5 h-6 bg-primary rounded-full"></span>
                                    Informations Générales
                                </h4>
                                <div class="space-y-8">
                                    <div class="flex items-start gap-4 p-5 bg-muted/10 rounded-2xl border border-border">
                                        <div class="stat-icon w-10 h-10 bg-white text-primary text-sm shadow-sm">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <div>
                                            <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest">Adresse de l'établissement</p>
                                            <p class="text-sm font-bold text-foreground mt-1 leading-relaxed">{{ hopital.adresse }}</p>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-2 gap-8">
                                        <div class="p-5 bg-muted/10 rounded-2xl border border-border">
                                            <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest">Latitude</p>
                                            <p class="text-sm font-black text-foreground mt-1">{{ hopital.latitude|default('--') }}</p>
                                        </div>
                                        <div class="p-5 bg-muted/10 rounded-2xl border border-border">
                                            <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest">Longitude</p>
                                            <p class="text-sm font-black text-foreground mt-1">{{ hopital.longitude|default('--') }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row gap-4 pt-10 border-t border-border">
                                <a href="{{ path('admin_hopital_edit', {'id': hopital.id}) }}" class="btn-primary flex-1 py-5 text-sm font-black uppercase tracking-[0.2em] shadow-xl shadow-primary/20">
                                    <i class="fas fa-edit mr-2 text-[10px]"></i>
                                    Modifier la Fiche
                                </a>
                                <button onclick="confirmDelete()" class="btn-secondary py-5 px-10 text-sm font-black uppercase tracking-[0.2em] text-primary hover:bg-primary/10">
                                    <i class="fas fa-trash mr-2 text-[10px]"></i>
                                    Supprimer
                                </button>
                                
                                <form id="delete-form" method="post" action="{{ path('admin_hopital_delete', {'id': hopital.id}) }}" style="display: none;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ hopital.id) }}">
                                </form>
                            </div>
                        </div>

                        {# Stats Widget placeholder or additional info #}
                        <div class="card p-8 bg-foreground text-background border-none shadow-2xl shadow-foreground/20 overflow-hidden relative">
                            <div class="relative z-10">
                                <h4 class="text-xs font-black uppercase tracking-widest mb-2">Historique d'Activité</h4>
                                <p class="text-[10px] opacity-60 uppercase font-bold tracking-tight">Dernière mise à jour : {{ hopital.updatedAt ? hopital.updatedAt|date('d/m/Y H:i') : 'Non modifiée' }}</p>
                            </div>
                            <div class="absolute -right-4 -bottom-4 opacity-10 text-9xl">
                                <i class="fas fa-history"></i>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>

    </div>
</div>

<script>
function confirmDelete() {
    if (confirm('Êtes-vous sûr de vouloir supprimer cet établissement ? Cette action est irréversible.')) {
        document.getElementById('delete-form').submit();
    }
}
</script>
{% endblock %}
