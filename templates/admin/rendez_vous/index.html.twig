{% extends 'base.html.twig' %}

{% block title %}Administration Médicale - Sosi{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-slate-50">

    {# Admin Sidebar #}
    {% include 'admin/components/sidebar.html.twig' %}

    <div class="flex flex-1 flex-col lg:ml-64">

        {# Admin Top Nav #}
        {% include 'admin/components/top-nav.html.twig' %}

        <main class="flex-1 animate-page-enter p-6 lg:p-10 space-y-12">

            {# ── Page Header ── #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
                <div>
                    <h1 class="page-title flex items-center gap-3">
                        <span class="stat-icon w-12 h-12 text-xl bg-primary/10 text-primary"><i class="fas fa-cogs"></i></span>
                        Console d'Administration
                    </h1>
                    <p class="page-subtitle mt-1">Gestion centralisée des rendez-vous et du réseau hospitalier</p>
                </div>
            </div>

            {# ── Search & Filter Bar ── #}
            <div class="card p-6 shadow-xl shadow-foreground/5">
                <form method="get" class="flex flex-col md:flex-row gap-6">
                    <div class="flex-1 relative group">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 group-focus-within:text-primary transition-colors"></i>
                        <input type="text"
                               name="q"
                               value="{{ search|default('') }}"
                               placeholder="Rechercher par patient, médecin ou hôpital..."
                               class="input-field pl-12 h-14">
                    </div>

                    <div class="md:w-64">
                        <select name="filter" class="input-field h-14 appearance-none cursor-pointer">
                            <option value="all" {{ filter == 'all' ? 'selected' : '' }}>Toutes les données</option>
                            <option value="rdv" {{ filter == 'rdv' ? 'selected' : '' }}>Uniquement RDV</option>
                            <option value="hopital" {{ filter == 'hopital' ? 'selected' : '' }}>Uniquement Hôpitaux</option>
                        </select>
                    </div>

                    <div class="flex gap-3">
                        <button type="submit" class="btn-primary px-8 h-14 text-xs font-black uppercase tracking-widest">
                            Filtrer
                        </button>
                        {% if search %}
                            <a href="{{ path('admin_rendez_vous_index') }}" class="btn-secondary px-8 h-14 text-xs font-black uppercase tracking-widest flex items-center">
                                <i class="fas fa-times mr-2"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            {# ── Statistics Grid ── #}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                {# Pending RDV #}
                <div class="card p-6 border-l-4 border-l-amber-500">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center text-xl shadow-sm">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest">En Attente</p>
                            <p class="text-2xl font-black text-foreground">{{ rendez_vous|filter(rdv => rdv.statut == 'En attente')|length }}</p>
                        </div>
                    </div>
                </div>

                {# Confirmed RDV #}
                <div class="card p-6 border-l-4 border-l-green-500">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center text-xl shadow-sm">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div>
                            <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest">Confirmés</p>
                            <p class="text-2xl font-black text-foreground">{{ rendez_vous|filter(rdv => rdv.statut == 'Confirmé')|length }}</p>
                        </div>
                    </div>
                </div>

                {# Total Hospitals #}
                <div class="card p-6 border-l-4 border-l-primary">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-primary/5 text-primary rounded-2xl flex items-center justify-center text-xl shadow-sm">
                            <i class="fas fa-hospital"></i>
                        </div>
                        <div>
                            <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest">Hôpitaux</p>
                            <p class="text-2xl font-black text-foreground">{{ hopitaux|length }}</p>
                        </div>
                    </div>
                </div>

                {# Total Appointments #}
                <div class="card p-6 border-l-4 border-l-slate-900">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-xl shadow-sm">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div>
                            <p class="text-[9px] font-black text-muted-foreground uppercase tracking-widest">Total RDV</p>
                            <p class="text-2xl font-black text-foreground">{{ rendez_vous|length }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# ── Section: Hôpitaux ── #}
            {% if filter == 'all' or filter == 'hopital' %}
                <section class="space-y-6">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-black uppercase tracking-[0.2em] text-foreground flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full bg-primary"></span>
                            Réseau Hospitalier
                        </h2>
                        <a href="{{ path('admin_hopital_new') }}" class="text-[10px] font-black text-primary uppercase tracking-widest hover:underline">
                            + Ajouter un établissement
                        </a>
                    </div>
                    
                    <div class="card overflow-hidden border-none shadow-xl shadow-foreground/5">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-muted/30 border-b border-border">
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">ID</th>
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Établissement</th>
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Contact</th>
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border">
                                    {% for hopital in hopitaux %}
                                        <tr class="group hover:bg-muted/5 transition-colors">
                                            <td class="p-6 text-[10px] font-black text-muted-foreground">#{{ hopital.id }}</td>
                                            <td class="p-6">
                                                <div class="flex items-center gap-4">
                                                    <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-primary border border-border group-hover:border-primary/20">
                                                        <i class="fas fa-hospital text-sm"></i>
                                                    </div>
                                                    <div>
                                                        <p class="text-xs font-black text-foreground">{{ hopital.nom }}</p>
                                                        <p class="text-[9px] text-muted-foreground font-bold uppercase tracking-tight mt-0.5 truncate max-w-xs">{{ hopital.adresse }}</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="p-6">
                                                <p class="text-[10px] font-black text-foreground">{{ hopital.tel }}</p>
                                                <p class="text-[8px] text-muted-foreground font-black uppercase mt-0.5">Ligne Directe</p>
                                            </td>
                                            <td class="p-6 text-right">
                                                <div class="flex justify-end gap-2">
                                                    <a href="{{ path('admin_hopital_show', {'id': hopital.id}) }}" class="w-8 h-8 rounded-lg flex items-center justify-center bg-muted/30 text-muted-foreground hover:bg-foreground hover:text-white transition-all">
                                                        <i class="fas fa-eye text-[10px]"></i>
                                                    </a>
                                                    <a href="{{ path('admin_hopital_edit', {'id': hopital.id}) }}" class="w-8 h-8 rounded-lg flex items-center justify-center bg-muted/30 text-muted-foreground hover:bg-primary hover:text-white transition-all">
                                                        <i class="fas fa-edit text-[10px]"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="p-12 text-center text-muted-foreground text-[10px] font-black uppercase tracking-widest">Aucun établissement trouvé</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            {% endif %}

            {# ── Section: Rendez-vous ── #}
            {% if filter == 'all' or filter == 'rdv' %}
                <section class="space-y-6">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-black uppercase tracking-[0.2em] text-foreground flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full bg-primary"></span>
                            Suivi des Consultations
                        </h2>
                    </div>

                    <div class="card overflow-hidden border-none shadow-xl shadow-foreground/5">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-muted/30 border-b border-border">
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">ID</th>
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Patient & Praticien</th>
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground">Planification</th>
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-center">Statut</th>
                                        <th class="p-6 text-[10px] font-black uppercase tracking-widest text-muted-foreground text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-border">
                                    {% for rdv in rendez_vous %}
                                        <tr class="group hover:bg-muted/5 transition-colors">
                                            <td class="p-6 text-[10px] font-black text-muted-foreground">#{{ rdv.id }}</td>
                                            <td class="p-6">
                                                <div class="flex items-center gap-6">
                                                    {# Patient #}
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-[10px] font-black">
                                                            {{ rdv.patient ? rdv.patient.nom|first|upper : '?' }}
                                                        </div>
                                                        <div>
                                                            <p class="text-[10px] font-black text-foreground">{{ rdv.patient ? rdv.patient.nom ~ ' ' ~ rdv.patient.prenom : 'Anonyme' }}</p>
                                                            <p class="text-[8px] text-muted-foreground font-black uppercase mt-0.5 tracking-tighter">Patient</p>
                                                        </div>
                                                    </div>
                                                    <i class="fas fa-chevron-right text-muted-foreground/20 text-[8px]"></i>
                                                    {# Doctor #}
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center text-[10px] font-black">
                                                            DR
                                                        </div>
                                                        <div>
                                                            <p class="text-[10px] font-black text-foreground">{% if rdv.medecin %}Dr. {{ rdv.medecin.nom }}{% else %}Non assigné{% endif %}</p>
                                                            <p class="text-[8px] text-muted-foreground font-black uppercase mt-0.5 tracking-tighter">Médecin</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="p-6">
                                                <p class="text-[10px] font-black text-foreground">{{ rdv.dateRendezVous|date('d/m/Y') }}</p>
                                                <p class="text-[9px] text-primary font-black uppercase mt-0.5">{{ rdv.dateRendezVous|date('H:i') }}</p>
                                            </td>
                                            <td class="p-6 text-center">
                                                <span class="inline-flex items-center px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest border
                                                    {% if rdv.statut == 'Confirmé' %}bg-green-50 text-green-700 border-green-100
                                                    {% elseif rdv.statut == 'Annulé' %}bg-red-50 text-red-700 border-red-100
                                                    {% else %}bg-amber-50 text-amber-700 border-amber-100{% endif %}">
                                                    {{ rdv.statut|default('En attente') }}
                                                </span>
                                            </td>
                                            <td class="p-6 text-right">
                                                <div class="flex justify-end gap-2">
                                                    <a href="{{ path('admin_rendez_vous_show', {'id': rdv.id}) }}" class="w-8 h-8 rounded-lg flex items-center justify-center bg-muted/30 text-muted-foreground hover:bg-foreground hover:text-white transition-all">
                                                        <i class="fas fa-eye text-[10px]"></i>
                                                    </a>
                                                    <a href="{{ path('admin_rendez_vous_edit', {'id': rdv.id}) }}" class="w-8 h-8 rounded-lg flex items-center justify-center bg-muted/30 text-muted-foreground hover:bg-primary hover:text-white transition-all">
                                                        <i class="fas fa-edit text-[10px]"></i>
                                                    </a>
                                                    <button onclick="confirmDelete({{ rdv.id }})" class="w-8 h-8 rounded-lg flex items-center justify-center bg-muted/30 text-muted-foreground hover:bg-red-600 hover:text-white transition-all">
                                                        <i class="fas fa-trash text-[10px]"></i>
                                                    </button>
                                                    <form id="delete-form-{{ rdv.id }}" method="post" action="{{ path('admin_rendez_vous_delete', {'id': rdv.id}) }}" style="display: none;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rdv.id) }}">
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="p-20 text-center text-muted-foreground text-[10px] font-black uppercase tracking-widest">Aucun rendez-vous planifié</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            {% endif %}

        </main>
    </div>
</div>

<script>
function confirmDelete(id) {
    if (confirm('Supprimer ce rendez-vous ? Cette action est irréversible.')) {
        document.getElementById('delete-form-' + id).submit();
    }
}
</script>
{% endblock %}