<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sosi{% endblock %}</title>
    
    <!-- Tailwind CSS via CDN (always) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#fafafa',
                        foreground: '#09090b',
                        card: '#ffffff',
                        popover: '#ffffff',
                        primary: { DEFAULT: '#ef4444', foreground: '#ffffff' },
                        muted: { DEFAULT: '#f4f4f5', foreground: '#71717a' },
                        border: 'hsl(240 5.9% 90%)',
                        input: '#e4e4e7',
                        ring: '#ef4444',
                        destructive: '#ef4444'
                    }
                }
            }
        }
    </script>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    {{ importmap('app') }}
    
    {% block stylesheets %}
    <style>
        /* ── Global Resets ─────────────────────────── */
        * { font-family: 'Inter', sans-serif; box-sizing: border-box; }
        :root {
            --primary: #ef4444;
            --background: #fafafa;
            --foreground: #09090b;
            --card: #ffffff;
            --border: hsl(240 5.9% 90%);
            --input: #e4e4e7;
            --muted: #f4f4f5;
            --muted-fg: #71717a;
        }
        body { background: var(--background); color: var(--foreground); }

        /* ── Page & Sidebar Animations ─────────────── */
        @keyframes page-enter { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
        .animate-page-enter { animation: page-enter .4s cubic-bezier(.16,1,.3,1) both; }
        @keyframes slide-in-left { from { opacity:0; transform:translateX(-14px); } to { opacity:1; transform:translateX(0); } }
        .animate-slide-in-left { animation: slide-in-left .3s cubic-bezier(.16,1,.3,1) both; }
        @keyframes fade-in { from { opacity:0; } to { opacity:1; } }
        .animate-fade-in { animation: fade-in .35s ease-out both; }

        /* ── Buttons ───────────────────────────────── */
        .btn-primary {
            display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
            padding:.5rem 1rem; border-radius:.5rem; background:#ef4444; color:#fff;
            font-size:.875rem; font-weight:600; border:none; cursor:pointer;
            box-shadow:0 1px 2px rgba(0,0,0,.05); transition:all .15s ease;
            text-decoration:none;
        }
        .btn-primary:hover { background:#dc2626; box-shadow:0 4px 6px rgba(0,0,0,.1); }
        .btn-primary:active { transform:scale(.97); }
        .btn-primary:disabled { pointer-events:none; opacity:.5; }

        .btn-secondary {
            display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
            padding:.5rem 1rem; border-radius:.5rem; background:#f4f4f5; color:#71717a;
            font-size:.875rem; font-weight:600; border:none; cursor:pointer;
            box-shadow:0 1px 2px rgba(0,0,0,.05); transition:all .15s ease;
            text-decoration:none;
        }
        .btn-secondary:hover { background:#e4e4e7; color:#09090b; }
        .btn-secondary:active { transform:scale(.97); }

        .btn-ghost {
            display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
            padding:.5rem 1rem; border-radius:.5rem; background:transparent; color:#71717a;
            font-size:.875rem; font-weight:600; border:none; cursor:pointer;
            transition:all .15s ease; text-decoration:none;
        }
        .btn-ghost:hover { background:#f4f4f5; color:#09090b; }

        .btn-danger {
            display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
            padding:.5rem 1rem; border-radius:.5rem; background:rgba(239,68,68,.1); color:#ef4444;
            font-size:.875rem; font-weight:600; border:none; cursor:pointer;
            transition:all .15s ease; text-decoration:none;
        }
        .btn-danger:hover { background:#ef4444; color:#fff; }

        /* ── Cards ─────────────────────────────────── */
        .card {
            border-radius:1rem; border:1px solid hsl(240 5.9% 90%); background:#fff;
            padding:1.5rem; box-shadow:0 1px 3px rgba(0,0,0,.05);
            transition:box-shadow .2s ease, transform .2s ease;
        }
        .card:hover { box-shadow:0 4px 12px rgba(0,0,0,.08); }
        .card-flat { border-radius:1rem; border:1px solid hsl(240 5.9% 90%); background:#fff; padding:1.5rem; }

        /* ── Form Elements ─────────────────────────── */
        .input-field {
            display:flex; height:2.5rem; width:100%; border-radius:.5rem;
            border:1px solid #e4e4e7; background:#e4e4e7; padding:.5rem .75rem;
            font-size:.875rem; color:#09090b; outline:none; transition:all .15s ease;
        }
        .input-field::placeholder { color:#71717a; }
        .input-field:focus { border-color:#ef4444; box-shadow:0 0 0 2px rgba(239,68,68,.2); background:#fff; }
        .form-label { display:block; margin-bottom:.375rem; font-size:.875rem; font-weight:500; color:#09090b; }

        /* ── Typography ────────────────────────────── */
        .section-title { font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:#71717a; }
        .page-title { font-size:1.5rem; font-weight:700; letter-spacing:-.025em; color:#09090b; }
        .page-subtitle { font-size:.875rem; color:#71717a; }

        /* ── Badges ────────────────────────────────── */
        .badge-primary { display:inline-flex; align-items:center; border-radius:9999px; background:rgba(239,68,68,.1); padding:.125rem .625rem; font-size:.75rem; font-weight:600; color:#ef4444; }
        .badge-muted   { display:inline-flex; align-items:center; border-radius:9999px; background:#f4f4f5; padding:.125rem .625rem; font-size:.75rem; font-weight:600; color:#71717a; }
        .badge-success { display:inline-flex; align-items:center; border-radius:9999px; background:#dcfce7; padding:.125rem .625rem; font-size:.75rem; font-weight:600; color:#15803d; }
        .badge-warning { display:inline-flex; align-items:center; border-radius:9999px; background:#fef9c3; padding:.125rem .625rem; font-size:.75rem; font-weight:600; color:#a16207; }
        .badge-danger  { display:inline-flex; align-items:center; border-radius:9999px; background:#fee2e2; padding:.125rem .625rem; font-size:.75rem; font-weight:600; color:#dc2626; }

        /* ── Navigation ────────────────────────────── */
        .nav-link { display:flex; align-items:center; gap:.75rem; border-radius:.5rem; padding:.625rem .75rem; font-size:.875rem; font-weight:500; color:#71717a; text-decoration:none; transition:all .15s ease; width:100%; }
        .nav-link:hover { background:#f4f4f5; color:#09090b; }
        .nav-link-active { display:flex; align-items:center; gap:.75rem; border-radius:.5rem; padding:.625rem .75rem; font-size:.875rem; font-weight:500; background:rgba(239,68,68,.1); color:#ef4444; text-decoration:none; width:100%; }
        .sidebar-separator { margin:.625rem 0; border-top:1px solid hsl(240 5.9% 90%); }

        /* ── Stat Icon ─────────────────────────────── */
        .stat-icon { display:flex; flex-shrink:0; align-items:center; justify-content:center; border-radius:.75rem; background:rgba(239,68,68,.1); color:#ef4444; height:2.5rem; width:2.5rem; }

        /* ── Empty State ───────────────────────────── */
        .empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.75rem; padding:2.5rem 0; text-align:center; }
        .empty-state-icon { display:flex; align-items:center; justify-content:center; border-radius:9999px; background:#f4f4f5; color:#71717a; height:3.5rem; width:3.5rem; font-size:1.5rem; }

        /* ── KNP Pagination ────────────────────────── */
        .knp-pagination ul { display:flex; gap:4px; list-style:none; padding:0; margin:0; align-items:center; flex-wrap:wrap; }
        .knp-pagination ul li a,
        .knp-pagination ul li span { display:inline-flex; align-items:center; justify-content:center; min-width:36px; height:36px; padding:6px 12px; border:1px solid hsl(240 5.9% 90%); border-radius:8px; font-size:13px; font-weight:500; color:#71717a; background:#fff; text-decoration:none; transition:all .2s ease; }
        .knp-pagination ul li a:hover { background:#f4f4f5; border-color:#ef4444; color:#ef4444; transform:translateY(-1px); }
        .knp-pagination ul li.active span { background:#ef4444; border-color:#ef4444; color:#fff; font-weight:700; box-shadow:0 2px 8px rgba(239,68,68,.3); }
        .knp-pagination ul li.disabled span { color:#d1d5db; cursor:not-allowed; background:#fafafa; border-color:#f4f4f5; }
    </style>
    {% endblock %}
</head>
<body class="bg-background text-foreground antialiased min-h-screen flex flex-col">
    {% block body %}{% endblock %}
    
    <!-- Alpine.js for interactivity -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    {# Chart.js #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
