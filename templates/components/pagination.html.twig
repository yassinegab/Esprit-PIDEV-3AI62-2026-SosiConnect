{% set current = page ?? 1 %}
{% set total = total_pages ?? 1 %}
{% set baseParams = paramsBase ?? {} %}
{% set pageParam = pageParam ?? 'page' %}
{% set routeName = route ?? app.request.attributes.get('_route') %}

{% if total > 1 %}
<div class="flex items-center justify-between border-t border-border bg-background px-6 py-4">
    <div class="text-sm text-muted-foreground">
        Page <span class="font-semibold text-foreground">{{ current }}</span> sur <span class="font-semibold text-foreground">{{ total }}</span>
    </div>
    <div class="flex items-center gap-1.5">
        {% if current > 1 %}
            <a href="{{ path(routeName, baseParams|merge({ (pageParam): current - 1 })) }}"
               class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-sm font-medium text-muted-foreground transition-all hover:bg-muted hover:text-foreground">
                <i class="fas fa-chevron-left text-xs"></i> Précédent
            </a>
        {% endif %}

        {% set start = current - 2 %}
        {% set end = current + 2 %}
        {% if start < 1 %}{% set start = 1 %}{% endif %}
        {% if end > total %}{% set end = total %}{% endif %}

        {% for i in start..end %}
            {% if i == current %}
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white shadow-sm">{{ i }}</span>
            {% else %}
                <a href="{{ path(routeName, baseParams|merge({ (pageParam): i })) }}"
                   class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-card text-sm font-medium text-muted-foreground transition-all hover:bg-muted hover:text-foreground">
                    {{ i }}
                </a>
            {% endif %}
        {% endfor %}

        {% if current < total %}
            <a href="{{ path(routeName, baseParams|merge({ (pageParam): current + 1 })) }}"
               class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-sm font-medium text-muted-foreground transition-all hover:bg-muted hover:text-foreground">
                Suivant <i class="fas fa-chevron-right text-xs"></i>
            </a>
        {% endif %}
    </div>
</div>
{% endif %}
