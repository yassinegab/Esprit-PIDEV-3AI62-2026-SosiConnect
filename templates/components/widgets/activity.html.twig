<div class="card">
    <div class="mb-5 flex items-center justify-between">
        <h3 class="section-title">Activité & Engagement</h3>
        <i class="fas fa-running text-muted-foreground"></i>
    </div>

    {% if latestWellBeing %}
        <div class="space-y-5 py-1">
            <div>
                <div class="mb-2 flex items-center justify-between text-xs">
                    <span class="font-medium text-muted-foreground">Assiduité en classe</span>
                    <span class="font-bold text-slate-600">{{ latestWellBeing.classAttendance * 20 }}%</span>
                </div>
                <div class="h-1.5 w-full rounded-full bg-muted">
                    <div class="h-full rounded-full bg-slate-400 transition-all duration-700"
                         style="width: {{ latestWellBeing.classAttendance * 20 }}%;"></div>
                </div>
            </div>

            <div>
                <div class="mb-2 flex items-center justify-between text-xs">
                    <span class="font-medium text-muted-foreground">Confiance académique</span>
                    <span class="font-bold text-primary">{{ (6 - latestWellBeing.lowAcademicConfidence) * 20 }}%</span>
                </div>
                <div class="h-1.5 w-full rounded-full bg-muted">
                    <div class="h-full rounded-full bg-primary transition-all duration-700"
                         style="width: {{ (6 - latestWellBeing.lowAcademicConfidence) * 20 }}%;"></div>
                </div>
                <p class="mt-1.5 text-[10px] italic text-muted-foreground">Score basé sur vos derniers ressentis.</p>
            </div>

            <div class="rounded-xl border border-border bg-muted/50 p-3">
                <div class="flex items-center gap-3">
                    <div class="stat-icon text-sm">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <div>
                        <p class="section-title">Palpitations</p>
                        <p class="text-sm font-semibold text-foreground">{{ latestWellBeing.heartbeatPalpitations }}/5</p>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-walking text-muted-foreground/50"></i>
            </div>
            <p class="text-xs italic text-muted-foreground">Bougez un peu, restez en forme !</p>
        </div>
    {% endif %}
</div>
