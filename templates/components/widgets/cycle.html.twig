<div class="card">
    <div class="mb-5 flex items-center justify-between">
        <h3 class="section-title">Suivi du Cycle</h3>
        <i class="fas fa-moon text-primary/60"></i>
    </div>

    {% if latestCycle %}
        {% set daysElapsed = date().diff(date(latestCycle.dateDebutM)).days %}
        <div class="flex flex-col items-center py-1">
            {# Day circle #}
            <div class="mb-5 flex h-24 w-24 items-center justify-center rounded-full bg-primary/10 text-primary shadow-inner ring-4 ring-primary/10">
                <div class="text-center">
                    <p class="text-3xl font-black">J{{ daysElapsed + 1 }}</p>
                    <p class="text-[8px] font-bold uppercase tracking-widest text-primary/70">du cycle</p>
                </div>
            </div>

            <div class="w-full space-y-4">
                {# Phase badge + next period #}
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="badge-primary">
                        {% if daysElapsed < 5 %}Phase Menstruelle
                        {% elseif daysElapsed < 14 %}Phase Folliculaire
                        {% elseif daysElapsed < 17 %}Ovulation
                        {% else %}Phase Lutéale{% endif %}
                    </span>
                    <span class="text-[10px] font-medium text-muted-foreground">
                        Règles dans {{ (28 - daysElapsed) > 0 ? (28 - daysElapsed) : 'quelques' }} j
                    </span>
                </div>

                {# Action buttons #}
                <div class="flex gap-2">
                    <a href="{{ path('cycle_index') }}"
                       class="btn-secondary flex-1 py-2 text-[11px]">
                        Calendrier
                    </a>
                    <a href="{{ path('cycle_analyse') }}"
                       class="btn-primary flex-1 py-2 text-[11px]">
                        Analyser AI
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-calendar-alt text-muted-foreground/50"></i>
            </div>
            <p class="text-sm text-muted-foreground">Commencez à suivre votre cycle pour des prédictions personnalisées.</p>
            <a href="{{ path('cycle_index') }}" class="btn-primary mt-1 px-5 py-2 text-xs">
                Activer le suivi
            </a>
        </div>
    {% endif %}
</div>
