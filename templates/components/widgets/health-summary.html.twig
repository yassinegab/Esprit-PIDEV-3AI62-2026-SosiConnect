<div class="card">
    <div class="mb-5 flex items-center justify-between">
        <h3 class="section-title">Résumé de santé</h3>
        <span class="badge-muted">
            {{ latestWellBeing ? latestWellBeing.createdAt|date('d/m/Y') : 'N/A' }}
        </span>
    </div>

    {% if latestWellBeing %}
        <div class="space-y-4">
            {% set factors = [
                { 'label': 'Environnement de travail', 'value': latestWellBeing.workEnvironment, 'icon': '🏢' },
                { 'label': 'Problèmes de sommeil', 'value': latestWellBeing.sleepProblems, 'icon': '🌙' },
                { 'label': 'Maux de tête', 'value': latestWellBeing.headaches, 'icon': '🤕' },
                { 'label': 'Agitation', 'value': latestWellBeing.restlessness, 'icon': '🧘' }
            ] %}

            {% for factor in factors %}
                <div>
                    <div class="mb-1.5 flex items-center justify-between text-xs">
                        <span class="font-medium text-foreground">{{ factor.icon }} {{ factor.label }}</span>
                        <span class="font-bold text-foreground">{{ factor.value }}/5</span>
                    </div>
                    <div class="h-1.5 w-full rounded-full bg-muted">
                        <div class="h-full rounded-full transition-all duration-500 {{ factor.value > 3 ? 'bg-primary' : (factor.value > 1 ? 'bg-primary/70' : 'bg-slate-300') }}"
                             style="width: {{ factor.value * 20 }}%;"></div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-clipboard-list text-muted-foreground/50"></i>
            </div>
            <p class="text-sm text-muted-foreground">Aucune donnée de bien-être récente.</p>
            <a href="#" class="badge-primary hover:bg-primary/20 transition-colors">Remplir le questionnaire →</a>
        </div>
    {% endif %}
</div>
