{% set nutritionVal = nutrition|default({'calories': 0, 'count': 0, 'sugar': 0, 'protein': 0}) %}
<div class="card">
    <div class="mb-5 flex items-center justify-between">
        <h3 class="section-title">Nutrition du Jour</h3>
        <i class="fas fa-utensils text-muted-foreground"></i>
    </div>

    <div class="space-y-5">
        {# Calorie hero #}
        <div class="flex items-center justify-between">
            <div>
                <p class="text-3xl font-bold text-foreground">{{ nutritionVal.calories|number_format(0) }}</p>
                <p class="mt-0.5 text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">Kcal consommées</p>
            </div>
            <div class="flex h-14 w-14 items-center justify-center rounded-full border-4 border-primary/20 bg-primary/5">
                <span class="text-xs font-bold text-primary">{{ (nutritionVal.calories / 20)|round }}%</span>
            </div>
        </div>

        {# Protein & Sugar tiles #}
        <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-muted p-3">
                <p class="section-title">Protéines</p>
                <p class="mt-1 text-lg font-bold text-foreground">{{ nutritionVal.protein|number_format(1) }}g</p>
            </div>
            <div class="rounded-xl bg-muted p-3">
                <p class="section-title">Sucre</p>
                <p class="mt-1 text-lg font-bold text-foreground">{{ nutritionVal.sugar|number_format(1) }}g</p>
            </div>
        </div>

        {# Meal count status #}
        <div class="border-t border-border pt-4">
            <p class="section-title mb-2">Historique récent</p>
            <p class="text-xs text-muted-foreground">
                Vous avez enregistré <strong class="text-foreground">{{ nutritionVal.count }}</strong> repas aujourd'hui.
                {% if nutritionVal.count == 0 %}
                    <span class="text-primary italic"> Commencez à noter vos repas !</span>
                {% elseif nutritionVal.count < 3 %}
                    <span class="text-primary italic"> Continuez sur cette lancée.</span>
                {% else %}
                    <span class="text-slate-600 italic"> Excellent suivi !</span>
                {% endif %}
            </p>
        </div>
    </div>
</div>
