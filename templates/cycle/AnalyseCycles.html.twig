{% extends 'base.html.twig' %}

{% block body %}
<div class="flex min-h-screen bg-slate-50">

  <div class="flex flex-1 flex-col">
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 overflow-auto">
      <div class="mx-auto max-w-7xl space-y-8 p-6">

        <!-- HEADER -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                Analyse Intelligente
            </h1>
            <p class="text-slate-500 mt-1 font-medium">Détection d'irrégularités et prédictions par IA</p>
          </div>

          <div class="flex items-center gap-3">
              <a href="{{ path('cycle_index') }}" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition-all hover:bg-slate-50">
                  <i class="fas fa-arrow-left text-primary"></i>
                  Retour
              </a>
              <div class="bg-white shadow-sm border border-slate-200 rounded-xl px-4 py-2 text-slate-700 font-semibold flex items-center gap-2">
                <i class="far fa-calendar-alt text-primary"></i>
                {{ "now"|date("d F Y") }}
              </div>
          </div>
        </div>

        <!-- STAT CARDS -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

          <!-- Moyenne animée -->
          <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-7 hover:shadow-md transition-all group">
            <h3 class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">Durée moyenne</h3>
            <div class="flex items-baseline gap-2">
                <span id="averageCounter" class="text-5xl font-black text-slate-900 leading-none">0</span>
                <span class="text-lg font-bold text-slate-400">jours</span>
            </div>
            <div class="mt-4 h-1 w-12 rounded-full bg-primary transition-all group-hover:w-20"></div>
          </div>

          <!-- Prediction -->
          <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-7 hover:shadow-md transition-all group">
            <h3 class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">Prochain cycle estimé</h3>
            {% if prediction %}
              <p class="text-3xl font-black text-primary tracking-tight">
                {{ prediction|date('d M Y') }}
              </p>
            {% else %}
              <p class="text-slate-400 font-bold">
                Données insuffisantes
              </p>
            {% endif %}
            <div class="mt-4 h-1 w-12 rounded-full bg-primary transition-all group-hover:w-20"></div>
          </div>

          <!-- Etat global (via IA) -->
          <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-7 hover:shadow-md transition-all group">
            <h3 class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">État global</h3>
            {% if aiAnalysis %}
              {% if aiAnalysis.est_regulier is same as(true) or aiAnalysis.est_regulier == 'true' %}
                <p class="text-2xl font-black text-slate-900">
                  <i class="fas fa-check-circle mr-2 text-primary"></i>Régulier
                </p>
              {% else %}
                <p class="text-2xl font-black text-primary">
                  <i class="fas fa-exclamation-triangle mr-2"></i>Irrégulier
                </p>
              {% endif %}
              {% if aiAnalysis.prediction_prochain %}
                <p class="text-xs text-slate-500 mt-2 font-medium bg-slate-50 px-3 py-1 rounded-full inline-block">{{ aiAnalysis.prediction_prochain }}</p>
              {% endif %}
            {% else %}
              <p class="text-slate-400 font-bold">
                Analyse en attente
              </p>
            {% endif %}
            <div class="mt-4 h-1 w-12 rounded-full bg-primary transition-all group-hover:w-20"></div>
          </div>

        </div>

        <!-- Analyse IA complète -->
        {% if aiAnalysis %}
        <div class="bg-white p-8 rounded-[2rem] border border-slate-200 border-l-[12px] border-l-primary shadow-xl relative overflow-hidden">
          <div class="absolute top-0 right-0 p-8 opacity-5">
              <i class="fas fa-brain text-8xl text-slate-900"></i>
          </div>
          <h2 class="text-2xl font-black text-slate-900 mb-4 flex items-center gap-3">
            <span class="bg-primary p-2 rounded-lg text-white"><i class="fas fa-sparkles text-sm"></i></span>
            Rapport IA Santé
          </h2>
          {% if aiAnalysis.resume %}
            <p class="text-slate-600 text-lg leading-relaxed mb-6 font-medium">{{ aiAnalysis.resume }}</p>
          {% endif %}
          
          {% if aiAnalysis.conseil is defined and aiAnalysis.conseil %}
            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100">
                <h3 class="text-xs font-black text-primary uppercase tracking-widest mb-2">Conseil Médical IA</h3>
                <p class="text-slate-700 font-medium">{{ aiAnalysis.conseil }}</p>
            </div>
          {% endif %}
        </div>
        {% endif %}

        <!-- Cycles irréguliers (détectés par IA) -->
        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-8">
          <h2 class="text-2xl font-black text-slate-900 mb-6 flex items-center gap-3">
            <i class="fas fa-history text-primary"></i>
            Anomalies détectées
          </h2>

          {% if irregular|length > 0 %}
            <div class="grid gap-4">
              {% for item in irregular %}
                <div class="border border-red-100 bg-red-50/50 p-6 rounded-2xl flex items-start gap-4">
                  <div class="bg-primary text-white p-3 rounded-xl shadow-sm">
                      <i class="fas fa-exclamation-circle"></i>
                  </div>
                  <div>
                    <p class="font-black text-primary text-lg">
                      Cycle anormal ({{ item.length }} jours)
                    </p>
                    <p class="text-slate-600 font-bold text-sm mt-1">
                      Du {{ item.cycle.dateDebutM|date('d M Y') }} au {{ item.cycleEnd|date('d M Y') }}
                    </p>
                    {% if item.raison %}
                      <p class="text-slate-500 text-sm mt-2 font-medium italic bg-white/50 px-3 py-1 rounded-lg inline-block border border-red-100">{{ item.raison }}</p>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="bg-slate-50 border border-slate-200 p-8 rounded-2xl flex items-center gap-6">
                <div class="bg-primary text-white p-4 rounded-2xl shadow-lg">
                    <i class="fas fa-check-double text-xl"></i>
                </div>
              <div>
                  <p class="text-slate-900 font-black text-xl">Régularité Optimale</p>
                  <p class="text-slate-600 font-medium">
                    {% if aiAnalysis %}
                        Aucun cycle irrégulier n'a été détecté dans votre historique récent.
                    {% else %}
                        {{ advice }}
                    {% endif %}
                  </p>
              </div>
            </div>
          {% endif %}

        </div>

       <!-- GRAPHIQUE CYCLES -->
        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-8">
          <h2 class="text-2xl font-black text-slate-900 mb-6 flex items-center gap-3">
            <i class="fas fa-chart-area text-primary"></i>
            Évolution Temporelle
          </h2>
          <div class="h-[400px]">
            <canvas id="cycleChart"></canvas>
          </div>
        </div>

      </div>
      
    </main>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
// Statistique animée de la moyenne
let target = {{ average }};
let count = 0;
let interval = setInterval(() => {
    if(target <= 0) {
        document.getElementById('averageCounter').innerText = "0";
        clearInterval(interval);
        return;
    }
    count++;
    document.getElementById('averageCounter').innerText = count;
    if(count >= target) clearInterval(interval);
}, 30);

// Graphique Chart.js
const ctx = document.getElementById('cycleChart').getContext('2d');
new Chart(ctx, {
    type: 'line',
    data: {
        labels: {{ labels|json_encode|raw }},
        datasets: [{
            label: 'Durée du cycle (jours)',
            data: {{ lengths|json_encode|raw }},
            borderColor: '#ef4444',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            tension: 0.4,
            fill: true,
            pointBackgroundColor: '#ef4444',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
            pointRadius: 6,
            pointHoverRadius: 8
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#1e293b',
                padding: 12,
                titleFont: { size: 14, weight: 'bold' }
            }
        },
        scales: {
            y: {
                beginAtZero: true,
                grid: { borderDash: [5, 5], color: '#f1f5f9' },
                ticks: { color: '#64748b', font: { weight: 'bold' } }
            },
            x: {
                grid: { display: false },
                ticks: { color: '#64748b', font: { weight: 'bold' } }
            }
        }
    }
});
</script>
{% endblock %}

{% block stylesheets %}
<style>
/* Responsive overrides */
@media (max-width: 768px) {
  .text-5xl { font-size: 3rem; }
}
</style>
{% endblock %}