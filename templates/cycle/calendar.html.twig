{% extends 'base.html.twig' %}

{% block stylesheets %}
<style>
/* SOSI Red Theme for FullCalendar */
.fc {
  --fc-border-color: #e2e8f0;
  --fc-today-bg-color: #fef2f2;
  --fc-page-bg-color: #ffffff;
  --fc-neutral-bg-color: #f8fafc;
  --fc-list-event-hover-bg-color: #f1f5f9;
  font-family: 'Inter', sans-serif;
}

.fc-toolbar-title { 
    color: #0f172a; 
    font-weight: 800; 
    font-size: 1.5rem !important;
    letter-spacing: -0.025em;
}

.fc-button {
  background-color: #ffffff !important;
  border: 1px solid #e2e8f0 !important;
  color: #475569 !important;
  font-weight: 600 !important;
  text-transform: capitalize !important;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
  padding: 8px 16px !important;
}
.fc-button:hover { 
    background-color: #f8fafc !important; 
    color: #0f172a !important;
    border-color: #cbd5e1 !important;
}
.fc-button-active {
    background-color: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
}

.fc-daygrid-day-number { 
    color: #64748b; 
    font-weight: 600; 
    padding: 8px !important;
}
.fc-day-today { background-color: #fef2f2 !important; }
.fc-day-today .fc-daygrid-day-number { color: #ef4444; }

/* Custom Event Styles - Red Palette */
.menstruation-event { 
    background-color: #ef4444 !important; 
    border: none !important;
    border-radius: 6px !important;
    padding: 2px 4px !important;
}
.follicular-event { background-color: #3b82f666 !important; border: none !important; }
.fertile-event { 
    background-color: #10b98199 !important; 
    border: none !important;
}
.ovulation-event { 
    background-color: #8b5cf6 !important; 
    border: 2px solid #ffffff !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border-radius: 9999px;
    width: 12px !important;
    height: 12px !important;
    margin: 4px auto !important;
}
.luteal-event { background-color: #eab30866 !important; border: none !important; }
.predicted-period { 
    background-color: #fef2f2 !important; 
    border: 2px dashed #fca5a5 !important; 
    color: #ef4444 !important;
    font-weight: bold;
}
</style>
{% endblock %}

{% block body %}
<div class="flex min-h-screen bg-slate-50/50">
  <div class="flex flex-1 flex-col">
    {% include 'components/top-nav.html.twig' %}
    <main class="flex-1 overflow-auto">
      <div class="mx-auto max-w-7xl space-y-6 p-4 lg:p-6">
        
        <!-- Header & Actions -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div>
            <h1 class="text-2xl font-bold text-slate-900">Suivi du Cycle Menstruel</h1>
            <p class="text-sm text-slate-500">Prévoyez vos phases avec une précision médicale</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a href="{{ path('cycle_new') }}" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 shadow-sm transition-all flex items-center gap-2 font-medium">
                <i class="fas fa-plus"></i> Ajouter un cycle
            </a>
            <a href="{{ path('cycle_analyse') }}" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90 shadow-sm transition-all flex items-center gap-2 font-medium">
                <i class="fas fa-microscope"></i> Analyse IA
            </a>
            <a href="{{ path('cycle_export_pdf') }}" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg hover:bg-slate-50 shadow-sm transition-all flex items-center gap-2 font-medium">
                <i class="fas fa-file-pdf text-primary"></i> Rapport PDF
            </a>
          </div>
        </div>

        <!-- Notifications & Alerts -->
        {% if stats.notifications is defined and stats.notifications|length > 0 %}
        <div class="space-y-2">
            {% for notif in stats.notifications %}
            <div class="flex items-center gap-3 p-4 rounded-xl border-l-4 shadow-sm transition-all
                {% if notif.type == 'warning' %} bg-red-50 border-primary text-primary
                {% elseif notif.type == 'info' %} bg-slate-50 border-slate-500 text-slate-700
                {% elseif notif.type == 'danger' %} bg-red-100 border-primary text-primary font-bold
                {% else %} bg-slate-50 border-slate-200 text-slate-600 {% endif %}">
                <i class="fas fa-bell"></i>
                <span class="text-sm">{{ notif.message }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Summary Dashboard -->
        {% if stats %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md border-l-4 border-l-primary">
                <h3 class="text-slate-500 text-xs font-bold uppercase tracking-wider">Phase Actuelle</h3>
                <p class="text-2xl font-black text-slate-900 mt-2">{{ stats.current_phase }}</p>
                <div class="mt-2 h-1 w-12 rounded-full bg-primary/20"></div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md border-l-4 border-l-slate-400">
                <div class="flex items-center justify-between">
                    <h3 class="text-slate-500 text-xs font-bold uppercase tracking-wider">Prochaines Règles</h3>
                    {% if stats.google_period_url != '#' %}
                    <a href="{{ stats.google_period_url }}" target="_blank" class="text-slate-400 hover:text-primary transition-colors" title="Synchroniser avec Google Calendar">
                        <i class="fab fa-google"></i>
                    </a>
                    {% endif %}
                </div>
                <p class="text-xl font-bold text-slate-900 mt-2">{{ stats.next_period }}</p>
                <p class="text-[10px] text-slate-400 font-medium uppercase mt-1">Estimation basée sur l'historique</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md border-l-4 border-l-primary/60">
                <div class="flex items-center justify-between">
                    <h3 class="text-slate-500 text-xs font-bold uppercase tracking-wider">Ovulation</h3>
                    {% if stats.google_ovulation_url != '#' %}
                    <a href="{{ stats.google_ovulation_url }}" target="_blank" class="text-slate-400 hover:text-violet-500 transition-colors" title="Synchroniser avec Google Calendar">
                        <i class="fab fa-google"></i>
                    </a>
                    {% endif %}
                </div>
                <p class="text-xl font-bold text-slate-900 mt-2">{{ stats.ovulation }}</p>
                <p class="text-[10px] text-primary font-bold uppercase mt-1">Pic de fertilité</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md border-l-4 border-l-slate-800">
                <h3 class="text-slate-500 text-xs font-bold uppercase tracking-wider">Durée Moyenne</h3>
                <p class="text-2xl font-black text-slate-900 mt-2">{{ stats.avg_length }} <span class="text-sm font-normal text-slate-400">jours</span></p>
                <a href="{{ path('cycle_stats') }}" class="mt-2 inline-block text-[10px] font-bold text-primary uppercase hover:underline">Voir les stats détaillées →</a>
            </div>
        </div>
        {% endif %}

        <!-- Legend -->
        <div class="flex flex-wrap gap-6 text-xs bg-white p-4 rounded-xl border border-slate-200 shadow-sm justify-center">
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-primary shadow-sm"></span> <span class="font-medium text-slate-600 uppercase tracking-tighter">Menstruation</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500/40"></span> <span class="font-medium text-slate-600 uppercase tracking-tighter">Folliculaire</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-emerald-500/60"></span> <span class="font-medium text-slate-600 uppercase tracking-tighter">Fertile</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-violet-500 shadow-sm"></span> <span class="font-medium text-slate-600 uppercase tracking-tighter">Ovulation</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-amber-500/40"></span> <span class="font-medium text-slate-600 uppercase tracking-tighter">Lutéale</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full border-2 border-dashed border-primary/40"></span> <span class="font-medium text-slate-600 uppercase tracking-tighter">Prévision</span></div>
        </div>

        <div id="calendar-wrapper" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xl overflow-hidden">
            <div id="calendar"></div>
        </div>

        <!-- Hidden Action Buttons for JS -->
        <div class="hidden">
            <button id="btn-edit" disabled></button>
            <button id="btn-delete" disabled></button>
        </div>

      </div>
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const calendarEl = document.getElementById('calendar');
    const events = {{ calendarEvents|raw }};

    const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,dayGridYear'
        },
        events: events,
        editable: false, // Set to true if you want drag & drop (requires backend update)
        selectable: true,
        eventClick: function(info) {
            // Only allow interaction with real menstruation events
            if (info.event.extendedProps.type === 'menstruation') {
                if (confirm('Voulez-vous modifier ce cycle ?')) {
                    window.location.href = `/cycle/${info.event.id}/edit`;
                }
            }
        },
        select: function(info) {
            if (confirm('Ajouter un nouveau cycle à cette date ?')) {
                // Redirect to new with start date pre-filled (requires updating controller to accept query param)
                window.location.href = `{{ path('cycle_new') }}?start=${info.startStr}`;
            }
        },
        eventDidMount: function(info) {
            // Tooltip logic
            let tooltip = document.createElement('div');
            tooltip.className = 'fc-event-tooltip';
            tooltip.innerHTML = info.event.title;
            
            info.el.addEventListener('mouseenter', () => {
                document.body.appendChild(tooltip);
                const rect = info.el.getBoundingClientRect();
                tooltip.style.left = rect.left + (rect.width / 2) + 'px';
                tooltip.style.top = rect.top + 'px';
            });
            
            info.el.addEventListener('mouseleave', () => {
                if (document.body.contains(tooltip)) {
                    document.body.removeChild(tooltip);
                }
            });
        }
    });

    calendar.render();
});
</script>
{% endblock %}
