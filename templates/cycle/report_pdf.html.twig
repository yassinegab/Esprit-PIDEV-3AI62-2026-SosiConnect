<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport de Santé — Suivi de Cycle</title>
    <style>
        body { font-family: 'Helvetica', sans-serif; color: #1e293b; line-height: 1.5; }
        .header { text-align: center; border-bottom: 2px solid #ef4444; padding-bottom: 20px; margin-bottom: 30px; }
        .logo { color: #ef4444; font-size: 24px; font-weight: bold; }
        .title { font-size: 20px; margin-top: 10px; color: #64748b; }
        .stats-grid { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .stats-grid td { padding: 15px; border: 1px solid #e2e8f0; width: 33.33%; }
        .label { font-size: 10px; text-transform: uppercase; color: #64748b; font-weight: bold; }
        .value { font-size: 18px; font-weight: bold; color: #0f172a; margin-top: 5px; }
        .table { width: 100%; border-collapse: collapse; }
        .table th { background-color: #f8fafc; text-align: left; padding: 10px; border-bottom: 2px solid #e2e8f0; font-size: 12px; }
        .table td { padding: 10px; border-bottom: 1px solid #f1f5f9; font-size: 12px; }
        .footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 10px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 10px; }
        .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; }
        .badge-red { background-color: #fef2f2; color: #ef4444; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">SOSI HEALTHCARE</div>
        <div class="title">Rapport de Suivi Menstruel</div>
        <div style="font-size: 12px; color: #94a3b8; margin-top: 5px;">Généré le {{ "now"|date("d/m/Y H:i") }} pour {{ user.prenom }} {{ user.nom }}</div>
    </div>

    <table class="stats-grid">
        <tr>
            <td>
                <div class="label">Total Cycles</div>
                <div class="value">{{ stats.total }}</div>
            </td>
            <td>
                <div class="label">Moyenne Cycle</div>
                <div class="value">{{ stats.avg_cycle }} j</div>
            </td>
            <td>
                <div class="label">Moyenne Règles</div>
                <div class="value">{{ stats.avg_period }} j</div>
            </td>
        </tr>
        <tr>
            <td>
                <div class="label">Régularité</div>
                <div class="value">{{ stats.regularity }}%</div>
            </td>
            <td>
                <div class="label">Cycle plus court</div>
                <div class="value">{{ stats.shortest }} j</div>
            </td>
            <td>
                <div class="label">Cycle plus long</div>
                <div class="value">{{ stats.longest }} j</div>
            </td>
        </tr>
    </table>

    <h3>Historique des cycles</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Début</th>
                <th>Fin</th>
                <th>Durée</th>
                <th>Symptômes</th>
            </tr>
        </thead>
        <tbody>
            {% for cycle in cycles %}
                <tr>
                    <td>{{ cycle.dateDebutM|date('d/m/Y') }}</td>
                    <td>{{ cycle.dateFinM|date('d/m/Y') }}</td>
                    <td>{{ cycle.dateDebutM.diff(cycle.dateFinM).days + 1 }} j</td>
                    <td>
                        {% if cycle.symptomes|length > 0 %}
                            {% for s in cycle.symptomes %}
                                <span class="badge badge-red">{{ s.type }} ({{ s.intensite }})</span>
                            {% endfor %}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Document confidentiel — SOSI Healthcare. Ce rapport ne remplace pas un avis médical professionnel.
    </div>
</body>
</html>
