{% extends 'base.html.twig' %}

{% block body %}
<div class="flex min-h-screen bg-background">

  <div class="flex flex-1 flex-col">

    {# Top Navigation #}
    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 overflow-auto">
      <div class="mx-auto max-w-7xl space-y-6 p-4 lg:p-6">
        
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Statistiques de santé</h1>
                <p class="text-sm text-gray-500">Analyse détaillée de vos cycles menstruels</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="{{ path('cycle_export_pdf') }}" class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white shadow-sm transition-all hover:bg-primary/90">
                    <i class="fas fa-file-pdf"></i>
                    Télécharger le rapport
                </a>
                <a href="{{ path('cycle_index') }}" class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition-all hover:bg-gray-50">
                    <i class="fas fa-arrow-left text-primary"></i>
                    Retour
                </a>
            </div>
        </div>

        {# Stats Grid #}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-primary">
                    <i class="fas fa-redo text-lg"></i>
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Total Cycles</p>
                <p class="mt-1 text-2xl font-bold text-gray-900">{{ stats.total }}</p>
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-primary">
                    <i class="fas fa-heartbeat text-lg"></i>
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Moyenne Cycle</p>
                <p class="mt-1 text-2xl font-bold text-gray-900">{{ stats.avg_cycle }} <span class="text-sm font-normal text-gray-400">j</span></p>
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-primary">
                    <i class="fas fa-tint text-lg"></i>
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Moyenne Règles</p>
                <p class="mt-1 text-2xl font-bold text-gray-900">{{ stats.avg_period }} <span class="text-sm font-normal text-gray-400">j</span></p>
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-primary">
                    <i class="fas fa-check-circle text-lg"></i>
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Régularité</p>
                <p class="mt-1 text-2xl font-bold {{ stats.regularity < 70 ? 'text-orange-600' : 'text-gray-900' }}">
                    {{ stats.regularity }}%
                </p>
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-primary">
                    <i class="fas fa-compress-alt text-lg"></i>
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Plus Court</p>
                <p class="mt-1 text-2xl font-bold text-gray-900">{{ stats.shortest }} <span class="text-sm font-normal text-gray-400">j</span></p>
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
                <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-red-50 text-primary">
                    <i class="fas fa-expand-alt text-lg"></i>
                </div>
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">Plus Long</p>
                <p class="mt-1 text-2xl font-bold text-gray-900">{{ stats.longest }} <span class="text-sm font-normal text-gray-400">j</span></p>
            </div>
        </div>

        {# Chart #}
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="mb-6 flex items-center justify-between">
                <h3 class="text-lg font-bold text-gray-900">Historique des durées de règles</h3>
                <div class="flex items-center gap-2 text-xs font-medium text-gray-500">
                    <span class="inline-block h-3 w-3 rounded-full bg-primary/20 border border-primary/40"></span>
                    Durée (jours)
                </div>
            </div>
            <div class="h-[400px]">
                <canvas id="cycleChart"></canvas>
            </div>
        </div>

      </div>
    </main>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('cycleChart').getContext('2d');
        const labels = {{ chartLabels|raw }};
        const data = {{ chartData|raw }};

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Durée des règles',
                    data: data,
                    backgroundColor: 'rgba(239, 68, 68, 0.1)',
                    borderColor: '#ef4444',
                    borderWidth: 3,
                    pointBackgroundColor: '#ef4444',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 6,
                    pointHoverRadius: 8,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        padding: 12,
                        titleFont: { size: 14, weight: 'bold' },
                        callbacks: {
                            label: function(context) {
                                return ` ${context.parsed.y} jours de règles`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [5, 5], color: '#f1f5f9' },
                        ticks: { stepSize: 1, color: '#64748b' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b' }
                    }
                }
            }
        });
    });
</script>
{% endblock %}