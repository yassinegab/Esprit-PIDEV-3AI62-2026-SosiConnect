{% extends 'layout/front-layout.html.twig' %}

{% block title %}Aide & Don{% endblock %}

{% block content %}

<div class="space-y-8 animate-page-enter">

    {# ── Page Header ── #}
    <div>
        <h1 class="page-title">🩸 Aide & Don</h1>
        <p class="page-subtitle mt-1">Centre de gestion des dons, donneurs et demandes</p>
    </div>

    {# ── Action Cards Grid ── #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

        <a href="{{ path('donneur_inscription') }}"
           class="card group flex flex-col items-center gap-4 text-center hover:-translate-y-1 transition-transform duration-200 cursor-pointer">
            <div class="stat-icon w-14 h-14 text-2xl group-hover:scale-110 transition-transform duration-200">
                🙋‍♂️
            </div>
            <div>
                <h3 class="font-bold text-foreground">Devenir donneur</h3>
                <p class="text-sm text-muted-foreground mt-1">Inscription et informations personnelles</p>
            </div>
            <span class="badge-muted mt-auto">S'inscrire →</span>
        </a>

        <a href="{{ path('don_new') }}"
           class="card group flex flex-col items-center gap-4 text-center hover:-translate-y-1 transition-transform duration-200 cursor-pointer border-primary/30 hover:border-primary/60">
            <div class="stat-icon w-14 h-14 text-2xl group-hover:scale-110 transition-transform duration-200">
                🩸
            </div>
            <div>
                <h3 class="font-bold text-foreground">Nouveau don</h3>
                <p class="text-sm text-muted-foreground mt-1">Déclarer un don de sang ou d'organe</p>
            </div>
            <span class="badge-primary mt-auto">Déclarer →</span>
        </a>

        <a href="{{ path('demande_don') }}"
           class="card group flex flex-col items-center gap-4 text-center hover:-translate-y-1 transition-transform duration-200 cursor-pointer">
            <div class="stat-icon w-14 h-14 text-2xl group-hover:scale-110 transition-transform duration-200">
                📄
            </div>
            <div>
                <h3 class="font-bold text-foreground">Demande de don</h3>
                <p class="text-sm text-muted-foreground mt-1">Créer une demande urgente ou planifiée</p>
            </div>
            <span class="badge-muted mt-auto">Faire une demande →</span>
        </a>

        <a href="{{ path('contact_urgence_index') }}"
           class="card group flex flex-col items-center gap-4 text-center hover:-translate-y-1 transition-transform duration-200 cursor-pointer">
            <div class="stat-icon w-14 h-14 text-2xl group-hover:scale-110 transition-transform duration-200 bg-red-100 text-red-600">
                🚨
            </div>
            <div>
                <h3 class="font-bold text-foreground">Contacts d'urgence</h3>
                <p class="text-sm text-muted-foreground mt-1">Consulter la liste des contacts d'urgence</p>
            </div>
            <span class="badge-danger mt-auto">Voir contacts →</span>
        </a>

    </div>

</div>

{% endblock %}
