{% extends 'layout/front-layout.html.twig' %}

{% block title %}FAQ - Centre d'Aide — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Sidebar active category ────────────────────────────────── */
.cat-active {
    background: var(--primary) !important;
    color: white !important;
}
.cat-item:hover:not(.cat-active) { background: var(--muted); color: var(--foreground); }
</style>
{% endblock %}

{% block content %}
<div class="space-y-6 animate-fadeIn">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
            <h1 class="page-title"><i class="fas fa-question-circle text-primary me-2"></i> Foire Aux Questions</h1>
        </div>
        <a href="{{ path('aide') }}" class="btn-secondary" style="font-size:.85rem;">
            ← Retour
        </a>
    </div>

    <div class="card" style="padding:1rem;">
        <form method="get" class="flex gap-4">
            <div class="flex-1 relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2" style="color:var(--muted-fg);">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" name="search" value="{{ search }}"
                       placeholder="Rechercher dans la FAQ..."
                       class="input-field" style="padding-left:2.75rem;">
            </div>
            <button type="submit" class="btn-primary" style="padding-left:1.5rem; padding-right:1.5rem;">
                Rechercher
            </button>
            {% if search %}
            <a href="{{ path('aide_faq') }}" class="btn-secondary flex items-center justify-center" style="width:3rem; padding:0;">
                <i class="fas fa-times"></i>
            </a>
            {% endif %}
        </form>
    </div>

    <div class="flex gap-2 flex-wrap">
        <a href="{{ path('aide_faq') }}" 
           class="px-4 py-2 rounded-full text-sm font-medium transition-colors 
                  {{ not currentCategory ? 'cat-active shadow-sm' : 'bg-white text-muted-fg hover:bg-muted border border-border' }}"
           style="text-decoration:none;">
            Toutes
        </a>
        {% for category in categories %}
        <a href="{{ path('aide_faq', {category: category}) }}" 
           class="px-4 py-2 rounded-full text-sm font-medium transition-colors 
                  {{ currentCategory == category ? 'cat-active shadow-sm' : 'bg-white text-muted-fg hover:bg-muted border border-border' }}"
           style="text-decoration:none;">
            {{ category|title }}
        </a>
        {% endfor %}
    </div>

    <div class="space-y-4">
        {% for faq in faqs %}
        <div class="card" style="padding:0; overflow:hidden;" x-data="{ open: false }">
            <button @click="open = !open; if(open) fetch('{{ path('aide_faq_view', {id: faq.id}) }}')"
                    class="w-full p-6 text-left flex justify-between items-center hover:bg-muted transition-colors border-none"
                    style="background:transparent; cursor:pointer;">
                <div class="flex items-start gap-4">
                    <div class="empty-state-icon" style="width:2.5rem; height:2.5rem; font-size:1rem; flex-shrink:0;">
                        <i class="fas fa-question"></i>
                    </div>
                    <div>
                        <h3 class="font-bold" style="color:var(--foreground); font-size:1.05rem;">{{ faq.question }}</h3>
                        <div class="flex items-center gap-4 mt-2" style="font-size:.75rem; color:var(--muted-fg);">
                            <span><i class="fas fa-folder me-1"></i> {{ faq.category }}</span>
                            <span><i class="fas fa-eye me-1"></i> {{ faq.viewCount }} vues</span>
                            <span><i class="fas fa-thumbs-up me-1"></i> {{ faq.helpfulCount }} utiles</span>
                        </div>
                    </div>
                </div>
                <span class="transition-transform" :style="open ? 'transform:rotate(180deg); color:var(--primary);' : 'color:var(--muted-fg);'">
                    <i class="fas fa-chevron-down"></i>
                </span>
            </button>
            
            <div x-show="open" x-transition.opacity class="border-t border-border">
                <div style="padding:1.5rem; background:rgba(244,244,245,.3);">
                    <p class="leading-relaxed" style="color:var(--muted-fg);">{{ faq.answer|nl2br }}</p>
                    
                    <div class="mt-6 pt-4 border-t border-border flex items-center justify-between">
                        <span style="font-size:.85rem; color:var(--muted-fg);">Cette réponse vous a-t-elle aidé ?</span>
                        <div class="flex gap-2">
                            <button @click="fetch('{{ path('aide_faq_helpful', {id: faq.id}) }}', {method: 'POST'})"
                                    class="px-4 py-2 bg-green-50 text-green-700 rounded-lg hover:bg-green-100 transition text-sm font-semibold border border-green-100 flex items-center gap-2">
                                <i class="fas fa-thumbs-up"></i> Oui
                            </button>
                            <button class="px-4 py-2 bg-muted text-muted-fg rounded-lg hover:bg-gray-200 transition text-sm font-semibold border border-border flex items-center gap-2">
                                <i class="fas fa-thumbs-down"></i> Non
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="card text-center" style="padding:4rem 1rem;">
            <div class="empty-state-icon mx-auto mb-4" style="width:4rem; height:4rem; font-size:1.5rem;">
                <i class="fas fa-search"></i>
            </div>
            <h3 class="font-bold" style="font-size:1.15rem; color:var(--foreground);">Aucune question trouvée</h3>
            <p style="color:var(--muted-fg); margin-top:.5rem; font-size:.9rem;">
                {% if search %}
                    Aucun résultat pour "{{ search }}"
                {% else %}
                    Aucune question disponible dans cette catégorie
                {% endif %}
            </p>
            <div class="mt-8">
                <a href="{{ path('aide_support_new') }}" class="btn-primary">
                    <i class="fas fa-ticket-alt me-1"></i> Créer un ticket de support
                </a>
            </div>
        </div>
        {% endfor %}
    </div>

    {% if faqs|length > 0 %}
    <div class="rounded-2xl p-6 shadow-sm border border-red-100" style="background:rgba(239,68,68,.04);">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
                <h3 class="font-bold" style="color:var(--foreground);">Vous n'avez pas trouvé votre réponse ?</h3>
                <p style="color:var(--muted-fg); font-size:.85rem; margin-top:.25rem;">Notre équipe de support est là pour vous aider.</p>
            </div>
            <a href="{{ path('aide_support_new') }}" class="btn-primary shadow-lg" style="background:var(--primary);">
                <i class="fas fa-headset me-1"></i> Contacter le support
            </a>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
