{% extends 'layout/front-layout.html.twig' %}

{% block title %}Centre d'Aide — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.hero-gradient-aide {
    background: linear-gradient(135deg, #fee2e2 0%, #fecaca 50%, #fca5a5 100%);
}
.card-hover {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
}
.card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
}
</style>
{% endblock %}

{% block content %}
<div class="space-y-8 animate-fadeIn">
    {# ── Hero Section ────────────────────────────────────────── #}
    <div class="hero-gradient-aide rounded-2xl p-8 relative overflow-hidden shadow-sm">
        <div class="absolute top-0 right-0 w-64 h-64 bg-red-400 rounded-full opacity-10 -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-red-500 rounded-full opacity-10 translate-y-1/2 -translate-x-1/2"></div>
        
        <div class="relative z-10">
            <h1 class="text-4xl font-bold mb-2" style="color:var(--foreground); font-family: 'Poppins', sans-serif;">
                <i class="fas fa-hand-holding-medical text-primary me-2"></i> Centre d'Aide & Assistance
            </h1>
            <p class="text-lg max-w-2xl" style="color:var(--muted-fg);">
                Besoin d'aide ? Gérez vos urgences, contacts et trouvez les réponses à vos questions.
            </p>
        </div>
    </div>

    {# ── Main Navigation Grid ────────────────────────────────── #}
    <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        <a href="{{ path('urgence_index') }}" class="card card-hover border-2 border-red-200 group">
            <div class="w-14 h-14 bg-red-100 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:bg-red-200 transition group-hover:scale-110">
                <i class="fas fa-exclamation-triangle text-red-600"></i>
            </div>
            <h3 class="font-bold text-lg mb-1" style="color:var(--foreground);">Déclencher Urgence</h3>
            <p style="color:var(--muted-fg); font-size:.85rem;">Envoyer position aux contacts</p>
        </a>

        <a href="{{ path('contact_urgence_index') }}" class="card card-hover group">
            <div class="w-14 h-14 bg-orange-100 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:bg-orange-200 transition group-hover:scale-110">
                <i class="fas fa-phone-alt text-orange-600"></i>
            </div>
            <h3 class="font-bold text-lg mb-1" style="color:var(--foreground);">Contacts d'Urgence</h3>
            <p style="color:var(--muted-fg); font-size:.85rem;">Gérer vos contacts</p>
        </a>

        <a href="{{ path('aide_faq') }}" class="card card-hover group">
            <div class="w-14 h-14 bg-purple-100 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:bg-purple-200 transition group-hover:scale-110">
                <i class="fas fa-question text-purple-600"></i>
            </div>
            <h3 class="font-bold text-lg mb-1" style="color:var(--foreground);">FAQ</h3>
            <p style="color:var(--muted-fg); font-size:.85rem;">Questions fréquentes</p>
        </a>

        <a href="{{ path('aide_support_new') }}" class="card card-hover group">
            <div class="w-14 h-14 bg-red-100 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:bg-red-200 transition group-hover:scale-110">
                <i class="fas fa-ticket-alt text-primary"></i>
            </div>
            <h3 class="font-bold text-lg mb-1" style="color:var(--foreground);">Support</h3>
            <p style="color:var(--muted-fg); font-size:.85rem;">Créer un ticket</p>
        </a>

        <a href="{{ path('aide_tutorials') }}" class="card card-hover group">
            <div class="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-2xl mb-4 group-hover:bg-pink-200 transition group-hover:scale-110">
                <i class="fas fa-video text-pink-600"></i>
            </div>
            <h3 class="font-bold text-lg mb-1" style="color:var(--foreground);">Tutoriels</h3>
            <p style="color:var(--muted-fg); font-size:.85rem;">Guides vidéo</p>
        </a>
    </div>

    {# ── Medical Map Banner ────────────────────────────────── #}
    <a href="{{ path('aide_map') }}" 
       class="block rounded-2xl p-6 text-white hover:shadow-xl transition"
       style="background: linear-gradient(to right, #10b981, #059669); text-decoration:none;">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center text-2xl">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold">Carte Médicale</h3>
                    <p style="color:rgba(255,255,255,.85);">Trouvez les médecins, pharmacies et hôpitaux près de vous</p>
                </div>
            </div>
            <span class="text-3xl"><i class="fas fa-arrow-right"></i></span>
        </div>
    </a>

    {# ── Emergency Quick Action ────────────────────────────── #}
    <div class="rounded-2xl p-8 text-white shadow-lg"
         style="background: linear-gradient(to right, #ef4444, #f97316);">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
                <h3 class="text-2xl font-bold mb-2">🚨 Urgence - Envoyer votre position</h3>
                <p style="color:rgba(255,255,255,.85);">En cas d'urgence, envoyez votre localisation GPS à tous vos contacts d'urgence en un clic.</p>
            </div>
            <a href="{{ path('urgence_index') }}" 
               class="bg-white px-8 py-4 rounded-xl font-bold hover:bg-gray-100 transition shadow-lg flex items-center gap-2"
               style="color:#ef4444; text-decoration:none;">
                <span class="text-2xl">🆘</span> Déclencher Urgence
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {# ── Popular FAQs ──────────────────────────────────── #}
        <div class="card">
            <div class="flex justify-between items-center mb-4">
                <h3 class="section-title">🔥 Questions Populaires</h3>
                <a href="{{ path('aide_faq') }}" class="text-primary text-sm font-medium hover:underline" style="text-decoration:none;">
                    Voir tout →
                </a>
            </div>
            <div class="space-y-3">
                {% for faq in popularFaqs %}
                <a href="{{ path('aide_faq') }}" class="block p-4 bg-muted rounded-xl hover:bg-gray-200 transition" style="text-decoration:none;">
                    <div class="flex items-start gap-3">
                        <span class="text-primary mt-1"><i class="fas fa-question-circle"></i></span>
                        <div>
                            <p class="font-medium" style="color:var(--foreground);">{{ faq.question }}</p>
                            <p style="font-size:.75rem;color:var(--muted-fg); margin-top:.25rem;">{{ faq.viewCount }} vues • {{ faq.helpfulCount }} utiles</p>
                        </div>
                    </div>
                </a>
                {% else %}
                <div class="text-center py-8" style="color:var(--muted-fg);">
                    <i class="fas fa-inbox text-3xl opacity-20 mb-2"></i>
                    <p>Aucune FAQ disponible</p>
                </div>
                {% endfor %}
            </div>
        </div>

        {# ── Contact Info ───────────────────────────────────── #}
        <div class="card" style="background:rgba(239,68,68,.02); border-color:rgba(239,68,68,.1);">
            <h3 class="section-title mb-4">💬 Contactez-nous</h3>
            <p style="color:var(--muted-fg); margin-bottom:1.5rem;">
                Vous ne trouvez pas la réponse à votre question ? Notre équipe est là pour vous aider.
            </p>
            
            <div class="space-y-4">
                <a href="{{ path('aide_support_new') }}" class="flex items-center gap-4 p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition" style="text-decoration:none; border:1px solid var(--border);">
                    <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center text-xl text-primary">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <div>
                        <p class="font-medium" style="color:var(--foreground);">Créer un ticket</p>
                        <p style="font-size:.75rem;color:var(--muted-fg);">Réponse sous 24h</p>
                    </div>
                </a>

                <a href="mailto:support@wellnessconnect.com" class="flex items-center gap-4 p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition" style="text-decoration:none; border:1px solid var(--border);">
                    <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center text-xl text-green-600">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <p class="font-medium" style="color:var(--foreground);">Email</p>
                        <p style="font-size:.75rem;color:var(--muted-fg);">support@wellnessconnect.com</p>
                    </div>
                </a>

                <a href="tel:+21612345678" class="flex items-center gap-4 p-4 bg-white rounded-xl shadow-sm hover:shadow-md transition" style="text-decoration:none; border:1px solid var(--border);">
                    <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center text-xl text-purple-600">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div>
                        <p class="font-medium" style="color:var(--foreground);">Téléphone</p>
                        <p style="font-size:.75rem;color:var(--muted-fg);">+216 12 345 678</p>
                    </div>
                </a>
            </div>
        </div>
    </div>

    {# ── Video Tutorials Section ──────────────────────────── #}
    <div class="card">
        <div class="flex justify-between items-center mb-4">
            <h3 class="section-title">🎬 Tutoriels Vidéo</h3>
            <a href="{{ path('aide_tutorials') }}" class="text-primary text-sm font-medium hover:underline" style="text-decoration:none;">
                Voir tous →
            </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="{{ path('aide_tutorials') }}" class="p-4 bg-muted rounded-xl hover:shadow-md transition group border border-border" style="text-decoration:none;">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center text-2xl group-hover:scale-110 transition text-red-600">
                        <i class="fas fa-tint"></i>
                    </div>
                    <div>
                        <p class="font-medium" style="color:var(--foreground);">Don de Sang</p>
                        <p style="font-size:.75rem;color:var(--muted-fg);">Guide pour donneurs</p>
                    </div>
                </div>
                <p style="font-size:.85rem;color:var(--muted-fg);">Apprenez les étapes pour donner votre sang en toute sécurité.</p>
            </a>
            <a href="{{ path('aide_tutorials') }}" class="p-4 bg-muted rounded-xl hover:shadow-md transition group border border-border" style="text-decoration:none;">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center text-2xl group-hover:scale-110 transition text-purple-600">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <div>
                        <p class="font-medium" style="color:var(--foreground);">Don d'Organe</p>
                        <p style="font-size:.75rem;color:var(--muted-fg);">Informations</p>
                    </div>
                </div>
                <p style="font-size:.85rem;color:var(--muted-fg);">Tout savoir sur le don d'organes et son importance.</p>
            </a>
            <a href="{{ path('aide_tutorials') }}" class="p-4 bg-muted rounded-xl hover:shadow-md transition group border border-border" style="text-decoration:none;">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center text-2xl group-hover:scale-110 transition text-green-600">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <div>
                        <p class="font-medium" style="color:var(--foreground);">Carte Médicale</p>
                        <p style="font-size:.75rem;color:var(--muted-fg);">Comment utiliser</p>
                    </div>
                </div>
                <p style="font-size:.85rem;color:var(--muted-fg);">Trouvez facilement les établissements de santé proches.</p>
            </a>
        </div>
    </div>

    {# ── Browse by Category ────────────────────────────────── #}
    <div class="card">
        <h3 class="section-title mb-4">📁 Parcourir par Catégorie</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {% for category in categories %}
            <a href="{{ path('aide_faq', {category: category}) }}" class="p-4 bg-muted rounded-xl hover:bg-red-50 hover:border-red-200 border border-transparent transition text-center" style="text-decoration:none;">
                <div class="text-2xl mb-2">
                    {% if category == 'don' %}<i class="fas fa-tint text-red-500"></i>
                    {% elseif category == 'aide' %}<i class="fas fa-hands-helping text-primary"></i>
                    {% elseif category == 'urgence' %}<i class="fas fa-exclamation-circle text-red-600"></i>
                    {% elseif category == 'compte' %}<i class="fas fa-user-circle text-gray-600"></i>
                    {% else %}<i class="fas fa-clipboard-list text-gray-500"></i>{% endif %}
                </div>
                <p class="font-medium" style="color:var(--foreground);">{{ category|title }}</p>
            </a>
            {% else %}
            <div class="col-span-4 text-center py-4" style="color:var(--muted-fg);">
                Aucune catégorie disponible
            </div>
            {% endfor %}
        </div>
    </div>

    {# ── Share Banner ──────────────────────────────────────── #}
    <div class="rounded-2xl p-8 text-white shadow-lg"
         style="background: linear-gradient(to right, #ef4444, #dc2626);">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
                <h3 class="text-2xl font-bold mb-2">📤 Partagez Wellness Connect</h3>
                <p style="color:rgba(255,255,255,.85);">Aidez vos amis à découvrir nos services de santé</p>
            </div>
            <div class="flex gap-3">
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ app.request.uri }}" target="_blank"
                   class="w-12 h-12 bg-white/20 hover:bg-white/30 rounded-xl flex items-center justify-center text-xl transition">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="https://twitter.com/intent/tweet?text=Découvrez%20Wellness%20Connect&url={{ app.request.uri }}" target="_blank"
                   class="w-12 h-12 bg-white/20 hover:bg-white/30 rounded-xl flex items-center justify-center text-xl transition">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="https://wa.me/?text=Découvrez%20Wellness%20Connect%20{{ app.request.uri }}" target="_blank"
                   class="w-12 h-12 bg-white/20 hover:bg-white/30 rounded-xl flex items-center justify-center text-xl transition">
                    <i class="fab fa-whatsapp"></i>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
