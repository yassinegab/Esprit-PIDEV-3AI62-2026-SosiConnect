{% extends 'layout/front-layout.html.twig' %}

{% block title %}Carte Médicale — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
#map {
    height: calc(100vh - 220px);
    min-height: 520px;
    border-radius: 1.25rem;
    z-index: 1;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
}
.leaflet-popup-content-wrapper {
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border: 1px solid var(--border);
}
.leaflet-popup-content {
    margin: 15px;
}
.category-btn {
    transition: all 0.2s ease;
}
.category-btn.active {
    background: var(--primary) !important;
    color: white !important;
    transform: scale(1.05);
}
.lieu-card {
    transition: all 0.2s ease;
    border-left: 4px solid transparent;
}
.lieu-card:hover {
    background: var(--muted);
}
.lieu-card.active {
    background: rgba(239,68,68,0.05);
    border-left-color: var(--primary);
}
.star-rating {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
}
.star-rating input {
    display: none;
}
.star-rating label {
    cursor: pointer;
    font-size: 1.5rem;
    color: var(--muted-fg);
    opacity: 0.3;
    transition: all 0.2s;
}
.star-rating label:hover,
.star-rating label:hover ~ label,
.star-rating input:checked ~ label {
    color: #fbbf24;
    opacity: 1;
}
.review-modal {
    backdrop-filter: blur(8px);
    background: rgba(0,0,0,0.4);
}
</style>
{% endblock %}

{% block content %}
<div class="space-y-6 animate-fadeIn" x-data="mapApp()">
    {# ── Header ────────────────────────────────────────────── #}
    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
        <div>
            <h1 class="page-title">
                <i class="fas fa-map-marked-alt text-primary me-2"></i> Carte Médicale
            </h1>
            <p class="page-subtitle">Trouvez les médecins, pharmacies et hôpitaux près de vous</p>
        </div>
        <div class="flex items-center gap-4 text-sm bg-white p-3 rounded-xl border border-border shadow-sm">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></span>
                <span style="color:var(--muted-fg);" x-text="userLocation ? 'Position détectée' : 'Tunis (défaut)'"></span>
            </div>
            <button @click="getUserLocation()" class="font-bold text-primary hover:underline flex items-center gap-1" style="background:none; border:none; cursor:pointer;">
                <i class="fas fa-location-arrow"></i> Me localiser
            </button>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
        {# ── Sidebar ─────────────────────────────────────────── #}
        <div class="w-full lg:w-80 flex-shrink-0 space-y-4">
            {# Search #}
            <div class="card" style="padding:1rem;">
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2" style="color:var(--muted-fg);">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" 
                           x-model="searchQuery"
                           @input="filterLieux()"
                           placeholder="Rechercher..."
                           class="input-field" style="padding-left:2.5rem;">
                </div>
            </div>

            {# Categories #}
            <div class="card" style="padding:1.25rem;">
                <h3 class="section-title mb-3">📁 Catégories</h3>
                <div class="flex flex-wrap gap-2">
                    <button @click="toggleCategory('')" 
                            :class="activeCategory === '' ? 'active' : ''"
                            class="category-btn btn-secondary py-1.5 px-3 text-xs">
                        Tous
                    </button>
                    <template x-for="cat in categories" :key="cat">
                        <button @click="toggleCategory(cat)"
                                :class="activeCategory === cat ? 'active' : ''"
                                class="category-btn btn-secondary py-1.5 px-3 text-xs flex items-center gap-1.5">
                            <span x-text="getCategoryIcon(cat)"></span>
                            <span x-text="cat"></span>
                        </button>
                    </template>
                </div>
            </div>

            {# List of Places #}
            <div class="card" style="padding:0; overflow:hidden;">
                <div class="p-4 border-b border-border flex justify-between items-center bg-muted/30">
                    <h3 class="font-bold text-sm" style="color:var(--foreground);">📍 Lieux trouvés</h3>
                    <span style="font-size:.7rem; color:var(--muted-fg);" x-text="filteredLieux.length + ' résultat(s)'"></span>
                </div>
                <div class="max-h-[400px] overflow-y-auto">
                    <template x-for="lieu in filteredLieux" :key="lieu.id">
                        <div class="lieu-card p-4 border-b border-border cursor-pointer transition-colors"
                             :class="{'active': selectedLieu && selectedLieu.id === lieu.id}"
                             @click="selectLieu(lieu)">
                            <div class="flex items-start gap-3">
                                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-xl flex-shrink-0 border border-border bg-white"
                                     style="box-shadow:var(--shadow-sm);">
                                    <span x-text="getCategoryIcon(lieu.categorie)"></span>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h4 class="font-bold truncate" style="color:var(--foreground); font-size:.9rem;" x-text="lieu.nom"></h4>
                                    <p class="truncate" style="font-size:.75rem; color:var(--muted-fg);" x-text="lieu.adresse"></p>
                                    <div class="flex items-center gap-3 mt-1.5">
                                        <span class="px-2 py-0.5 rounded-full font-bold"
                                              style="font-size:.65rem;"
                                              :style="getCategoryBadgeStyle(lieu.categorie)"
                                              x-text="lieu.categorie"></span>
                                        <span style="font-size:.7rem; color:var(--muted-fg);" x-show="lieu.distance">
                                            <i class="fas fa-route me-1"></i><span x-text="lieu.distance + ' km'"></span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </template>
                    <div x-show="filteredLieux.length === 0" class="p-10 text-center">
                        <div class="empty-state-icon mx-auto mb-3" style="width:3rem; height:3rem; font-size:1.2rem;">
                            <i class="fas fa-search"></i>
                        </div>
                        <p style="font-size:.85rem; color:var(--muted-fg);">Aucun lieu trouvé</p>
                    </div>
                </div>
            </div>

            <a href="{{ path('aide') }}" class="btn-secondary w-full flex items-center justify-center gap-2" style="font-size:.85rem;">
                <i class="fas fa-arrow-left"></i> Retour au centre d'aide
            </a>
        </div>

        {# ── Map Area ────────────────────────────────────────── #}
        <div class="flex-1 bg-white rounded-2xl shadow-lg border border-border overflow-hidden relative">
            <div id="map"></div>
            
            {# Floating Selection Detail #}
            <div x-show="selectedLieu" 
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 class="absolute bottom-6 left-6 right-6 md:left-1/2 md:-translate-x-1/2 bg-white rounded-2xl shadow-2xl border border-border p-5 max-w-lg z-[1000]">
                <div class="flex flex-col md:flex-row items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl border border-border bg-muted/50 shadow-inner">
                        <span x-text="getCategoryIcon(selectedLieu?.categorie)"></span>
                    </div>
                    <div class="flex-1 text-center md:text-left">
                        <h4 class="font-bold text-lg" style="color:var(--foreground);" x-text="selectedLieu?.nom"></h4>
                        <p style="font-size:.85rem; color:var(--muted-fg);" x-text="selectedLieu?.adresse"></p>
                    </div>
                    <div class="flex gap-2 w-full md:w-auto justify-center">
                        <button @click="showQrCode(selectedLieu)" 
                                class="btn-secondary w-10 h-10 p-0 flex items-center justify-center"
                                title="QR Code">
                            <i class="fas fa-qrcode"></i>
                        </button>
                        <a :href="'tel:' + selectedLieu?.telephone" 
                           x-show="selectedLieu?.telephone"
                           class="btn-secondary w-10 h-10 p-0 flex items-center justify-center"
                           style="color:#16a34a; border-color:#dcfce7; background:#f0fdf4;">
                            <i class="fas fa-phone"></i>
                        </a>
                        <a :href="'https://www.google.com/maps/dir/?api=1&destination=' + selectedLieu?.latitude + ',' + selectedLieu?.longitude"
                           target="_blank"
                           class="btn-primary flex items-center gap-2 shadow-md">
                            <i class="fas fa-directions"></i> Itinéraire
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Modals ────────────────────────────────────────────── #}
    {# QR Code Modal #}
    <div x-show="showQrModal" 
         x-transition
         class="review-modal fixed inset-0 flex items-center justify-center z-[9999] p-4"
         @click.self="showQrModal = false">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden" @click.stop>
            <div class="p-8 text-center">
                <h3 class="text-xl font-bold mb-1" style="color:var(--foreground);" x-text="qrLieu?.nom"></h3>
                <p style="font-size:.85rem; color:var(--muted-fg); margin-bottom:1.5rem;" x-text="qrLieu?.adresse"></p>
                
                <div class="bg-white p-4 rounded-2xl border border-border inline-block mb-6 shadow-inner">
                    <img :src="qrCodeImage" alt="QR Code" class="w-48 h-48 mx-auto">
                </div>
                
                <p style="font-size:.85rem; color:var(--muted-fg); margin-bottom:1.5rem;">Scannez ce QR code pour obtenir l'itinéraire sur votre mobile</p>
                
                <a :href="qrGoogleMapsUrl" 
                   target="_blank"
                   class="btn-primary w-full py-3 mb-3 inline-block">
                    <i class="fas fa-external-link-alt me-1"></i> Google Maps
                </a>
                <button @click="showQrModal = false" class="btn-secondary w-full py-3">
                    Fermer
                </button>
            </div>
        </div>
    </div>

    {# Reviews Modal #}
    <div x-show="showReviewModal" 
         x-transition
         class="review-modal fixed inset-0 flex items-center justify-center z-[9999] p-4"
         @click.self="showReviewModal = false">
        <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-hidden flex flex-col" @click.stop>
            <div class="p-6 border-b border-border flex justify-between items-center bg-muted/10">
                <div>
                    <h3 class="text-xl font-bold" style="color:var(--foreground);" x-text="selectedLieu?.nom"></h3>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="text-amber-400" x-text="'★'.repeat(Math.round(selectedLieu?.avgRating || 0)) + '☆'.repeat(5 - Math.round(selectedLieu?.avgRating || 0))"></span>
                        <span style="font-size:.85rem; color:var(--muted-fg);" x-text="(selectedLieu?.avgRating || 0).toFixed(1) + ' (' + (selectedLieu?.reviewCount || 0) + ' avis)'"></span>
                    </div>
                </div>
                <button @click="showReviewModal = false" class="text-muted-fg hover:text-foreground transition-colors" style="background:none; border:none; font-size:1.5rem; cursor:pointer;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto space-y-8">
                {# Post a Review #}
                <div class="rounded-2xl border border-green-100 p-5" style="background:rgba(34,197,94,0.03);">
                    <h4 class="font-bold text-green-700 mb-4 flex items-center gap-2">
                        <i class="fas fa-pen-nib"></i> Laisser un avis
                    </h4>
                    <form @submit.prevent="submitReview()" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <input type="text" x-model="reviewForm.author_name" required
                                   placeholder="Votre nom" class="input-field">
                            <input type="email" x-model="reviewForm.author_email" required
                                   placeholder="Votre email" class="input-field">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2" style="color:var(--foreground);">Note</label>
                            <div class="star-rating">
                                <input type="radio" id="mstar5" x-model="reviewForm.rating" value="5">
                                <label for="mstar5">★</label>
                                <input type="radio" id="mstar4" x-model="reviewForm.rating" value="4">
                                <label for="mstar4">★</label>
                                <input type="radio" id="mstar3" x-model="reviewForm.rating" value="3">
                                <label for="mstar3">★</label>
                                <input type="radio" id="mstar2" x-model="reviewForm.rating" value="2">
                                <label for="mstar2">★</label>
                                <input type="radio" id="mstar1" x-model="reviewForm.rating" value="1">
                                <label for="mstar1">★</label>
                            </div>
                        </div>
                        <textarea x-model="reviewForm.comment" required rows="3"
                                  placeholder="Partagez votre expérience..."
                                  class="input-field resize-none"></textarea>
                        <button type="submit" 
                                :disabled="reviewFormLoading"
                                class="btn-primary w-full shadow-md" style="background:#16a34a; border-color:#16a34a;">
                            <span x-show="!reviewFormLoading"><i class="fas fa-paper-plane me-1"></i> Envoyer mon avis</span>
                            <span x-show="reviewFormLoading"><i class="fas fa-spinner fa-spin me-1"></i> Envoi en cours...</span>
                        </button>
                    </form>
                </div>

                {# Review List #}
                <div>
                    <h4 class="font-bold mb-4 flex items-center gap-2" style="color:var(--foreground);">
                        <i class="fas fa-comments text-primary"></i> Avis récents (<span x-text="selectedLieuReviews.length"></span>)
                    </h4>
                    
                    <div class="space-y-4">
                        <template x-for="review in selectedLieuReviews" :key="review.id">
                            <div class="p-4 bg-muted/40 rounded-2xl border border-border">
                                <div class="flex items-start justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold" style="color:var(--foreground);" x-text="review.authorName"></span>
                                        <span x-show="review.isVerified" class="text-[10px] uppercase tracking-wider font-bold bg-green-100 text-green-700 px-2 py-0.5 rounded-full">Vérifié</span>
                                    </div>
                                    <span class="text-amber-400 text-sm" x-text="review.ratingStars"></span>
                                </div>
                                <p style="color:var(--muted-fg); font-size:.9rem;" x-text="review.comment"></p>
                                <div class="flex items-center justify-between mt-3">
                                    <span style="font-size:.75rem; color:var(--muted-fg);" x-text="review.createdAt"></span>
                                    <button @click="markHelpful(review.id)" class="text-primary font-bold hover:underline" style="background:none; border:none; font-size:.75rem; cursor:pointer;">
                                        <i class="fas fa-thumbs-up me-1"></i> Utile (<span x-text="review.helpfulCount"></span>)
                                    </button>
                                </div>
                            </div>
                        </template>
                        
                        <div x-show="selectedLieuReviews.length === 0" class="text-center py-10">
                            <div class="empty-state-icon mx-auto mb-3" style="width:3.5rem; height:3.5rem;">
                                <i class="fas fa-comment-slash"></i>
                            </div>
                            <p style="color:var(--muted-fg); font-size:.9rem;">Aucun avis pour le moment</p>
                            <p class="text-primary font-bold mt-1" style="font-size:.85rem;">Soyez le premier à donner votre avis !</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
var mapAppData = null;

function mapApp() {
    return {
        lieux: {{ lieux|json_encode|raw }},
        categories: {{ categories|json_encode|raw }},
        filteredLieux: [],
        activeCategory: '',
        searchQuery: '',
        selectedLieu: null,
        userLocation: { lat: 36.8065, lng: 10.1815 },
        map: null,
        markers: [],
        userMarker: null,
        showReviewModal: false,
        selectedLieuReviews: [],
        reviewForm: { author_name: '', author_email: '', rating: 5, comment: '' },
        reviewFormLoading: false,
        showQrModal: false,
        qrLieu: null,
        qrCodeImage: '',
        qrGoogleMapsUrl: '',

        init() {
            mapAppData = this;
            this.filteredLieux = [...this.lieux];
            this.initMap();
            this.getUserLocation();
        },

        initMap() {
            this.map = L.map('map').setView([36.8065, 10.1815], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(this.map);
            this.addMarkers();
        },

        getUserLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        this.userLocation = {
                            lat: position.coords.latitude,
                            lng: position.coords.longitude
                        };
                        this.map.setView([this.userLocation.lat, this.userLocation.lng], 15);
                        this.addUserMarker();
                        this.calculateDistances();
                    },
                    () => {
                        this.addUserMarker();
                        this.calculateDistances();
                    }
                );
            } else {
                this.addUserMarker();
                this.calculateDistances();
            }
        },

        addUserMarker() {
            if (this.userMarker) this.map.removeLayer(this.userMarker);
            const userIcon = L.divIcon({
                html: '<div style="background: linear-gradient(135deg, var(--primary), #b91c1c); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4); border: 2px solid white;">📍</div>',
                className: 'user-marker',
                iconSize: [32, 32],
                iconAnchor: [16, 16]
            });
            this.userMarker = L.marker([this.userLocation.lat, this.userLocation.lng], { icon: userIcon })
                .addTo(this.map)
                .bindPopup('<strong>📍 Votre position</strong>');
        },

        addMarkers() {
            this.markers.forEach(m => this.map.removeLayer(m));
            this.markers = [];
            this.filteredLieux.forEach(lieu => {
                const icon = L.divIcon({
                    html: `<div style="background: ${this.getCategoryColor(lieu.categorie)}; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; box-shadow: 0 3px 8px rgba(0,0,0,0.2); border: 2px solid white;">${this.getCategoryIcon(lieu.categorie)}</div>`,
                    className: 'lieu-marker',
                    iconSize: [32, 32],
                    iconAnchor: [16, 16]
                });
                const marker = L.marker([parseFloat(lieu.latitude), parseFloat(lieu.longitude)], { icon })
                    .addTo(this.map);
                marker.on('click', () => this.selectLieu(lieu));
                this.markers.push(marker);
            });
        },

        calculateDistances() {
            this.lieux.forEach(lieu => {
                const d = this.getDistance(this.userLocation.lat, this.userLocation.lng, parseFloat(lieu.latitude), parseFloat(lieu.longitude));
                lieu.distance = d.toFixed(1);
            });
            this.lieux.sort((a, b) => parseFloat(a.distance) - parseFloat(b.distance));
            this.filterLieux();
        },

        getDistance(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2-lat1)*Math.PI/180;
            const dLon = (lon2-lon1)*Math.PI/180;
            const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        },

        filterLieux() {
            let f = this.lieux;
            if (this.activeCategory) f = f.filter(l => l.categorie === this.activeCategory);
            if (this.searchQuery) {
                const q = this.searchQuery.toLowerCase();
                f = f.filter(l => l.nom.toLowerCase().includes(q) || l.adresse.toLowerCase().includes(q));
            }
            this.filteredLieux = f;
            this.addMarkers();
        },

        toggleCategory(c) { this.activeCategory = c; this.filterLieux(); },

        selectLieu(l) {
            this.selectedLieu = l;
            this.map.setView([parseFloat(l.latitude), parseFloat(l.longitude)], 16);
        },

        getCategoryIcon(c) {
            const i = {'Médecin':'👨‍⚕️','Pharmacie':'💊','Hôpital':'🏥','Clinique':'🏨','Laboratoire':'🧪','Urgence':'🚨'};
            return i[c] || '📍';
        },

        getCategoryColor(c) {
            const col = {'Médecin':'#10b981','Pharmacie':'#8b5cf6','Hôpital':'#ef4444','Clinique':'#f59e0b','Laboratoire':'#06b6d4','Urgence':'#dc2626'};
            return col[c] || '#ef4444';
        },

        getCategoryBadgeStyle(c) {
            const col = this.getCategoryColor(c);
            return `background: ${col}15; color: ${col}; border: 1px solid ${col}25;`;
        },

        openReviews(id) {
            this.selectedLieu = this.lieux.find(l => l.id === id);
            fetch(`/aide/map/lieu/${id}/reviews`).then(r => r.json()).then(d => {
                this.selectedLieuReviews = d.reviews;
                this.showReviewModal = true;
            });
        },

        submitReview() {
            this.reviewFormLoading = true;
            const fd = new FormData();
            Object.keys(this.reviewForm).forEach(k => fd.append(k, this.reviewForm[k]));
            fetch(`/aide/map/lieu/${this.selectedLieu.id}/review`, { method: 'POST', body: fd })
                .then(r => r.json()).then(d => {
                    if (d.success) {
                        this.selectedLieuReviews.unshift(d.review);
                        this.reviewForm = { author_name: '', author_email: '', rating: 5, comment: '' };
                    }
                }).finally(() => this.reviewFormLoading = false);
        },

        markHelpful(id) {
            fetch(`/aide/map/review/${id}/helpful`, { method: 'POST' }).then(r => r.json()).then(d => {
                if (d.success) {
                    const r = this.selectedLieuReviews.find(x => x.id === id);
                    if (r) r.helpfulCount = d.helpfulCount;
                }
            });
        },

        showQrCode(l) {
            this.qrLieu = l;
            this.qrGoogleMapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${l.latitude},${l.longitude}`;
            fetch(`/aide/map/lieu/${l.id}/qr`).then(r => r.json()).then(d => {
                if (d.success) { this.qrCodeImage = d.qrCode; this.showQrModal = true; }
            });
        }
    };
}

function openReviewsModal(id) { if (mapAppData) mapAppData.openReviews(id); }
</script>
{% endblock %}
