{% extends 'layout/front-layout.html.twig' %}

{% block title %}Mes Tickets - Support — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block content %}
<div class="space-y-6 animate-fadeIn">
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-4">
            <div>
                <h1 class="page-title"><i class="fas fa-ticket-alt text-primary me-2"></i> Mes Tickets</h1>
                <p class="page-subtitle">Suivez l'état de vos demandes de support</p>
            </div>
        </div>
        <a href="{{ path('aide_support_new') }}" class="btn-primary shadow-lg flex items-center gap-2">
            <i class="fas fa-plus"></i> Nouveau ticket
        </a>
    </div>

    {% for message in app.flashes('success') %}
    <div class="bg-green-50 border-l-4 border-green-500 text-green-700 px-4 py-3 rounded-lg flex items-center gap-3">
        <i class="fas fa-check-circle"></i> {{ message }}
    </div>
    {% endfor %}

    {% if tickets|length > 0 %}
    <div class="space-y-4">
        {% for ticket in tickets %}
        <a href="{{ path('aide_support_view', {id: ticket.id}) }}" 
           class="card card-hover block group" style="text-decoration:none; padding:1.5rem;">
            <div class="flex justify-between items-start">
                <div class="flex items-start gap-4">
                    <div class="empty-state-icon" style="width:3rem; height:3rem; font-size:1.2rem;">
                        {% if ticket.status == 'open' %}
                            <i class="fas fa-ticket-alt text-primary"></i>
                        {% elseif ticket.status == 'in_progress' %}
                            <i class="fas fa-comments text-orange-500"></i>
                        {% elseif ticket.status == 'resolved' %}
                            <i class="fas fa-check text-green-600"></i>
                        {% else %}
                            <i class="fas fa-folder-open text-gray-400"></i>
                        {% endif %}
                    </div>
                    <div>
                        <h3 class="font-bold group-hover:text-primary transition-colors" style="color:var(--foreground); font-size:1.05rem;">
                            {{ ticket.subject }}
                        </h3>
                        <p class="text-sm mt-1 line-clamp-1" style="color:var(--muted-fg);">{{ ticket.description|slice(0, 100) }}...</p>
                        <div class="flex items-center gap-4 mt-2" style="font-size:.75rem; color:var(--muted-fg);">
                            <span>#{{ ticket.id }}</span>
                            <span><i class="fas fa-calendar me-1"></i> {{ ticket.createdAt|date('d/m/Y H:i') }}</span>
                            <span><i class="fas fa-folder me-1"></i> {{ ticket.category }}</span>
                            {% if ticket.messages|length > 0 %}
                            <span><i class="fas fa-comment-dots me-1"></i> {{ ticket.messages|length }} message(s)</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="flex flex-col items-end gap-2">
                    <span class="px-3 py-1 rounded-full text-xs font-bold {{ ticket.statusBadgeClass }}">
                        {{ ticket.status|replace({'_': ' '})|title }}
                    </span>
                    <span class="px-3 py-1 rounded-full text-xs font-bold {{ ticket.priorityBadgeClass }}">
                        {{ ticket.priority|upper }}
                    </span>
                </div>
            </div>
        </a>
        {% endfor %}
    </div>
    {% else %}
    <div class="card text-center" style="padding:4rem 1rem;">
        <div class="empty-state-icon mx-auto mb-4" style="width:4rem; height:4rem; font-size:1.5rem;">
            <i class="fas fa-ticket-alt"></i>
        </div>
        <h3 class="font-bold" style="font-size:1.15rem; color:var(--foreground);">Aucun ticket</h3>
        <p style="color:var(--muted-fg); margin-top:.5rem; font-size:.9rem;">Vous n'avez pas encore créé de ticket de support.</p>
        <div class="mt-8">
            <a href="{{ path('aide_support_new') }}" class="btn-primary">
                <i class="fas fa-plus me-1"></i> Créer mon premier ticket
            </a>
        </div>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card">
            <h3 class="section-title mb-4">📊 Statut des tickets</h3>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                        <span style="color:var(--muted-fg); font-size:.9rem;">Ouverts</span>
                    </div>
                    <span class="font-bold" style="color:var(--foreground);">{{ tickets|filter(t => t.status == 'open')|length }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 bg-orange-500 rounded-full"></div>
                        <span style="color:var(--muted-fg); font-size:.9rem;">En cours</span>
                    </div>
                    <span class="font-bold" style="color:var(--foreground);">{{ tickets|filter(t => t.status == 'in_progress')|length }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                        <span style="color:var(--muted-fg); font-size:.9rem;">Résolus</span>
                    </div>
                    <span class="font-bold" style="color:var(--foreground);">{{ tickets|filter(t => t.status == 'resolved')|length }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 bg-gray-400 rounded-full"></div>
                        <span style="color:var(--muted-fg); font-size:.9rem;">Fermés</span>
                    </div>
                    <span class="font-bold" style="color:var(--foreground);">{{ tickets|filter(t => t.status == 'closed')|length }}</span>
                </div>
            </div>
        </div>

        <div class="card" style="background:rgba(239,68,68,.04); border-color:rgba(239,68,68,.1);">
            <h3 class="section-title mb-3" style="color:var(--primary);">
                <i class="fas fa-lightbulb me-1"></i> Besoin d'aide rapide ?
            </h3>
            <p style="font-size:.85rem; color:var(--muted-fg); margin-bottom:1.5rem;">
                Avant de créer un ticket, consultez notre FAQ. Vous y trouverez peut-être la réponse à votre question !
            </p>
            <a href="{{ path('aide_faq') }}" class="btn-primary" style="width:100%; display:block; text-align:center;">
                <i class="fas fa-question-circle me-1"></i> Consulter la FAQ
            </a>
        </div>
    </div>
</div>
{% endblock %}
