{% extends 'layout/front-layout.html.twig' %}

{% block title %}Nouveau Ticket - Support — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto space-y-6 animate-fadeIn">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
            <h1 class="page-title"><i class="fas fa-ticket-alt text-primary me-2"></i> Nouveau Ticket</h1>
        </div>
        <a href="{{ path('aide') }}" class="btn-secondary" style="font-size:.85rem;">
            ← Retour
        </a>
    </div>

    {% for message in app.flashes('error') %}
    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded-lg flex items-center gap-3">
        <i class="fas fa-exclamation-circle"></i> {{ message }}
    </div>
    {% endfor %}

    <div class="card" style="padding:2rem;">
        <form method="post" enctype="multipart/form-data" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Nom complet *</label>
                    <input type="text" name="user_name" required
                           value="{{ userEmail ? '' : '' }}"
                           class="input-field"
                           placeholder="Votre nom">
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Email *</label>
                    <input type="email" name="user_email" required
                           value="{{ userEmail }}"
                           class="input-field"
                           placeholder="votre@email.com">
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Sujet *</label>
                <input type="text" name="subject" required
                       class="input-field"
                       placeholder="Résumez votre problème en quelques mots">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Catégorie</label>
                    <select name="category" class="input-field">
                        <option value="general">Général</option>
                        <option value="don">Don</option>
                        <option value="aide">Aide</option>
                        <option value="urgence">Urgence</option>
                        <option value="compte">Compte</option>
                        <option value="technique">Technique</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Priorité</label>
                    <select name="priority" class="input-field">
                        <option value="low">Basse</option>
                        <option value="medium" selected>Moyenne</option>
                        <option value="high">Haute</option>
                        <option value="urgent">Urgente</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Description *</label>
                <textarea name="description" rows="5" required
                          class="input-field resize-none"
                          placeholder="Décrivez votre problème en détail..."></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">📎 Pièce jointe (optionnel)</label>
                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-dashed rounded-xl transition-colors hover:bg-muted border-border hover:border-primary">
                    <div class="space-y-1 text-center">
                        <i class="fas fa-cloud-upload-alt text-3xl mb-3" style="color:var(--muted-fg);"></i>
                        <div class="flex text-sm" style="color:var(--muted-fg);">
                            <label class="relative cursor-pointer rounded-md font-bold text-primary hover:underline">
                                <span>Télécharger un fichier</span>
                                <input type="file" name="attachment" accept="image/jpeg,image/png,image/gif,application/pdf" class="sr-only">
                            </label>
                            <p class="pl-1">ou glisser-déposer</p>
                        </div>
                        <p class="text-xs" style="color:var(--muted-fg);">Images (JPG, PNG, GIF) ou PDF jusqu'à 5MB</p>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-border">
                <a href="{{ path('aide') }}" class="btn-secondary">
                    Annuler
                </a>
                <button type="submit" class="btn-primary">
                    <i class="fas fa-paper-plane me-1"></i> Créer le ticket
                </button>
            </div>
        </form>
    </div>

    <div class="rounded-2xl p-6 border border-red-100 shadow-sm" style="background:rgba(239,68,68,.04);">
        <h3 class="font-bold mb-3" style="color:var(--primary);">
            <i class="fas fa-lightbulb me-1"></i> Conseils pour une réponse rapide
        </h3>
        <ul class="text-sm space-y-2" style="color:var(--muted-fg);">
            <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Décrivez votre problème de manière claire et précise</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Incluez les messages d'erreur si applicable</span>
            </li>
            <li class="flex items-start gap-2">
                <span class="text-primary mt-1">•</span>
                <span>Indiquez les étapes pour reproduire le problème</span>
            </li>
        </ul>
    </div>
</div>
{% endblock %}
