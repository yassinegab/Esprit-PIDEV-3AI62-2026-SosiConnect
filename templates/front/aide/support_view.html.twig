{% extends 'layout/front-layout.html.twig' %}

{% block title %}Ticket #{{ ticket.id }} — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.star-rating {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
}
.star-rating input {
    display: none;
}
.star-rating label {
    cursor: pointer;
    font-size: 2rem;
    color: var(--muted);
    transition: color 0.2s;
}
.star-rating label:hover,
.star-rating label:hover ~ label,
.star-rating input:checked ~ label {
    color: #fbbf24;
}

.message-bubble {
    padding: 1rem;
    border-radius: 1.25rem;
    font-size: .95rem;
}
.message-bubble-user {
    background: var(--muted);
    color: var(--foreground);
    border-top-left-radius: 0;
}
.message-bubble-admin {
    background: rgba(239,68,68,.1);
    color: var(--primary);
    border-top-right-radius: 0;
    border: 1px solid rgba(239,68,68,.15);
}
</style>
{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6 animate-fadeIn">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
            <h1 class="page-title">Ticket #{{ ticket.id }}</h1>
            <span class="px-3 py-1 {{ ticket.statusBadgeClass }} rounded-full text-xs font-bold">
                {{ ticket.status|replace({'_': ' '})|title }}
            </span>
        </div>
        <a href="{{ path('aide_support') }}" class="btn-secondary" style="font-size:.85rem;">
            ← Retour
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# ── Main Chat Area ──────────────────────────────────── #}
        <div class="lg:col-span-2 space-y-4">
            <div class="card" style="padding:0; overflow:hidden;">
                <div class="p-4 bg-muted border-b border-border flex justify-between items-center">
                    <h2 class="font-bold" style="color:var(--foreground);">{{ ticket.subject }}</h2>
                    <span style="font-size:.75rem; color:var(--muted-fg);">{{ ticket.createdAt|date('d/m/Y H:i') }}</span>
                </div>
                
                <div class="p-6 max-h-[500px] overflow-y-auto space-y-6">
                    {# Original Description #}
                    <div class="flex gap-3">
                        <div class="empty-state-icon" style="width:2.5rem; height:2.5rem; font-size:1rem; flex-shrink:0;">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-bold" style="color:var(--foreground); font-size:.9rem;">{{ ticket.userName }}</span>
                                <span style="font-size:.7rem; color:var(--muted-fg);">{{ ticket.createdAt|date('H:i') }}</span>
                            </div>
                            <div class="message-bubble message-bubble-user">
                                <p class="leading-relaxed">{{ ticket.description|nl2br }}</p>
                            </div>
                        </div>
                    </div>

                    {# Messages History #}
                    {% for message in ticket.messages %}
                    <div class="flex gap-3 {{ message.isFromAdmin ? 'flex-row-reverse' : '' }}">
                        <div class="empty-state-icon" 
                             style="width:2.5rem; height:2.5rem; font-size:1rem; flex-shrink:0; {{ message.isFromAdmin ? 'background:rgba(239,68,68,.15); color:var(--primary);' : '' }}">
                            <i class="fas {{ message.isFromAdmin ? 'fa-headset' : 'fa-user' }}"></i>
                        </div>
                        <div class="flex-1 {{ message.isFromAdmin ? 'text-right' : '' }}">
                            <div class="flex items-center gap-2 mb-1 {{ message.isFromAdmin ? 'justify-end' : '' }}">
                                {% if message.isFromAdmin %}
                                <span class="font-bold" style="color:var(--primary); font-size:.9rem;">Support Sosi</span>
                                <span style="font-size:.7rem; color:var(--muted-fg);">{{ message.createdAt|date('H:i') }}</span>
                                {% else %}
                                <span class="font-bold" style="color:var(--foreground); font-size:.9rem;">{{ message.senderName }}</span>
                                <span style="font-size:.7rem; color:var(--muted-fg);">{{ message.createdAt|date('H:i') }}</span>
                                {% endif %}
                            </div>
                            <div class="message-bubble {{ message.isFromAdmin ? 'message-bubble-admin' : 'message-bubble-user' }} inline-block text-left">
                                <p class="leading-relaxed">{{ message.content|nl2br }}</p>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# ── Reply Form ──────────────────────────────────── #}
            {% if ticket.status != 'closed' %}
            <div class="card" style="padding:1.5rem;">
                <form method="post">
                    <label class="block text-sm font-bold mb-3" style="color:var(--foreground);">Votre réponse</label>
                    <div class="flex gap-3 items-end">
                        <textarea name="message" rows="3" required
                                  class="input-field flex-1 resize-none"
                                  placeholder="Écrivez votre message..."></textarea>
                        <button type="submit" class="btn-primary" style="padding:1rem; width:3.5rem; height:3.5rem; border-radius:1rem;">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>
            {% else %}
            <div class="card text-center" style="padding:2rem; background:rgba(244,244,245,.5); border-style:dashed;">
                <p style="color:var(--muted-fg);"><i class="fas fa-lock me-1"></i> Ce ticket est fermé. Vous ne pouvez plus envoyer de messages.</p>
            </div>
            
            {# ── Feedback Section ────────────────────────────── #}
            {% if not feedback %}
            <div class="card border-red-100" style="background:rgba(239,68,68,.02);">
                <h3 class="section-title mb-4" style="color:var(--primary);">
                    <i class="fas fa-star me-1"></i> Évaluez votre expérience
                </h3>
                <p style="font-size:.85rem; color:var(--muted-fg); margin-bottom:1.5rem;">Votre avis nous aide à améliorer notre service support.</p>
                
                <form method="post" action="{{ path('aide_support_feedback', {id: ticket.id}) }}" x-data="{ rating: 5, wouldRecommend: true }">
                    <div class="mb-4">
                        <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Note globale</label>
                        <div class="star-rating">
                            <input type="radio" name="rating" id="star5" value="5" x-model="rating" checked>
                            <label for="star5">★</label>
                            <input type="radio" name="rating" id="star4" value="4" x-model="rating">
                            <label for="star4">★</label>
                            <input type="radio" name="rating" id="star3" value="3" x-model="rating">
                            <label for="star3">★</label>
                            <input type="radio" name="rating" id="star2" value="2" x-model="rating">
                            <label for="star2">★</label>
                            <input type="radio" name="rating" id="star1" value="1" x-model="rating">
                            <label for="star1">★</label>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Type de feedback</label>
                            <select name="feedback_type" class="input-field">
                                <option value="general">Général</option>
                                <option value="response_time">Temps de réponse</option>
                                <option value="solution_quality">Qualité de la solution</option>
                                <option value="agent_friendliness">Amabilité de l'agent</option>
                            </select>
                        </div>
                        <div>
                             <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Recommandation</label>
                             <div class="flex items-center gap-3 pt-2">
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="checkbox" name="would_recommend" value="1" checked x-model="wouldRecommend"
                                           class="w-4 h-4 rounded border-border text-primary focus:ring-primary">
                                    <span style="font-size:.85rem; color:var(--muted-fg);">Oui, je recommanderais</span>
                                </label>
                             </div>
                        </div>
                    </div>
                    
                    <div class="mb-5">
                        <label class="block text-sm font-semibold mb-2" style="color:var(--foreground);">Commentaire (optionnel)</label>
                        <textarea name="comment" rows="3" 
                                  placeholder="Partagez votre expérience..."
                                  class="input-field resize-none"></textarea>
                    </div>
                    
                    <button type="submit" class="btn-primary w-full">
                        <i class="fas fa-check me-1"></i> Envoyer mon avis
                    </button>
                </form>
            </div>
            {% else %}
            <div class="card border-green-100" style="background:rgba(34,197,94,.02);">
                <div class="flex items-center gap-3 mb-4">
                    <div class="empty-state-icon" style="background:rgba(34,197,94,.1); color:#16a34a; width:3rem; height:3rem;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div>
                        <h4 class="font-bold" style="color:#16a34a;">Merci pour votre avis !</h4>
                        <p style="font-size:.8rem; color:var(--muted-fg);">Vous avez noté ce ticket <strong>{{ feedback.rating }}/5</strong></p>
                    </div>
                </div>
                <div class="flex items-center gap-1 text-amber-400 mb-3" style="font-size:1.2rem;">
                    {% for i in 1..5 %}
                        <i class="{{ i <= feedback.rating ? 'fas' : 'far' }} fa-star"></i>
                    {% endfor %}
                    <span class="ml-2 font-bold" style="font-size:.9rem; color:var(--muted-fg);">{{ feedback.ratingLabel }}</span>
                </div>
                {% if feedback.comment %}
                <div class="p-3 bg-muted rounded-lg border border-border mt-3 italic" style="color:var(--muted-fg); font-size:.9rem;">
                    "{{ feedback.comment }}"
                </div>
                {% endif %}
                {% if feedback.wouldRecommend %}
                <p class="mt-3 font-semibold" style="color:#16a34a; font-size:.85rem;"><i class="fas fa-check-double me-1"></i> Vous recommanderiez ce service</p>
                {% endif %}
            </div>
            {% endif %}
            {% endif %}
        </div>

        {# ── Sidebar Info ────────────────────────────────────── #}
        <div class="space-y-4">
            <div class="card" style="padding:1.5rem;">
                <h3 class="section-title mb-4">📋 Détails</h3>
                <div class="space-y-5">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color:var(--muted-fg);">Statut</p>
                        <span class="px-3 py-1 {{ ticket.statusBadgeClass }} rounded-full text-xs font-bold">
                            {{ ticket.status|replace({'_': ' '})|title }}
                        </span>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color:var(--muted-fg);">Priorité</p>
                        <span class="px-3 py-1 {{ ticket.priorityBadgeClass }} rounded-full text-xs font-bold">
                            {{ ticket.priority|upper }}
                        </span>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider mb-1" style="color:var(--muted-fg);">Catégorie</p>
                        <p class="font-bold" style="color:var(--foreground);">{{ ticket.category|title }}</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider mb-1" style="color:var(--muted-fg);">Créé le</p>
                        <p class="font-bold" style="color:var(--foreground);">{{ ticket.createdAt|date('d/m/Y à H:i') }}</p>
                    </div>
                    {% if ticket.assignedTo %}
                    <div>
                        <p class="text-xs font-bold uppercase tracking-wider mb-1" style="color:var(--muted-fg);">Assigné à</p>
                        <p class="font-bold" style="color:var(--primary);"><i class="fas fa-user-shield me-1"></i> {{ ticket.assignedTo }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            <div class="card border-red-100" style="background:rgba(239,68,68,.04);">
                <h3 class="font-bold mb-2" style="color:var(--primary); font-size:.9rem;"><i class="fas fa-clock me-1"></i> Engagement Sosi</h3>
                <p style="font-size:.85rem; color:var(--muted-fg);">
                    Notre équipe s'engage à répondre sous <strong>24 heures</strong> ouvrées.
                </p>
            </div>

            <div class="card" style="padding:1.5rem;">
                <h3 class="section-title mb-4">📎 Actions</h3>
                <div class="space-y-2">
                    <a href="{{ path('aide_faq') }}" class="btn-secondary w-full flex items-center justify-center gap-2" style="font-size:.85rem;">
                        <i class="fas fa-question-circle"></i> Consulter la FAQ
                    </a>
                    <a href="{{ path('aide_support_new') }}" class="btn-primary w-full flex items-center justify-center gap-2" style="font-size:.85rem;">
                        <i class="fas fa-plus"></i> Nouveau ticket
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
