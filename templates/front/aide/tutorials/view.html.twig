{% extends 'layout/front-layout.html.twig' %}

{% block title %}{{ tutorial.title }} — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.video-container {
    position: relative;
    padding-top: 56.25%;
    background: #000;
    border-radius: 1rem;
    overflow: hidden;
}
.video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}
</style>
{% endblock %}

{% block content %}
<div class="space-y-6 animate-fadeIn">
    <div class="flex items-center gap-4">
        <a href="{{ path('aide_tutorials') }}" class="btn-secondary" style="font-size:.85rem;">
            ← Retour aux tutoriels
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="card" style="padding:0;overflow:hidden;">
                <div class="video-container">
                    <iframe src="{{ tutorial.embedUrl }}" 
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen></iframe>
                </div>
                
                <div style="padding:1.5rem;">
                    <div class="flex items-start justify-between">
                        <div>
                            <span class="badge-primary">
                                {{ tutorial.category }}
                            </span>
                            <h1 class="text-2xl font-bold mt-3" style="color:var(--foreground);">{{ tutorial.title }}</h1>
                        </div>
                        <span class="badge-muted">
                            {{ tutorial.durationFormatted }}
                        </span>
                    </div>
                    
                    <p class="mt-4 leading-relaxed" style="color:var(--muted-fg);">{{ tutorial.description }}</p>
                    
                    <div class="flex items-center gap-6 mt-6 pt-4 border-t border-border">
                        <span style="font-size:.85rem;color:var(--muted-fg);">
                            <i class="fas fa-eye me-1"></i> {{ tutorial.viewCount }} vues
                        </span>
                        <span style="font-size:.85rem;color:var(--muted-fg);">
                            <i class="fas fa-calendar me-1"></i> {{ tutorial.createdAt|date('d/m/Y') }}
                        </span>
                        <form method="post" action="{{ path('aide_tutorial_like', {id: tutorial.id}) }}" class="ml-auto">
                            <button type="submit" class="flex items-center gap-2 transition hover:text-primary" style="background:none;border:none;color:var(--muted-fg);font-weight:600;">
                                <i class="fas fa-thumbs-up"></i> <span>{{ tutorial.likeCount }}</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            <div class="card">
                <h3 class="section-title mb-4">📁 Catégorie</h3>
                <a href="{{ path('aide_tutorials', {category: tutorial.category}) }}" 
                   class="badge-primary py-2 px-4" style="font-size:.85rem;text-decoration:none;">
                    {{ tutorial.category }}
                </a>
            </div>

            <div class="card" style="background:rgba(239,68,68,.04);border-color:rgba(239,68,68,.15);">
                <h3 class="section-title mb-3" style="color:var(--primary);">
                    <i class="fas fa-lightbulb me-1"></i> Astuce
                </h3>
                <p style="font-size:.85rem;color:var(--muted-fg);">
                    Partagez ce tutoriel avec vos amis pour les aider à utiliser nos services !
                </p>
                <div class="flex gap-2 mt-4">
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ app.request.uri }}" target="_blank"
                       class="w-10 h-10 bg-[#1877F2] text-white rounded-lg flex items-center justify-center hover:opacity-90 transition">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="https://twitter.com/intent/tweet?text={{ tutorial.title }}&url={{ app.request.uri }}" target="_blank"
                       class="w-10 h-10 bg-[#1DA1F2] text-white rounded-lg flex items-center justify-center hover:opacity-90 transition">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="https://wa.me/?text={{ tutorial.title }} {{ app.request.uri }}" target="_blank"
                       class="w-10 h-10 bg-[#25D366] text-white rounded-lg flex items-center justify-center hover:opacity-90 transition">
                        <i class="fab fa-whatsapp"></i>
                    </a>
                </div>
            </div>

            <a href="{{ path('aide_support_new') }}" 
               class="card block hover:shadow-xl transition" style="text-decoration:none;">
                <div class="flex items-center gap-3">
                    <div class="empty-state-icon" style="width:3rem;height:3rem;font-size:1.2rem;">
                        <i class="fas fa-question"></i>
                    </div>
                    <div>
                        <p class="font-medium" style="color:var(--foreground);">Besoin d'aide ?</p>
                        <p style="font-size:.8rem;color:var(--muted-fg);">Contacter le support</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
{% endblock %}
