{% extends 'layout/front-layout.html.twig' %}

{% block title %}Modifier Contact — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.avatar-gradient {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
}
</style>
{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto space-y-6 animate-fadeIn">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
            <h1 class="page-title"><i class="fas fa-edit text-primary me-2"></i> Modifier le contact</h1>
        </div>
        <a href="{{ path('contact_urgence_index') }}" class="btn-secondary" style="font-size:.85rem;">
            ← Retour
        </a>
    </div>

    <div class="card" style="padding:2rem;">
        <div class="flex items-center gap-4 mb-8">
            <div class="w-16 h-16 avatar-gradient rounded-2xl flex items-center justify-center text-white text-2xl font-bold">
                {% if form.vars.value.nom %}{{ form.vars.value.nom|first|upper }}{% else %}?{% endif %}
            </div>
            <div>
                <h3 class="font-bold" style="color:var(--foreground); font-size:1.1rem;">Modifier les informations</h3>
                <p style="color:var(--muted-fg); font-size:.85rem;">Mettez à jour les coordonnées du contact</p>
            </div>
        </div>

        {{ form_start(form, { attr: { class: 'space-y-6' } }) }}
            <div>
                <label class="block text-sm font-bold mb-2" style="color:var(--foreground);">Nom complet</label>
                {{ form_widget(form.nom, { attr: { 
                    class: 'input-field',
                    placeholder: 'Ex: Ahmed Ben Ali'
                } }) }}
            </div>

            <div>
                <label class="block text-sm font-bold mb-2" style="color:var(--foreground);">Lien / Relation</label>
                {{ form_widget(form.lien, { attr: { 
                    class: 'input-field',
                    placeholder: 'Ex: Père, Mère, Frère...'
                } }) }}
            </div>

            <div>
                <label class="block text-sm font-bold mb-2" style="color:var(--foreground);">Téléphone</label>
                {{ form_widget(form.telephone, { attr: { 
                    class: 'input-field',
                    placeholder: 'Ex: XX XXX XXX'
                } }) }}
            </div>

            <div class="flex gap-4 pt-4">
                <a href="{{ path('contact_urgence_index') }}" class="btn-secondary flex-1 text-center py-3">
                    Annuler
                </a>
                <button type="submit" class="btn-primary flex-1 py-3 shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-save"></i> Enregistrer
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="card border-red-100" style="background:rgba(239,68,68,.02); padding:1.25rem;">
        <h3 class="font-bold text-primary mb-2 flex items-center gap-2">
            <i class="fas fa-exclamation-triangle"></i> Attention
        </h3>
        <p style="font-size:.85rem; color:var(--muted-fg); line-height:1.6;">
            Ce contact recevra un SMS avec votre position GPS précise en cas d'urgence. 
            Assurez-vous que les informations sont correctes pour garantir votre sécurité.
        </p>
    </div>
</div>
{% endblock %}
