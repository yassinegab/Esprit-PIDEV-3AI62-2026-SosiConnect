{% extends 'layout/front-layout.html.twig' %}

{% block title %}Demande de Don - Sosi{% endblock %}

{% block content %}
<div class="space-y-8 animate-page-enter">
    {# ── Header ── #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="page-title flex items-center gap-3">
                <span class="stat-icon w-10 h-10 text-lg"><i class="fas fa-hand-holding-heart"></i></span>
                Demande de Don
            </h1>
            <p class="page-subtitle mt-1">Soumettez une demande pour vous-même ou pour un proche</p>
        </div>
        <a href="{{ path('don') }}" class="btn-ghost text-muted-foreground hover:text-foreground">
            <i class="fas fa-arrow-left mr-2"></i> Retour au module
        </a>
    </div>

    {# ── Messages ── #}
    {% for message in app.flashes('success') %}
    <div class="animate-fade-in bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl shadow-sm flex items-center gap-3">
        <i class="fas fa-check-circle text-lg"></i>
        <span class="font-medium">{{ message }}</span>
    </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
    <div class="animate-fade-in bg-red-50 border border-primary/20 text-primary px-4 py-3 rounded-xl shadow-sm flex items-center gap-3">
        <i class="fas fa-exclamation-circle text-lg"></i>
        <span class="font-medium">{{ message }}</span>
    </div>
    {% endfor %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {# ── Request Form ── #}
        <div class="card p-8">
            <div class="flex items-center gap-4 mb-8">
                <div class="stat-icon w-14 h-14 bg-primary/10 text-primary rounded-2xl flex items-center justify-center text-2xl">
                    <i class="fas fa-paper-plane"></i>
                </div>
                <div>
                    <h2 class="text-xl font-black text-foreground tracking-tight">Nouvelle Demande</h2>
                    <p class="section-title">Formulaire de demande</p>
                </div>
            </div>

            <form method="post" class="space-y-6">
                <div>
                    <label class="form-label">Type de don *</label>
                    <select name="type_demande" required id="typeDemande"
                            class="input-field appearance-none cursor-pointer">
                        <option value="">Sélectionner...</option>
                        <option value="sang">🩸 Sang</option>
                        <option value="organe">🫀 Organe</option>
                    </select>
                </div>

                <div id="sanguinField" class="hidden animate-fade-in">
                    <label class="form-label">Groupe Sanguin *</label>
                    <select name="type_sanguin"
                            class="input-field appearance-none cursor-pointer">
                        <option value="">Sélectionner...</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                </div>

                <div id="organeField" class="hidden animate-fade-in">
                    <label class="form-label">Type d'organe *</label>
                    <select name="type_organe"
                            class="input-field appearance-none cursor-pointer">
                        <option value="">Sélectionner...</option>
                        <option value="rein">Rein</option>
                        <option value="foie">Foie</option>
                        <option value="coeur">Cœur</option>
                        <option value="poumon">Poumon</option>
                        <option value="cornee">Cornée</option>
                        <option value="moelle">Moelle osseuse</option>
                    </select>
                </div>

                <div>
                    <label class="form-label">Région *</label>
                    <input type="text" name="region" required
                           class="input-field"
                           placeholder="Ex: Tunis, Sfax...">
                </div>

                <div class="flex items-center gap-3 p-4 bg-primary/5 rounded-xl border border-primary/20 transition-colors hover:bg-primary/10">
                    <input type="checkbox" name="urgence" value="1" id="urgenceCheck"
                           class="w-5 h-5 text-primary rounded border-border focus:ring-primary/30">
                    <label for="urgenceCheck" class="text-sm font-bold text-primary flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle"></i> Cas urgent - Prioritaire
                    </label>
                </div>

                <button type="submit" class="btn-primary w-full py-4 text-base shadow-xl shadow-primary/20">
                    <i class="fas fa-paper-plane mr-2"></i> Envoyer la demande
                </button>
            </form>
        </div>

        <div class="space-y-6">
            <div class="card bg-muted/30 border-dashed p-8">
                <h3 class="font-bold text-foreground mb-6 flex items-center gap-2">
                    <i class="fas fa-question-circle text-primary"></i> Comment ça marche ?
                </h3>
                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <span class="stat-icon w-8 h-8 rounded-lg font-bold text-xs">1</span>
                        <div>
                            <p class="font-bold text-foreground text-sm">Soumission</p>
                            <p class="text-xs text-muted-foreground leading-relaxed">Remplissez le formulaire avec les détails médicaux requis.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <span class="stat-icon w-8 h-8 bg-muted text-muted-foreground rounded-lg font-bold text-xs">2</span>
                        <div>
                            <p class="font-bold text-foreground text-sm">Matching AI</p>
                            <p class="text-xs text-muted-foreground leading-relaxed">Notre système trouve instantanément les donneurs compatibles.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <span class="stat-icon w-8 h-8 bg-muted text-muted-foreground rounded-lg font-bold text-xs">3</span>
                        <div>
                            <p class="font-bold text-foreground text-sm">Mise en contact</p>
                            <p class="text-xs text-muted-foreground leading-relaxed">Vous êtes mis en relation sécurisée avec les donneurs volontaires.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card p-6">
                <h3 class="font-bold text-foreground mb-4 flex items-center gap-2">
                    <i class="fas fa-clock text-primary"></i> Délais de réponse
                </h3>
                <div class="space-y-3">
                    <div class="flex justify-between items-center p-3 bg-muted/40 rounded-xl">
                        <span class="text-sm font-medium text-muted-foreground">Cas standard</span>
                        <span class="badge-muted">48-72h</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-primary/5 rounded-xl border border-primary/10">
                        <span class="text-sm font-bold text-primary">Cas urgent</span>
                        <span class="badge-danger">6-12h</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── My Requests List ── #}
    <div class="card p-0 overflow-hidden">
        <div class="p-5 border-b border-border bg-muted/30 flex justify-between items-center">
            <h2 class="font-bold text-foreground flex items-center gap-2">
                <i class="fas fa-clipboard-list text-primary"></i> Mes Demandes
            </h2>
            <span class="badge-muted">{{ demandes|length }} demande(s)</span>
        </div>

        <div class="divide-y divide-border">
            {% for demande in demandes %}
            <div class="p-6 hover:bg-muted/30 transition-colors animate-fade-in">
                <div class="flex flex-col md:flex-row justify-between md:items-center gap-6">
                    <div class="flex items-start gap-4">
                        <div class="stat-icon w-12 h-12 text-xl {{ demande.typeDemande == 'sang' ? '' : 'bg-muted text-muted-foreground' }}">
                            <i class="fas {{ demande.typeDemande == 'sang' ? 'fa-tint' : 'fa-dna' }}"></i>
                        </div>
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-black text-foreground text-base tracking-tight">{{ demande.typeDemande|upper }}</span>
                                {% if demande.typeSanguin %}
                                    <span class="badge-primary px-2.5 py-0.5">{{ demande.typeSanguin }}</span>
                                {% elseif demande.typeOrgane %}
                                    <span class="badge-muted px-2.5 py-0.5">{{ demande.typeOrgane|title }}</span>
                                {% endif %}
                                {% if demande.urgence %}
                                    <span class="badge-danger px-2.5 py-0.5 animate-pulse shadow-sm">URGENT</span>
                                {% endif %}
                            </div>
                            <div class="text-xs text-muted-foreground mt-2 flex items-center gap-3">
                                <span class="flex items-center gap-1"><i class="fas fa-map-marker-alt opacity-50"></i> {{ demande.region }}</span>
                                <span class="flex items-center gap-1"><i class="fas fa-calendar-alt opacity-50"></i> {{ demande.dateDemande|date('d/m/Y H:i') }}</span>
                                <span class="flex items-center gap-1 font-bold text-primary bg-primary/5 px-2 py-0.5 rounded">Rang: #{{ demande.rangAttente }}</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-3">
                        <a href="{{ path('demande_don_view', {id: demande.id}) }}" 
                           class="btn-primary py-2 px-5 text-xs font-bold">
                            <i class="fas fa-handshake mr-2"></i> RÉPONDRE
                        </a>
                        <form method="post" action="{{ path('demande_delete', {id: demande.id}) }}"
                            onsubmit="return confirm('Annuler cette demande de don ?');">
                            <button type="submit" class="btn-danger p-2.5 rounded-xl">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="empty-state py-16">
                <div class="empty-state-icon"><i class="fas fa-folder-open"></i></div>
                <p class="text-sm text-muted-foreground">Vous n'avez aucune demande en cours.</p>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

<script>
document.getElementById('typeDemande').addEventListener('change', function() {
    const type = this.value;
    const sanguin = document.getElementById('sanguinField');
    const organe = document.getElementById('organeField');
    
    sanguin.classList.add('hidden');
    organe.classList.add('hidden');
    
    if (type === 'sang') sanguin.classList.remove('hidden');
    if (type === 'organe') organe.classList.remove('hidden');
});
</script>
{% endblock %}
