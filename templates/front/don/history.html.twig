{% extends 'layout/front-layout.html.twig' %}

{% block title %}Historique des dons - Sosi{% endblock %}

{% block content %}
<div class="space-y-8 animate-page-enter">
    {# ── Header ── #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="page-title flex items-center gap-3">
                <span class="stat-icon w-10 h-10 text-lg"><i class="fas fa-history"></i></span>
                Historique des dons
            </h1>
            <p class="page-subtitle mt-1">Consultez et gérez vos précédentes déclarations</p>
        </div>
        <a href="{{ path('don_new') }}" class="btn-primary">
            <i class="fas fa-plus mr-2"></i> Nouveau don
        </a>
    </div>

    {# ── Filters ── #}
    <div class="card p-5 bg-muted/20">
        <form method="get" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
            <div class="md:col-span-2">
                <label class="section-title mb-2 block">Recherche</label>
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground"></i>
                    <input type="text" name="search" value="{{ filters.search|default('') }}"
                           placeholder="Mots-clés..."
                           class="input-field pl-10">
                </div>
            </div>
            <div>
                <label class="section-title mb-2 block">Type</label>
                <select name="typeDon" class="input-field appearance-none cursor-pointer">
                    <option value="">Tous types</option>
                    <option value="sang" {{ filters.typeDon == 'sang' ? 'selected' }}>Sang</option>
                    <option value="organe" {{ filters.typeDon == 'organe' ? 'selected' }}>Organe</option>
                </select>
            </div>
            <div>
                <label class="section-title mb-2 block">Statut</label>
                <select name="statut" class="input-field appearance-none cursor-pointer">
                    <option value="">Tous statuts</option>
                    <option value="EN_ATTENTE" {{ filters.statut == 'EN_ATTENTE' ? 'selected' }}>En attente</option>
                    <option value="VALIDÉ" {{ filters.statut == 'VALIDÉ' ? 'selected' }}>Validés</option>
                    <option value="REFUSÉ" {{ filters.statut == 'REFUSÉ' ? 'selected' }}>Refusés</option>
                </select>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn-primary flex-1">Filtrer</button>
                <a href="{{ path('don_history') }}" class="btn-secondary px-4">
                    <i class="fas fa-times"></i>
                </a>
            </div>
        </form>
    </div>

    {# ── History List ── #}
    {% if dons|length > 0 %}
    <div class="space-y-4">
        {% for don in dons %}
        <div class="card p-6 card-hover border-l-4 {{ don.statut == 'VALIDÉ' ? 'border-l-green-500' : (don.statut == 'REFUSÉ' ? 'border-l-primary' : 'border-l-amber-500') }}">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
                <div class="flex items-start gap-5">
                    <div class="stat-icon w-14 h-14 rounded-2xl text-2xl {{ don.typeDon == 'sang' ? '' : 'bg-muted text-muted-foreground' }}">
                        <i class="fas {{ don.typeDon == 'sang' ? 'fa-tint' : 'fa-dna' }}"></i>
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                            <span class="font-black text-foreground text-lg tracking-tight">{{ don.typeDon|upper }}</span>
                            {% if don.typeSanguin %}
                                <span class="badge-primary px-2.5 py-1">{{ don.typeSanguin }}</span>
                            {% elseif don.typeOrgane %}
                                <span class="badge-muted px-2.5 py-1">{{ don.typeOrgane|title }}</span>
                            {% endif %}
                            {% if don.urgence %}
                                <span class="badge-danger px-2.5 py-1 animate-pulse"><i class="fas fa-bolt mr-1"></i>URGENT</span>
                            {% endif %}
                        </div>
                        <p class="text-sm text-muted-foreground flex items-center gap-4">
                            <span class="flex items-center gap-1.5"><i class="fas fa-map-marker-alt opacity-50"></i> {{ don.region }}</span>
                            <span class="flex items-center gap-1.5"><i class="fas fa-calendar-alt opacity-50"></i> {{ don.dateDon|date('d/m/Y à H:i') }}</span>
                        </p>
                        
                        {% if don.documentName %}
                        <div class="mt-3">
                            <a href="{{ vich_uploader_asset(don, 'documentFile') }}" target="_blank" 
                               class="inline-flex items-center gap-2 text-xs font-bold text-primary hover:underline bg-primary/5 px-3 py-1.5 rounded-lg transition-colors">
                                <i class="fas fa-file-pdf"></i>
                                VOIR LE JUSTIFICATIF
                            </a>
                        </div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="flex flex-col items-end gap-3">
                    <span class="badge-{{ don.statut == 'VALIDÉ' ? 'success' : (don.statut == 'REFUSÉ' ? 'danger' : 'warning') }} py-2 px-5 text-sm">
                        <i class="fas {{ don.statut == 'VALIDÉ' ? 'fa-check-circle' : 'fa-clock' }} mr-2"></i> {{ don.statut }}
                    </span>
                </div>
            </div>

            <div class="mt-6 pt-5 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
                <a href="{{ path('don') }}" class="text-xs font-bold text-muted-foreground hover:text-foreground flex items-center gap-1 transition-colors uppercase tracking-wider">
                    <i class="fas fa-chevron-left text-[10px]"></i> Retour module
                </a>
                
                <div class="flex gap-3">
                    {% if don.statut == 'VALIDÉ' %}
                    <a href="{{ path('don_certificate', {id: don.id}) }}" 
                       target="_blank"
                       class="btn-primary py-2 px-4 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 shadow-indigo-200">
                        <i class="fas fa-certificate mr-2"></i> CERTIFICAT
                    </a>
                    {% endif %}
                    
                    <button onclick="shareDon({{ don.id }})" 
                            class="btn-secondary py-2 px-4 text-xs font-bold hover:bg-primary/5 hover:text-primary hover:border-primary/30 transition-all">
                        <i class="fas fa-share-alt mr-2"></i> PARTAGER
                    </button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    {# ── Pagination ── #}
    {% if pagination.pages > 1 %}
    <div class="flex justify-center mt-8">
        <div class="knp-pagination">
            <ul>
                {% if pagination.current > 1 %}
                <li>
                    <a href="{{ path('don_history', app.request.query.all|merge({page: pagination.current - 1}))}}">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                {% endif %}
                
                {% for i in 1..pagination.pages %}
                    {% if i == pagination.current %}
                        <li class="active"><span>{{ i }}</span></li>
                    {% elseif i > pagination.current - 3 and i < pagination.current + 3 %}
                        <li><a href="{{ path('don_history', app.request.query.all|merge({page: i}))}}">{{ i }}</a></li>
                    {% endif %}
                {% endfor %}
                
                {% if pagination.current < pagination.pages %}
                <li>
                    <a href="{{ path('don_history', app.request.query.all|merge({page: pagination.current + 1}))}}">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
    </div>
    {% endif %}

    {% else %}
    <div class="card p-16 text-center border-dashed">
        <div class="empty-state">
            <div class="empty-state-icon w-20 h-20 text-4xl mb-6"><i class="fas fa-folder-open"></i></div>
            <h3 class="text-xl font-black text-foreground mb-3">Aucun don enregistré</h3>
            <p class="text-muted-foreground max-w-sm mx-auto mb-8">Vous n'avez pas encore déclaré de don. Votre premier geste sauvera peut-être une vie.</p>
            <a href="{{ path('don_new') }}" class="btn-primary px-8 py-3 shadow-xl shadow-primary/20">
                <i class="fas fa-plus mr-2"></i> DÉCLARER MON PREMIER DON
            </a>
        </div>
    </div>
    {% endif %}
</div>

{# ── Share Modal ── #}
<div id="shareModal" class="fixed inset-0 bg-foreground/40 backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
    <div class="card p-8 w-full max-w-md shadow-2xl animate-page-enter">
        <div class="flex justify-between items-start mb-6">
            <div>
                <h3 class="text-xl font-black text-foreground tracking-tight">Partager votre don</h3>
                <p class="text-sm text-muted-foreground mt-1">Inspirez votre entourage à donner !</p>
            </div>
            <button onclick="closeModal()" class="text-muted-foreground hover:text-foreground p-1 transition-colors">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-8">
            <a id="shareFacebook" href="#" target="_blank" class="flex flex-col items-center gap-3 p-4 rounded-2xl bg-[#1877F2]/10 text-[#1877F2] hover:bg-[#1877F2] hover:text-white transition-all group">
                <i class="fab fa-facebook-f text-2xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">Facebook</span>
            </a>
            <a id="shareTwitter" href="#" target="_blank" class="flex flex-col items-center gap-3 p-4 rounded-2xl bg-[#000000]/10 text-[#000000] hover:bg-[#000000] hover:text-white transition-all group">
                <i class="fab fa-x-twitter text-2xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">Twitter</span>
            </a>
            <a id="shareWhatsapp" href="#" target="_blank" class="flex flex-col items-center gap-3 p-4 rounded-2xl bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366] hover:text-white transition-all group">
                <i class="fab fa-whatsapp text-2xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">WhatsApp</span>
            </a>
            <a id="shareLinkedin" href="#" target="_blank" class="flex flex-col items-center gap-3 p-4 rounded-2xl bg-[#0077B5]/10 text-[#0077B5] hover:bg-[#0077B5] hover:text-white transition-all group">
                <i class="fab fa-linkedin-in text-2xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">LinkedIn</span>
            </a>
        </div>

        <button onclick="closeModal()" class="btn-secondary w-full py-3 font-bold">FERMER</button>
    </div>
</div>

<script>
function shareDon(donId) {
    fetch('/don/' + donId + '/share')
        .then(response => response.json())
        .then(data => {
            document.getElementById('shareFacebook').href = data.platforms.facebook;
            document.getElementById('shareTwitter').href = data.platforms.twitter;
            document.getElementById('shareWhatsapp').href = data.platforms.whatsapp;
            document.getElementById('shareLinkedin').href = data.platforms.linkedin;
            
            const modal = document.getElementById('shareModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        });
}

function closeModal() {
    const modal = document.getElementById('shareModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
}

document.getElementById('shareModal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});
</script>
{% endblock %}
