{% extends 'layout/front-layout.html.twig' %}

{% block title %}Module Don - Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Custom transitions for this page */
.card-hover {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
}
</style>
{% endblock %}

{% block content %}
<div class="space-y-8 animate-page-enter">
    {# ── Hero Section ── #}
    <div class="relative overflow-hidden rounded-2xl border border-primary/20 bg-primary/5 p-8 lg:p-10">
        <div class="absolute top-0 right-0 w-64 h-64 bg-primary/10 rounded-full opacity-20 -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-primary/10 rounded-full opacity-20 translate-y-1/2 -translate-x-1/2"></div>
        
        <div class="relative z-10">
            <h1 class="text-4xl font-extrabold text-foreground tracking-tight mb-3">
                🩸 Faites un Don, Sauvez des Vies
            </h1>
            <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
                Chaque don compte. Rejoignez notre communauté de donneurs et aidez ceux qui en ont besoin dans un esprit de solidarité.
            </p>
            <div class="flex flex-wrap gap-4 mt-8">
                <a href="{{ path('don_new') }}" class="btn-primary px-8 py-3 text-base">
                    <i class="fas fa-heart mr-2"></i> Déclarer un don
                </a>
                <a href="{{ path('donneur_inscription') }}" class="btn-secondary px-8 py-3 text-base bg-white border border-border">
                    <i class="fas fa-user-plus mr-2"></i> Devenir donneur
                </a>
            </div>
        </div>
    </div>

    {# ── Stats Grid ── #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
        <div class="card p-6 card-hover">
            <div class="flex items-center justify-between">
                <div>
                    <p class="section-title">Total Dons</p>
                    <p class="text-3xl font-bold text-foreground mt-1">{{ stats.total }}</p>
                </div>
                <div class="stat-icon bg-muted text-foreground">
                    <i class="fas fa-chart-bar"></i>
                </div>
            </div>
        </div>

        <div class="card p-6 card-hover">
            <div class="flex items-center justify-between">
                <div>
                    <p class="section-title">Validés</p>
                    <p class="text-3xl font-bold text-green-600 mt-1">{{ stats.valides }}</p>
                </div>
                <div class="stat-icon bg-green-50 text-green-600">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
        </div>

        <div class="card p-6 card-hover">
            <div class="flex items-center justify-between">
                <div>
                    <p class="section-title">En attente</p>
                    <p class="text-3xl font-bold text-amber-600 mt-1">{{ stats.attente }}</p>
                </div>
                <div class="stat-icon bg-amber-50 text-amber-600">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>

        <div class="card p-6 card-hover">
            <div class="flex items-center justify-between">
                <div>
                    <p class="section-title">Dons Urgents</p>
                    <p class="text-3xl font-bold text-primary mt-1">{{ stats.urgences }}</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
            </div>
        </div>
    </div>

    {# ── Actions Grid ── #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="{{ path('don_new') }}" class="card p-6 card-hover group cursor-pointer">
            <div class="flex items-center gap-4 mb-4">
                <div class="stat-icon w-14 h-14 text-2xl group-hover:scale-110 transition">
                    <i class="fas fa-heart"></i>
                </div>
                <div>
                    <h3 class="font-bold text-foreground text-lg">Déclarer un Don</h3>
                    <p class="section-title">Sang ou organe</p>
                </div>
            </div>
            <p class="text-muted-foreground text-sm mb-6 leading-relaxed">
                Déclarez votre don et aidez les personnes dans le besoin. Chaque geste est une lueur d'espoir.
            </p>
            <span class="text-primary font-bold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
                Déclarer maintenant <i class="fas fa-arrow-right text-xs"></i>
            </span>
        </a>

        <a href="{{ path('donneur_inscription') }}" class="card p-6 card-hover group cursor-pointer">
            <div class="flex items-center gap-4 mb-4">
                <div class="stat-icon w-14 h-14 text-2xl bg-muted text-muted-foreground group-hover:scale-110 transition">
                    <i class="fas fa-user-check"></i>
                </div>
                <div>
                    <h3 class="font-bold text-foreground text-lg">Devenir Donneur</h3>
                    <p class="section-title">Inscription rapide</p>
                </div>
            </div>
            <p class="text-muted-foreground text-sm mb-6 leading-relaxed">
                Inscrivez-vous comme donneur et recevez des notifications en temps réel pour les besoins urgents.
            </p>
            <span class="text-muted-foreground font-bold text-sm flex items-center gap-1 group-hover:text-primary transition-all">
                S'inscrire <i class="fas fa-arrow-right text-xs"></i>
            </span>
        </a>

        <a href="{{ path('demande_don') }}" class="card p-6 card-hover group cursor-pointer">
            <div class="flex items-center gap-4 mb-4">
                <div class="stat-icon w-14 h-14 text-2xl bg-muted text-muted-foreground group-hover:scale-110 transition">
                    <i class="fas fa-hand-holding-heart"></i>
                </div>
                <div>
                    <h3 class="font-bold text-foreground text-lg">Faire une Demande</h3>
                    <p class="section-title">Besoin d'aide</p>
                </div>
            </div>
            <p class="text-muted-foreground text-sm mb-6 leading-relaxed">
                Besoin d'un don ? Soumettez votre demande et notre réseau de donneurs sera immédiatement alerté.
            </p>
            <span class="text-muted-foreground font-bold text-sm flex items-center gap-1 group-hover:text-primary transition-all">
                Soumettre demande <i class="fas fa-arrow-right text-xs"></i>
            </span>
        </a>
    </div>

    {# ── Recent & Info ── #}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card p-6">
            <div class="flex justify-between items-center mb-6">
                <h3 class="font-bold text-foreground text-lg">📋 Dons Récents</h3>
                <a href="{{ path('don_history') }}" class="text-primary text-sm font-bold hover:underline">
                    Voir tout <i class="fas fa-chevron-right ml-1 text-[10px]"></i>
                </a>
            </div>
            <div class="space-y-3">
                {% for don in recentDons %}
                <div class="flex items-center gap-4 p-3 bg-muted/40 rounded-xl hover:bg-muted/60 transition border border-transparent hover:border-border">
                    <div class="stat-icon w-10 h-10 rounded-xl text-lg {{ don.typeDon == 'sang' ? '' : 'bg-muted text-muted-foreground' }}">
                        <i class="fas {{ don.typeDon == 'sang' ? 'fa-tint' : 'fa-dna' }}"></i>
                    </div>
                    <div class="flex-1">
                        <div class="font-bold text-foreground text-sm">{{ don.typeDon|upper }}</div>
                        <div class="text-xs text-muted-foreground">{{ don.region }} • {{ don.dateDon|date('d/m/Y') }}</div>
                    </div>
                    <span class="badge-{{ don.statut == 'Validé' ? 'success' : (don.statut == 'Urgent' ? 'danger' : 'warning') }}">
                        {{ don.statut }}
                    </span>
                </div>
                {% else %}
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-inbox"></i></div>
                    <p class="text-sm text-muted-foreground">Aucun don récent enregistré.</p>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="card bg-muted/30 border-dashed p-6">
            <h3 class="font-bold text-foreground text-lg mb-6">💡 Pourquoi Donner ?</h3>
            <div class="space-y-6">
                <div class="flex items-start gap-4">
                    <div class="stat-icon w-8 h-8 rounded-lg font-bold text-xs">1</div>
                    <div>
                        <p class="font-bold text-foreground text-sm">Sauver des vies</p>
                        <p class="text-xs text-muted-foreground leading-relaxed">Un seul don peut sauver jusqu'à trois vies. C'est le plus beau des cadeaux.</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="stat-icon w-8 h-8 bg-muted text-muted-foreground rounded-lg font-bold text-xs">2</div>
                    <div>
                        <p class="font-bold text-foreground text-sm">Don anonyme & sécurisé</p>
                        <p class="text-xs text-muted-foreground leading-relaxed">Votre identité reste confidentielle et le processus est strictement encadré.</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="stat-icon w-8 h-8 bg-muted text-muted-foreground rounded-lg font-bold text-xs">3</div>
                    <div>
                        <p class="font-bold text-foreground text-sm">Certificat officiel</p>
                        <p class="text-xs text-muted-foreground leading-relaxed">Recevez un certificat de reconnaissance pour chaque geste citoyen validé.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Tutorials ── #}
    <div class="card p-6">
        <div class="flex justify-between items-center mb-6">
            <h3 class="font-bold text-foreground text-lg">🎬 Guide des Dons</h3>
            <a href="{{ path('aide_tutorials', {category: 'don-sang'}) }}" class="text-primary text-sm font-bold hover:underline">
                Voir tous les guides
            </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="{{ path('aide_tutorials') }}" class="p-4 bg-muted/30 rounded-xl hover:bg-muted/60 transition group border border-transparent hover:border-border">
                <div class="flex items-center gap-3">
                    <div class="stat-icon w-10 h-10 group-hover:scale-110 transition">
                        <i class="fas fa-tint"></i>
                    </div>
                    <div>
                        <p class="font-bold text-foreground text-sm">Don de Sang</p>
                        <p class="text-[10px] text-muted-foreground uppercase font-bold">Guide complet</p>
                    </div>
                </div>
            </a>
            <a href="{{ path('aide_tutorials') }}" class="p-4 bg-muted/30 rounded-xl hover:bg-muted/60 transition group border border-transparent hover:border-border">
                <div class="flex items-center gap-3">
                    <div class="stat-icon w-10 h-10 bg-muted text-muted-foreground group-hover:scale-110 transition">
                        <i class="fas fa-dna"></i>
                    </div>
                    <div>
                        <p class="font-bold text-foreground text-sm">Don d'Organe</p>
                        <p class="text-[10px] text-muted-foreground uppercase font-bold">Tout savoir</p>
                    </div>
                </div>
            </a>
            <a href="{{ path('aide_tutorials') }}" class="p-4 bg-muted/30 rounded-xl hover:bg-muted/60 transition group border border-transparent hover:border-border">
                <div class="flex items-center gap-3">
                    <div class="stat-icon w-10 h-10 bg-muted text-muted-foreground group-hover:scale-110 transition">
                        <i class="fas fa-file-contract"></i>
                    </div>
                    <div>
                        <p class="font-bold text-foreground text-sm">Certificats</p>
                        <p class="text-[10px] text-muted-foreground uppercase font-bold">Obtention</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    {# ── Urgent Call ── #}
    <div class="bg-primary rounded-2xl p-8 text-white shadow-xl shadow-primary/20 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-8 opacity-10">
            <i class="fas fa-bullhorn text-8xl -rotate-12"></i>
        </div>
        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
                <h3 class="text-2xl font-black tracking-tight mb-2">🚨 BESOIN URGENT DE SANG</h3>
                <p class="text-primary-foreground/80 font-medium">Des vies dépendent de votre réactivité aujourd'hui. Chaque minute compte.</p>
            </div>
            <a href="{{ path('don_new') }}" class="bg-white text-primary px-8 py-3 rounded-xl font-bold hover:bg-muted transition shadow-lg transform hover:scale-105 active:scale-95">
                RÉPONDRE À L'URGENCE
            </a>
        </div>
    </div>
</div>
{% endblock %}
