{% extends 'layout/front-layout.html.twig' %}

{% block title %}Devenir Donneur - Sosi{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-8 animate-page-enter">
    {# ── Header ── #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="page-title flex items-center gap-3">
                <span class="stat-icon w-10 h-10 text-lg"><i class="fas fa-user-plus"></i></span>
                Devenir Donneur
            </h1>
            <p class="page-subtitle mt-1">Rejoignez notre réseau de solidarité et sauvez des vies</p>
        </div>
        <a href="{{ path('don') }}" class="btn-ghost text-muted-foreground hover:text-foreground">
            <i class="fas fa-arrow-left mr-2"></i> Retour au module
        </a>
    </div>

    {# ── Messages ── #}
    {% for message in app.flashes('success') %}
    <div class="animate-fade-in bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl shadow-sm flex items-center gap-3">
        <i class="fas fa-check-circle text-lg"></i>
        <span class="font-medium">{{ message }}</span>
    </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
    <div class="animate-fade-in bg-red-50 border border-primary/20 text-primary px-4 py-3 rounded-xl shadow-sm flex items-center gap-3">
        <i class="fas fa-exclamation-circle text-lg"></i>
        <span class="font-medium">{{ message }}</span>
    </div>
    {% endfor %}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
            <div class="card p-8">
                <div class="flex items-center gap-4 mb-8">
                    <div class="stat-icon w-14 h-14 bg-primary/10 text-primary rounded-2xl flex items-center justify-center text-2xl">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-black text-foreground tracking-tight">Inscription Donneur</h2>
                        <p class="section-title">Informations personnelles</p>
                    </div>
                </div>

                <form method="post" enctype="multipart/form-data" class="space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="form-label">Prénom *</label>
                            <input type="text" name="prenom" required
                                   class="input-field"
                                   placeholder="Ahmed">
                        </div>
                        <div>
                            <label class="form-label">Nom *</label>
                            <input type="text" name="nom" required
                                   class="input-field"
                                   placeholder="Ben Ali">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="form-label">Âge *</label>
                            <input type="number" name="age" required min="18" max="65"
                                   class="input-field"
                                   placeholder="25">
                        </div>
                        <div>
                            <label class="form-label">Téléphone *</label>
                            <input type="tel" name="telephone" required
                                   class="input-field"
                                   placeholder="XX XXX XXX">
                        </div>
                    </div>

                    <div>
                        <label class="form-label">Groupe Sanguin *</label>
                        <select name="groupe_sanguin" required
                                class="input-field appearance-none cursor-pointer">
                            <option value="">Sélectionner...</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Photo de profil (optionnel)</label>
                        <div class="mt-1 flex justify-center px-6 pt-8 pb-10 border-2 border-border border-dashed rounded-2xl hover:border-primary/50 transition-colors bg-muted/20">
                            <div class="space-y-2 text-center">
                                <i class="fas fa-camera text-muted-foreground text-4xl mb-2"></i>
                                <div class="flex text-sm text-muted-foreground justify-center">
                                    <label class="relative cursor-pointer bg-white rounded-md font-bold text-primary hover:text-primary-dark px-1">
                                        <span>Choisir une photo</span>
                                        <input type="file" name="profile_image" accept="image/jpeg,image/png,image/gif" class="sr-only">
                                    </label>
                                    <p class="pl-1">ou glisser-déposer</p>
                                </div>
                                <p class="text-[10px] text-muted-foreground font-medium">JPG, PNG, GIF jusqu'à 5MB</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-4 bg-muted/40 rounded-xl border border-border">
                        <input type="checkbox" required id="consent" class="mt-1 w-5 h-5 text-primary rounded border-border focus:ring-primary/30">
                        <label for="consent" class="text-sm text-muted-foreground leading-relaxed">
                            J'accepte d'être contacté(e) par l'équipe médicale pour des demandes de don urgentes compatibles avec mon profil.
                        </label>
                    </div>

                    <button type="submit" class="btn-primary w-full py-4 text-base shadow-xl shadow-primary/20">
                        <i class="fas fa-check-circle mr-2"></i> S'inscrire comme donneur
                    </button>
                </form>
            </div>
        </div>

        <div class="space-y-6">
            <div class="card bg-primary/5 border-primary/20 p-6">
                <h3 class="font-bold text-primary mb-4 flex items-center gap-2">
                    <i class="fas fa-info-circle"></i> Conditions d'éligibilité
                </h3>
                <ul class="text-sm space-y-4">
                    <li class="flex items-start gap-3">
                        <span class="stat-icon w-6 h-6 bg-primary/20 text-primary text-[10px]"><i class="fas fa-check"></i></span>
                        <span class="text-foreground font-medium">Âge entre 18 et 65 ans</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="stat-icon w-6 h-6 bg-primary/20 text-primary text-[10px]"><i class="fas fa-check"></i></span>
                        <span class="text-foreground font-medium">Poids supérieur à 50 kg</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="stat-icon w-6 h-6 bg-primary/20 text-primary text-[10px]"><i class="fas fa-check"></i></span>
                        <span class="text-foreground font-medium">Bon état de santé général</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="stat-icon w-6 h-6 bg-primary/20 text-primary text-[10px]"><i class="fas fa-check"></i></span>
                        <span class="text-foreground font-medium">Ne pas être à jeun</span>
                    </li>
                </ul>
            </div>

            <div class="card p-6 border-dashed">
                <h3 class="font-bold text-foreground mb-3 flex items-center gap-2">
                    <i class="fas fa-shield-alt text-primary"></i> Confidentialité
                </h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                    Vos données sont strictement confidentielles et utilisées uniquement dans le cadre médical pour la mise en relation donneur/receveur.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
