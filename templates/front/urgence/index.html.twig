{% extends 'layout/front-layout.html.twig' %}

{% block title %}Assistance & Urgence — Sosi{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .category-btn {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }
    .category-btn.active {
        background: var(--primary) !important;
        color: white !important;
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 15px 30px -10px rgba(239, 68, 68, 0.4);
        border-color: var(--primary) !important;
    }
    .sos-button {
        background: linear-gradient(135deg, #ef4444 0%, #991b1b 100%);
        box-shadow: 0 10px 40px -10px rgba(239, 68, 68, 0.5);
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }
    .sos-button:hover {
        transform: scale(1.02);
        box-shadow: 0 15px 50px -5px rgba(239, 68, 68, 0.6);
    }
    .sos-button:active {
        transform: scale(0.98);
    }
    .sos-text {
        letter-spacing: 0.05em;
    }
    [x-cloak] { display: none !important; }
</style>
{% endblock %}

{% block content %}
<div class="space-y-8 animate-fadeIn" x-data="{ selectedType: 'Medicaments', location: true }">

    {# ── Page Title ── #}
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="page-title flex items-center gap-4">
                <i class="fas fa-hand-holding-medical text-primary"></i>
                Assistance & Aide
            </h1>
            <p class="page-subtitle">Sollicitez une aide immédiate auprès de vos proches et du réseau</p>
        </div>
        <a href="{{ path('contact_urgence_index') }}" class="btn-secondary flex items-center gap-2">
            <i class="fas fa-users-cog"></i>
            Gérer mes contacts
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        {# ── Main Alert Section ── #}
        <div class="lg:col-span-2 space-y-6">
            
            <div class="card p-8 md:p-12 border-none shadow-xl flex flex-col items-center text-center">
                
                <div class="w-full max-w-lg">
                    <div class="bg-red-50 border border-red-100 p-4 rounded-2xl mb-10 flex items-center gap-4">
                        <span class="w-10 h-10 bg-red-100 text-primary rounded-xl flex items-center justify-center animate-pulse">
                            <i class="fas fa-exclamation-triangle"></i>
                        </span>
                        <p class="text-[11px] font-bold uppercase tracking-widest text-primary text-left leading-relaxed">
                            Sélectionnez le type d'assistance et activez l'alerte
                        </p>
                    </div>

                    {# Categories Selection #}
                    <div class="grid grid-cols-3 gap-4 mb-10">
                        <button type="button" 
                                @click="selectedType = 'Medicaments'"
                                :class="selectedType === 'Medicaments' ? 'active' : ''"
                                class="category-btn flex flex-col items-center gap-3 p-6 bg-muted rounded-3xl border border-border">
                            <i class="fas fa-pills text-xl"></i>
                            <span class="text-[10px] font-bold uppercase tracking-widest">Medicaments</span>
                        </button>
                        <button type="button" 
                                @click="selectedType = 'Courses'"
                                :class="selectedType === 'Courses' ? 'active' : ''"
                                class="category-btn flex flex-col items-center gap-3 p-6 bg-muted rounded-3xl border border-border">
                            <i class="fas fa-walking text-xl"></i>
                            <span class="text-[10px] font-bold uppercase tracking-widest">Courses</span>
                        </button>
                        <button type="button" 
                                @click="selectedType = 'Assistance'"
                                :class="selectedType === 'Assistance' ? 'active' : ''"
                                class="category-btn flex flex-col items-center gap-3 p-6 bg-muted rounded-3xl border border-border">
                            <i class="fas fa-heartbeat text-xl"></i>
                            <span class="text-[10px] font-bold uppercase tracking-widest">Assistance</span>
                        </button>
                    </div>

                    {# Location Checkbox #}
                    <div class="flex justify-center mb-12">
                        <label class="inline-flex items-center gap-3 cursor-pointer group">
                            <div class="relative">
                                <input type="checkbox" class="sr-only peer" x-model="location">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-500"></div>
                            </div>
                            <span class="text-xs font-bold" style="color:var(--muted-fg);">
                                <i class="fas fa-map-marker-alt mr-1"></i> Inclure ma position actuelle
                            </span>
                        </label>
                    </div>

                    {# Main Action Button #}
                    <form method="post" action="{{ path('urgence_send') }}" id="sosForm" class="relative">
                        <input type="hidden" name="type" :value="selectedType">
                        <input type="hidden" name="includeLocation" :value="location ? 'on' : 'off'">
                        <input type="hidden" name="latitude" id="latitude">
                        <input type="hidden" name="longitude" id="longitude">

                        <button type="submit" class="sos-button w-full h-24 rounded-[32px] flex items-center justify-center gap-4 text-white group overflow-hidden">
                            <div class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            <span class="bg-white/20 px-3 py-1 rounded-lg text-[10px] font-bold sos-text">SOS</span>
                            <span class="text-xl font-bold uppercase tracking-[0.2em] sos-text">Déclencher Alerte</span>
                        </button>
                    </form>
                    
                    <div id="geoStatus" class="mt-4 text-[10px] font-bold" style="color:var(--muted-fg);"></div>
                </div>
            </div>
        </div>

        {# ── Sidebar: History ── #}
        <div class="space-y-6">
            <div class="card p-0 overflow-hidden border-none shadow-xl">
                <div class="p-6 bg-muted/30 border-b border-border flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="w-10 h-10 bg-red-100 text-primary rounded-xl flex items-center justify-center">
                            <i class="fas fa-history"></i>
                        </span>
                        <div>
                            <h3 class="text-xs font-bold uppercase tracking-widest" style="color:var(--foreground);">Historique des Alertes</h3>
                            <p class="text-[9px] font-bold uppercase mt-0.5" style="color:var(--muted-fg);">Dernières interventions</p>
                        </div>
                    </div>
                </div>
                
                <div class="divide-y divide-border max-h-[500px] overflow-y-auto">
                    {% for u in urgences %}
                        <div class="p-5 hover:bg-muted/50 transition-colors group">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[9px] font-bold uppercase tracking-tighter" style="color:var(--muted-fg);">{{ u.dateUrgence|date('d/m/Y à H:i') }}</span>
                                <span class="px-2 py-0.5 rounded-full text-[8px] font-bold uppercase tracking-widest border
                                    {% if u.statut == 'EN_ATTENTE' %}bg-amber-50 text-amber-600 border-amber-100
                                    {% else %}bg-green-50 text-green-600 border-green-100{% endif %}">
                                    {{ u.statut }}
                                </span>
                            </div>
                            <p class="text-xs font-bold leading-relaxed" style="color:var(--foreground);">{{ u.message }}</p>
                            
                            {% if u.latitude != 0 %}
                                <a href="https://maps.google.com/?q={{ u.latitude }},{{ u.longitude }}" target="_blank" 
                                   class="mt-3 inline-flex items-center gap-2 text-[10px] font-bold text-red-600 hover:underline uppercase tracking-widest">
                                    <i class="fas fa-location-arrow"></i> Localisation
                                </a>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="p-12 text-center">
                            <div class="empty-state-icon mx-auto mb-2"><i class="fas fa-inbox"></i></div>
                            <p class="text-[10px] font-bold uppercase tracking-widest" style="color:var(--muted-fg);">Aucune alerte</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
            
            <div class="rounded-3xl p-6 text-white shadow-xl shadow-red-500/10" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
                <h4 class="text-xs font-bold uppercase tracking-widest mb-4"><i class="fas fa-shield-alt me-1"></i> Conseil Sécurité</h4>
                <p class="text-[11px] leading-relaxed font-medium opacity-90">
                    Assurez-vous que votre localisation est activée dans les paramètres de votre navigateur pour que vos proches puissent vous retrouver plus facilement.
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    const sosForm = document.getElementById('sosForm');
    const geoStatus = document.getElementById('geoStatus');
    const latInput = document.getElementById('latitude');
    const lngInput = document.getElementById('longitude');

    function updateLocation() {
        if ("geolocation" in navigator) {
            geoStatus.textContent = "⌛ Synchronisation GPS...";
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    latInput.value = position.coords.latitude;
                    lngInput.value = position.coords.longitude;
                    geoStatus.innerHTML = "<span class='text-green-600'><i class='fas fa-check-circle'></i> GPS Prêt</span>";
                },
                (error) => {
                    geoStatus.innerHTML = "<span class='text-primary'><i class='fas fa-exclamation-circle'></i> GPS non disponible</span>";
                    console.error(error);
                },
                { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
            );
        } else {
            geoStatus.textContent = "Navigateur non compatible GPS";
        }
    }

    window.addEventListener('load', updateLocation);
    sosForm.addEventListener('mouseenter', updateLocation);
</script>
{% endblock %}
