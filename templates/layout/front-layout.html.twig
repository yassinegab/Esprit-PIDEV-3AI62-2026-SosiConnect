{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen bg-background">
    {% include 'components/top-nav.html.twig' %}

    <main class="mx-auto max-w-7xl px-4 py-8 lg:px-8 min-h-[calc(100vh-80px)] animate-page-enter">
        {# Flash Messages #}
        <div class="mb-6 space-y-2">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flex items-center gap-3 p-4 rounded-2xl text-sm font-bold animate-slide-in-left
                        {% if type == 'success' %} bg-teal-50 text-teal-700 border border-teal-100
                        {% elseif type == 'warning' %} bg-amber-50 text-amber-700 border border-amber-100
                        {% elseif type == 'error' %} bg-rose-50 text-rose-700 border border-rose-100
                        {% else %} bg-blue-50 text-blue-700 border border-blue-100 {% endif %}">
                        <span class="flex-shrink-0">
                            {% if type == 'success' %}<i class="fas fa-check-circle"></i>
                            {% elseif type == 'warning' %}<i class="fas fa-exclamation-triangle"></i>
                            {% elseif type == 'error' %}<i class="fas fa-times-circle"></i>
                            {% else %}<i class="fas fa-info-circle"></i>{% endif %}
                        </span>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {% block content %}{% endblock %}
    </main>
</div>
{% endblock %}
