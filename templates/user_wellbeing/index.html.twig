{% extends 'base.html.twig' %}

{% block title %}Mon Bien-Être{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-background flex flex-col" x-data="{ sidebarOpen: false }">

    {% include 'components/top-nav.html.twig' %}

    <main class="flex-1 w-full animate-page-enter">
        <div class="mx-auto max-w-7xl p-6 lg:p-10 space-y-8">

            {# ── AI Wellness Insight Banner ── #}
            {% if aiTrends is defined and aiTrends %}
                <div class="relative overflow-hidden rounded-2xl border border-primary/20 bg-primary/5 px-6 py-4"
                     x-data="{ expanded: false }">
                    <div class="flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="stat-icon flex-shrink-0">
                                <i class="fas fa-brain text-sm"></i>
                            </div>
                            <h2 class="section-title text-primary">Aperçu Bien-être AI</h2>
                        </div>
                        <button @click="expanded = !expanded"
                                class="text-xs font-bold text-primary flex items-center gap-1 hover:opacity-75 transition-opacity">
                            <span x-text="expanded ? 'Réduire' : 'Voir plus'"></span>
                            <i class="fas fa-chevron-down text-[10px] transition-transform" :class="expanded && 'rotate-180'"></i>
                        </button>
                    </div>
                    <div class="mt-3" :class="expanded ? '' : 'max-h-12 overflow-hidden'"
                         :style="!expanded && 'mask-image: linear-gradient(to bottom, black 20%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent 100%);'">
                        <p class="text-sm leading-relaxed text-foreground">{{ aiTrends|nl2br }}</p>
                    </div>
                </div>
            {% endif %}

            {# ── Page Header ── #}
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="page-title">Mon Bien-Être</h1>
                    <p class="page-subtitle">Suivez et analysez vos données de santé mentale</p>
                </div>
                <div class="flex gap-3">
                    <a href="{{ path('ai_assistant_index') }}" class="btn-secondary">
                        <i class="fas fa-robot"></i> Coach AI
                    </a>
                    <a href="{{ path('user_wellbeing_new') }}" class="btn-primary">
                        <i class="fas fa-plus"></i> Ajouter
                    </a>
                </div>
            </div>

            {# ── Wellbeing Cards Grid ── #}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {% for data in dataList %}
                    {% set lastPrediction = data.stressPredictions.last %}
                    {% set stressLevel = lastPrediction ? lastPrediction.predictedStressType : 'N/A' %}
                    {% set stressPercent = lastPrediction ? lastPrediction.confidenceScore : 0 %}
                    {% set stressColor = stressLevel == 'Low' ? 'bg-green-500'
                                     : stressLevel == 'Moderate' ? 'bg-amber-500'
                                     : stressLevel == 'High' ? 'bg-primary'
                                     : 'bg-muted' %}

                    <div class="card flex flex-col justify-between hover:-translate-y-0.5">
                        <div class="flex justify-between items-center mb-4">
                            <span class="badge-muted">{{ data.createdAt|date('d/m/Y H:i') }}</span>
                        </div>

                        {# Stress Progress Bar #}
                        <div class="mb-4">
                            <div class="h-2 w-full bg-muted rounded-full overflow-hidden">
                                <div class="{{ stressColor }} h-2 rounded-full transition-all duration-500"
                                     style="width: {{ stressPercent }}%;"></div>
                            </div>
                            <p class="mt-2 text-sm font-medium text-foreground">
                                Stress :
                                <span class="{{ stressLevel == 'High' ? 'text-primary' : (stressLevel == 'Moderate' ? 'text-amber-600' : 'text-green-600') }} font-bold">
                                    {{ stressLevel }}
                                </span>
                            </p>
                        </div>

                        <div class="mt-auto flex justify-between items-center border-t border-border pt-3">
                            {% if data.user == app.user %}
                                <a href="{{ path('user_wellbeing_edit', {'id': data.id}) }}"
                                   class="inline-flex items-center gap-1 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                            {% else %}
                                <span class="badge-muted"><i class="fas fa-lock mr-1"></i> Demo</span>
                            {% endif %}

                            <div class="flex items-center gap-3">
                                <button
                                    @click="showAI('{{ stressLevel|e('js') }}', '{{ stressPercent|number_format(1) }}', '{{ lastPrediction.recommendation|default('Aucune analyse disponible.')|e('js') }}')"
                                    class="btn-primary py-1.5 px-3 text-xs">
                                    <i class="fas fa-robot"></i> Voir AI
                                </button>

                                {% if data.user == app.user %}
                                    <form method="post"
                                          action="{{ path('user_wellbeing_delete', {'id': data.id}) }}"
                                          onsubmit="return confirm('Supprimer cette entrée ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ data.id) }}">
                                        <button class="text-muted-foreground hover:text-primary transition-colors">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-span-full empty-state">
                        <div class="empty-state-icon"><i class="fas fa-clipboard-list"></i></div>
                        <p class="text-sm text-muted-foreground">Aucune donnée enregistrée.</p>
                        <a href="{{ path('user_wellbeing_new') }}" class="btn-primary mt-2">Commencer</a>
                    </div>
                {% endfor %}
            </div>
            <div>{{ knp_pagination_render(dataList) }}</div>

            {# ── Analysis CTA Banner ── #}
            <div class="rounded-2xl bg-primary p-6 text-white flex items-center justify-between shadow-sm shadow-primary/20 group overflow-hidden relative">
                <div class="relative z-10">
                    <h2 class="text-lg font-bold mb-1">Analyse Détaillée Disponible</h2>
                    <p class="text-white/70 text-sm">Visualisez vos tendances de bien-être dans le temps.</p>
                </div>
                <a href="{{ path('user_wellbeing_statistics') }}"
                   class="relative z-10 bg-white text-primary px-6 py-2.5 rounded-xl font-bold hover:bg-white/90 transition-all group-hover:scale-105">
                    Voir les statistiques <i class="fas fa-chevron-right ml-1 text-xs"></i>
                </a>
                <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-white/10 rounded-full blur-2xl group-hover:scale-150 transition-transform"></div>
            </div>

            {# ── Meals Section ── #}
            <div>
                <div class="flex items-center justify-between mb-5">
                    <h2 class="page-title">Mes Repas</h2>
                    <a href="{{ path('user_meal_new') }}" class="btn-primary">
                        <i class="fas fa-utensils"></i> Ajouter un repas
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    {% for meal in meals %}
                        <div class="card p-0 overflow-hidden flex flex-col">
                            {% if meal.imageName %}
                                <div class="h-44 overflow-hidden relative group">
                                    <img src="{{ asset('uploads/meals/' ~ meal.imageName) }}" alt="Meal"
                                         class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500">
                                </div>
                            {% else %}
                                <div class="h-44 bg-muted flex items-center justify-center text-muted-foreground">
                                    <i class="fas fa-image text-3xl opacity-30"></i>
                                </div>
                            {% endif %}

                            <div class="p-5 flex flex-col flex-1">
                                <span class="badge-muted self-start">{{ meal.createAt|date('d M Y') }}</span>
                                <p class="mt-3 text-sm text-foreground font-medium line-clamp-2 flex-1 min-h-[2.5rem]">
                                    {{ meal.description }}
                                </p>
                                <div class="flex items-center justify-between mt-4 border-t border-border pt-3">
                                    <a href="{{ path('user_meal_show', {'id': meal.id}) }}"
                                       class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:opacity-75 transition-opacity">
                                        <i class="fas fa-robot"></i> Voir AI
                                    </a>
                                    <div class="flex items-center gap-3">
                                        <a href="{{ path('user_meal_edit', {'id': meal.id}) }}"
                                           class="text-muted-foreground hover:text-primary transition-colors">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('user_meal_delete', {'id': meal.id}) }}"
                                              onsubmit="return confirm('Supprimer ce repas ?');" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ meal.id) }}">
                                            <button class="text-muted-foreground hover:text-primary transition-colors">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-span-full empty-state">
                            <div class="empty-state-icon"><i class="fas fa-utensils"></i></div>
                            <p class="text-sm text-muted-foreground">Aucun repas enregistré.</p>
                        </div>
                    {% endfor %}
                </div>
                <div class="mt-4">{{ knp_pagination_render(meals) }}</div>
            </div>

            {# ── Journal Section ── #}
            <div class="pb-12">
                <div class="flex items-center justify-between mb-5">
                    <h2 class="page-title">Mon Journal</h2>
                    <a href="{{ path('user_journal_index') }}" class="btn-secondary">
                        <i class="fas fa-book"></i> Ouvrir le journal
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    {% for journal in journals %}
                        <div class="card border-l-4 border-l-primary flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start mb-3">
                                    <span class="badge-muted">{{ journal.createdAt|date('d M Y') }}</span>
                                    {% if journal.detectedEmotion %}
                                        <span class="badge-primary capitalize">
                                            <i class="fas fa-face-smile mr-1"></i> {{ journal.detectedEmotion }}
                                        </span>
                                    {% endif %}
                                </div>
                                <p class="text-sm text-muted-foreground leading-relaxed line-clamp-4 italic">
                                    "{{ journal.content }}"
                                </p>
                            </div>
                            <div class="flex items-center justify-end border-t border-border mt-4 pt-3">
                                <form method="post" action="{{ path('user_journal_delete', {'id': journal.id}) }}"
                                      onsubmit="return confirm('Supprimer cette entrée ?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ journal.id) }}">
                                    <button class="text-muted-foreground hover:text-primary transition-colors text-sm">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-span-full empty-state">
                            <div class="empty-state-icon"><i class="fas fa-book"></i></div>
                            <p class="text-sm text-muted-foreground">Votre journal est vide.</p>
                        </div>
                    {% endfor %}
                </div>
                <div class="mt-4">{{ knp_pagination_render(journals) }}</div>
            </div>

        </div>
    </main>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function showAI(type, score, recommendation) {
            Swal.fire({
                title: `<div class="text-xl font-bold">Analyse AI du Stress</div>`,
                html: `
                    <div class="text-left space-y-4">
                        <div class="flex items-center justify-between bg-muted p-4 rounded-xl border border-border">
                            <div>
                                <p class="text-xs text-muted-foreground uppercase font-bold tracking-wider">Niveau prédit</p>
                                <p class="text-xl font-bold ${type === 'High' ? 'text-red-500' : type === 'Moderate' ? 'text-amber-500' : 'text-green-600'}">${type}</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-muted-foreground uppercase font-bold tracking-wider">Score de stress</p>
                                <p class="text-xl font-bold text-foreground">${score}%</p>
                            </div>
                        </div>
                        <div>
                            <p class="text-xs text-muted-foreground uppercase font-bold tracking-wider mb-2">Recommandations</p>
                            <div class="bg-primary/5 p-4 rounded-xl border border-primary/20 text-foreground text-sm leading-relaxed">
                                ${ (recommendation || 'Aucune recommandation.').replace(/\n/g, '<br>') }
                            </div>
                        </div>
                    </div>
                `,
                showCloseButton: true,
                showConfirmButton: false,
                width: '560px',
                customClass: { container: 'font-sans', popup: 'rounded-2xl' }
            });
        }
    </script>

    {# Floating Chatbot Bubble #}
    <div x-data="chatBubble()" class="fixed bottom-6 right-6 z-50" x-cloak>
        <div x-show="open"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-90 translate-y-4"
             x-transition:enter-end="opacity-100 scale-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-90 translate-y-4"
             class="mb-4 w-80 sm:w-96 bg-card rounded-2xl shadow-2xl border border-border overflow-hidden flex flex-col"
             style="height: 480px;">

            <div class="bg-primary px-4 py-3 flex items-center justify-between flex-shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                        <i class="fas fa-brain text-white text-sm"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-bold text-sm">Coach Bien-être</h3>
                        <p class="text-white/70 text-[10px]">Spécialisé santé mentale</p>
                    </div>
                </div>
                <button @click="open = false" class="text-white/70 hover:text-white transition-colors">
                    <i class="fas fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto p-4 space-y-3 bg-muted/30" x-ref="chatMessages">
                <template x-if="messages.length === 0">
                    <div class="text-center py-8">
                        <div class="stat-icon mx-auto mb-3">
                            <i class="fas fa-comment-dots"></i>
                        </div>
                        <p class="text-muted-foreground text-sm">Comment vous sentez-vous aujourd'hui ?</p>
                    </div>
                </template>
                <template x-for="(msg, i) in messages" :key="i">
                    <div :class="msg.role === 'user' ? 'flex justify-end' : 'flex justify-start'">
                        <div :class="msg.role === 'user'
                            ? 'bg-primary text-white rounded-2xl rounded-br-md px-3 py-2 max-w-[80%] text-sm'
                            : 'bg-card text-foreground rounded-2xl rounded-bl-md px-3 py-2 max-w-[80%] text-sm shadow-sm border border-border'"
                            x-html="msg.content.replace(/\n/g, '<br>')">
                        </div>
                    </div>
                </template>
                <template x-if="loading">
                    <div class="flex justify-start">
                        <div class="bg-card rounded-2xl rounded-bl-md px-4 py-3 shadow-sm border border-border">
                            <div class="flex gap-1">
                                <span class="w-2 h-2 rounded-full bg-muted-foreground/40 animate-bounce" style="animation-delay: 0s"></span>
                                <span class="w-2 h-2 rounded-full bg-muted-foreground/40 animate-bounce" style="animation-delay: 0.15s"></span>
                                <span class="w-2 h-2 rounded-full bg-muted-foreground/40 animate-bounce" style="animation-delay: 0.3s"></span>
                            </div>
                        </div>
                    </div>
                </template>
            </div>

            <div class="p-3 border-t border-border bg-card flex-shrink-0">
                <form @submit.prevent="sendMessage" class="flex gap-2">
                    <input x-model="newMessage" type="text" placeholder="Écrivez ici..."
                           class="input-field flex-1"
                           :disabled="loading">
                    <button type="submit" :disabled="loading || !newMessage.trim()"
                            class="w-9 h-9 rounded-xl bg-primary text-white flex items-center justify-center hover:bg-primary/90 transition-colors disabled:opacity-40">
                        <i class="fas fa-paper-plane text-xs"></i>
                    </button>
                </form>
            </div>
        </div>

        <button @click="open = !open"
                class="w-14 h-14 rounded-full bg-primary text-white shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95 transition-all flex items-center justify-center relative">
            <i class="fas fa-brain text-xl" x-show="!open"></i>
            <i class="fas fa-xmark text-xl" x-show="open"></i>
            <span x-show="!open && messages.length === 0"
                  class="absolute -top-1 -right-1 w-4 h-4 bg-primary rounded-full border-2 border-white animate-pulse"></span>
        </button>
    </div>

    <script>
        function chatBubble() {
            return {
                open: false, messages: [], newMessage: '', loading: false,
                async sendMessage() {
                    if (!this.newMessage.trim() || this.loading) return;
                    const text = this.newMessage.trim();
                    this.messages.push({ role: 'user', content: text });
                    this.newMessage = '';
                    this.loading = true;
                    this.$nextTick(() => { this.$refs.chatMessages.scrollTop = this.$refs.chatMessages.scrollHeight; });
                    try {
                        const formData = new FormData();
                        formData.append('message', text);
                        const res = await fetch('{{ path("user_chatbot_send") }}', { method: 'POST', body: formData });
                        const data = await res.json();
                        this.messages.push({ role: 'assistant', content: data.message || 'Désolé, une erreur est survenue.' });
                    } catch (e) {
                        this.messages.push({ role: 'assistant', content: 'Erreur de connexion.' });
                    }
                    this.loading = false;
                    this.$nextTick(() => { this.$refs.chatMessages.scrollTop = this.$refs.chatMessages.scrollHeight; });
                }
            }
        }
    </script>
{% endblock %}
